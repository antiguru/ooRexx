+count 39
+/* OBJECTNAME= on an Array, a Stem and a VariableReference, read back
+   through ~objectName, ~string, a copy, an argument and an error message. */
+a = .array~of('N','S','E','W')
+say a~objectName '|' a~defaultName '|' a~string
+a~objectName = 'compass'
+say a~objectName '|' a~defaultName '|' a~string '|' a[3]
+c = a~copy
+say c~objectName c~string a~makeArray~objectName
+c~objectName = 'other'
+say a~objectName c~objectName .array~new~string
+call ra a
+a~objectName = 7
+say a~objectName
