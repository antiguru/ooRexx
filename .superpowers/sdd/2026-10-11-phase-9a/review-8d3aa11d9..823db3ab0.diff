@@ -0,0 +1,45 @@
+count 44
+/* Package~local, the annotation tables and a security manager's info
+   directory are Directory and StringTable objects with stores of their own. */
+l = .context~package~local
+say l~class~id l~items (l == .context~package~local)
+l~foo = 'bar'
+l['BAZ'] = 5
+say l~items .foo .baz l~hasIndex('FOO')
+do i over l~allIndexes~sortWith(.caselessComparator~new); say ' ' i l[i]; end
+l~setMethod('M', 'return 42')
+say l~m l~x
+call r
+say .k~annotations~class~id .k~annotations~items .k~annotation('a') .k~annotations['B']
+a = .k~annotations
+do i over a~allIndexes~sort; say ' ' i a[i]; end
+m = .k~method('M1')
+say m~annotations~items m~annotation('x') m~annotations~allItems~makeString('L', ',')
+c = m~copy
+c~annotations['NEW'] = 1
+say m~annotations~items c~annotations~items
+say .context~package~annotations~items .context~package~annotation('p')
+say .routines~r~annotations~items
+q = .context~package
+q~setSecurityManager(.mgr~new)
+q~findRoutine('INNER')~call
+exit
+r: procedure
+  say .foo
+  return
+::annotate package p 'pv'
+::class k
+::annotate class k a 'one' b 'two'
+::method m1
+::annotate method m1 x 'xv' y 'yv'
+::routine r
+::annotate routine r q 'qv'
+::routine inner public
+  x = .environment~foo
+  return
+::class mgr
+::method unknown
+  use arg name, args
+  info = args[1]
+  say name info~class~id info~items info~allIndexes~sort~makeString('L', ',')
+  return 0
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/rexx_routine_frame_executable.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/rexx_routine_frame_executable.txt
new file mode 100644
index 000000000..62e9e6e67
--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/rexx_routine_frame_executable.txt
@@ -0,0 +1,27 @@
+count 26
+/* The StackFrame of a REXX package native routine answers one source-less
+   Routine per routine name for ~executable, kept across calls. */
+signal on syntax name a1
+call sysSleep 'x'
+a1: e = condition('O')['STACKFRAMES']~firstItem~executable
+signal on syntax name a2
+call sysSleep 'y'
+a2: f = condition('O')['STACKFRAMES']~firstItem~executable
+signal on syntax name a3
+x = sysSleep('z')
+a3: g = condition('O')['STACKFRAMES']~firstItem~executable
+signal on syntax name a4
+call sysFileDelete
+a4: h = condition('O')['STACKFRAMES']~firstItem~executable
+say condition('O')['STACKFRAMES']~firstItem~name
+say e~class~id e~source~items (e~package == .context~package) (e == f) (e == g) (e == h) h~class~id
+p = e~package
+say p~name (p == h~package) (p == .object~package) e~annotations~items
+call sub
+say (.sube == e) (.context~package~findRoutine('SYSSLEEP') == .nil)
+exit
+sub: procedure
+  signal on syntax name b1
+  call sysSleep 'w'
+b1: .local~sube = condition('O')['STACKFRAMES']~firstItem~executable
+  return
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/routines_table_resolution.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/routines_table_resolution.txt
