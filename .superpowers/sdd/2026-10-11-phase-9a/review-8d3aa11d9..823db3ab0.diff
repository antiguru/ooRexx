diff --git a/rust/corpus/lang/rexx_routine_frame_executable.rex b/rust/corpus/lang/rexx_routine_frame_executable.rex
new file mode 100644
index 000000000..9ee6183d6
--- /dev/null
+++ b/rust/corpus/lang/rexx_routine_frame_executable.rex
@@ -0,0 +1,26 @@
+/* The StackFrame of a REXX package native routine answers one source-less
+   Routine per routine name for ~executable, kept across calls. */
+signal on syntax name a1
+call sysSleep 'x'
+a1: e = condition('O')['STACKFRAMES']~firstItem~executable
+signal on syntax name a2
+call sysSleep 'y'
+a2: f = condition('O')['STACKFRAMES']~firstItem~executable
+signal on syntax name a3
+x = sysSleep('z')
+a3: g = condition('O')['STACKFRAMES']~firstItem~executable
+signal on syntax name a4
+call sysFileDelete
+a4: h = condition('O')['STACKFRAMES']~firstItem~executable
+say condition('O')['STACKFRAMES']~firstItem~name
+say e~class~id e~source~items (e~package == .context~package) (e == f) (e == g) (e == h) h~class~id
+p = e~package
+say p~name (p == h~package) (p == .object~package) e~annotations~items
+call sub
+say (.sube == e) (.context~package~findRoutine('SYSSLEEP') == .nil)
+exit
+sub: procedure
+  signal on syntax name b1
+  call sysSleep 'w'
+b1: .local~sube = condition('O')['STACKFRAMES']~firstItem~executable
+  return
diff --git a/rust/corpus/lang/routines_table_resolution.rex b/rust/corpus/lang/routines_table_resolution.rex
new file mode 100644
index 000000000..714917a64
--- /dev/null
+++ b/rust/corpus/lang/routines_table_resolution.rex
@@ -0,0 +1,28 @@
+/* A write to a package's .ROUTINES table moves what a routine name
+   resolves to at a call site that has not yet resolved it; a site that
+   has keeps the routine it found. */
+do i = 1 to 2
+  call foo
+  say i result foo()
+  if i = 1 then .routines~put(.routines~bar, 'FOO')
+end
+call foo
+say 'new site' result foo() (.context~package~findRoutine('FOO') == .routines~bar)
+.routines~put(.routine~new('n', 'return "new" arg(1)'), 'NEWR')
+call newr 'x'
+say result newr('y') .context~package~findRoutine('newr')~class~id
+e = .routine~new('e', 'return .context~executable')
+.routines['EX'] = e
+say (ex() == e)
+.routines~remove('FOO')
+signal on syntax
+call foo
+say 'after remove' result
+exit
+syntax:
+say condition('O')~code condition('O')~message
+say (.context~package~findRoutine('FOO') == .nil)
+::routine foo
+  return 'foo'
+::routine bar
+  return 'bar'
