+s.~objectName = 'my stem'
+say s.~objectName '|' s.~string '|' s.~defaultName
+call rs s.
+call ex
+say s.~copy~objectName
+s. = 'dflt'
+say s.~objectName '|' s.~string
+q = 7
+v = >q
