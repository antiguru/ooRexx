diff --git a/rust/crates/rexx-classes/src/class_graph.rs b/rust/crates/rexx-classes/src/class_graph.rs
index 593f6941a..fd75b9f23 100644
--- a/rust/crates/rexx-classes/src/class_graph.rs
+++ b/rust/crates/rexx-classes/src/class_graph.rs
@@ -266,21 +266,21 @@ impl ClassGraph {
         );
         self.rebuild_behaviour(id, Side::Instance);
         let source = self.classes[&receiver].instance_behaviour;
         let dict = self.behaviours[source.index()].dict.clone();
         let behaviour = &mut self.behaviours[class_behaviour.index()];
         behaviour.dict = dict;
         behaviour.version += 1;
     }
 
     /// A behaviour of its own holding `class`'s current instance methods with
-    /// each of `hidden` hidden in front -- what `defineInstanceMethod` with a
+    /// each of `hidden` hidden in front, as `defineInstanceMethod` with a
     /// `.nil` method does to one object's behaviour copy
     /// (`ObjectClass.cpp:2297`).
     pub fn hiding_behaviour(&mut self, class: ObjRef, hidden: &[&str]) -> BehaviourHandle {
         let source = self.classes[&class].instance_behaviour;
         let mut dict = self.behaviours[source.index()].dict.clone();
         for name in hidden {
             dict.add_hidden(name);
         }
         let handle = self.alloc_behaviour();
         self.behaviours[handle.index()].dict = dict;
diff --git a/rust/crates/rexx-core/src/body.rs b/rust/crates/rexx-core/src/body.rs
index 83d16339d..88505a383 100644
--- a/rust/crates/rexx-core/src/body.rs
+++ b/rust/crates/rexx-core/src/body.rs
@@ -871,22 +871,22 @@ impl ObjectMethods {
     pub fn set(&mut self, name: &[u8], entry: Option<ObjectMethod>) {
         Self::write(&mut self.set, name, entry);
     }
 
     /// Removes `setMethod`'s entry for `name`.
     pub fn remove(&mut self, name: &[u8]) {
         self.set.retain(|(key, _)| !key.eq_ignore_ascii_case(name));
     }
 
     /// Appends every object these entries reach, which is each defined
-    /// method's scope and `Method` object, and the enhancing class --
-    /// [`ScopePools::trace`]'s position and its reason.
+    /// method's scope and `Method` object, and the enhancing class, for
+    /// [`ScopePools::trace`]'s reason.
     fn trace(&self, out: &mut Vec<ObjRef>) {
         for ObjectMethod {
             method: _,
             scope,
             executable,
         } in self.set.iter().filter_map(|(_, entry)| *entry)
         {
             out.push(scope);
             out.push(executable);
         }
