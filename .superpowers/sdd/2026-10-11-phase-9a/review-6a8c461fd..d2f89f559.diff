+pub(in crate::dispatch) fn drain_supplier(
+    interp: &mut Interp,
+    supplier: ObjRef,
+) -> Result<Vec<(ObjRef, ObjRef)>, Failure> {
+    let (items, indexes, position) = supplier_state(interp, supplier)?;
+    let item_slots = array_slots(interp, items)?.to_vec();
