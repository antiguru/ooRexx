--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/package_local_find_class.txt
@@ -0,0 +1,14 @@
+count 13
+/* A package's own ~local entries are part of the class search: .NAME,
+   Package~findClass, and the native API's FindContextClass from a method and
+   a routine whose package holds the entry. */
+l = .context~package~local
+l~put(.array, 'FOO')
+say 'dot:' .foo
+say 'findClass:' .context~package~findClass('FOO')
+say 'findClass absent:' .context~package~findClass('NOSUCHFOO')
+t = .T~new
+say 'method:' t~find('BAR')
+say 'routine:' findr('FOO')
+say 'lib local:' t~local('BAR')
+::requires 'lib.cls'
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/package_local_symbol_writes.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/package_local_symbol_writes.txt
new file mode 100644
index 000000000..c5a43c3e7
--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/package_local_symbol_writes.txt
@@ -0,0 +1,31 @@
+count 30
+/* An environment symbol read again after the package local changes: each
+   read follows a put, a replacement, a remove, a method entry, an unknown
+   method and an empty, so no earlier answer outlives the write. */
+l = .context~package~local
+do i = 1 to 3
+  say i .plwname
+  select
+    when i = 1 then l~put('first', 'PLWNAME')
+    when i = 2 then l['PLWNAME'] = 'second'
+    otherwise l~remove('PLWNAME')
+  end
+end
+say .plwname
+l~setMethod('PLWNAME', 'return "from a method"')
+say .plwname
+l~unsetMethod('PLWNAME')
+say .plwname
+l~setMethod('UNKNOWN', 'return "unknown" arg(1)')
+say .plwname .plwother
+l~unsetMethod('UNKNOWN')
+say .plwname
+l~put('kept', 'PLWNAME'); l~put('other', 'PLWOTHER')
+say .plwname .plwother
+l~empty
+say .plwname .plwother
+do i = 1 to 2
+  say .plwname
+  l~put('loop' i, 'PLWNAME')
+end
+say .plwname
