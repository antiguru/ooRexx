+/// The highest `k` of any `&k` in `text`, or zero for none.
+fn highest_insert(text: &str) -> usize {
+    let bytes = text.as_bytes();
+    bytes
+        .windows(2)
+        .filter(|pair| pair[0] == b'&' && pair[1].is_ascii_digit())
+        .map(|pair| usize::from(pair[1] - b'0'))
+        .max()
+        .unwrap_or(0)
+}
