+| datatype-whole-wide-numbers | 3 |
+| security-manager-method-event | 3 |
+| raise-result-entry | 3 |
+| call-on-trap-argument | 3 |
+| array-array-index | 3 |
+| stream-eof-state | 2 |
+| stream-argument-error-numbers | 2 |
+| redirected-command-holds-baton | 2 |
