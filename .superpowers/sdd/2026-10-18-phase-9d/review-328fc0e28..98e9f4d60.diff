+| identity-collection-equality | 6 |
+| variable-reference-list | 5 |
+| use-arg-reference-conflict | 5 |
+| traceobject-probe-option | 5 |
+| raise-propagate-from-method | 5 |
+| collection-set-operations | 5 |
