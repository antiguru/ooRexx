diff --git a/rust/corpus/lang/stream_charin_eof.rex b/rust/corpus/lang/stream_charin_eof.rex
new file mode 100644
index 000000000..0371c0a13
--- /dev/null
+++ b/rust/corpus/lang/stream_charin_eof.rex
@@ -0,0 +1,48 @@
+/* CHARIN past the end. A read that gets some characters but not all answers
+   them and leaves NOTREADY:EOF, a read that gets none leaves ERROR:0, and a
+   start past the end is NOTREADY:EOF before anything is read and leaves the
+   read position where it was. A read that succeeds makes the stream READY
+   again. Each raise carries what the call answers as RESULT. */
+call charout 'f.txt', '1234567890'
+call charout 'f.txt'
+s = .Stream~new('f.txt')
+call on notready name caught
+call t 's~charin(9, 6)'
+call t 's~charin(, 2)'
+call t 's~charin(30)'
+call t 's~charin(11)'
+call t 's~charin(5)'
+call t 's~charin(1, 0)'
+call t 's~charin(10, 1)'
+call t 's~charin(11, 1)'
+call t 's~charin(4, 3)'
+s~close
+call t "charin('f.txt', 8, 5)"
+call t "stream('f.txt', 'S')"
+call t "charin('f.txt', 1, 2)"
+call t "stream('f.txt', 'S')"
+call lineout 'g.txt', 'one'
+call lineout 'g.txt'
+g = .Stream~new('g.txt')
+call t 'g~linein', g
+call t 'g~linein', g
+call t 'g~linein(1)', g
+call off notready
+signal on notready name eof
+say s~charin(8, 9)
+say 'not reached'
+eof:
+say 'signal' condition('D') condition('O')~result s~description
+exit
+
+t:
+  hits = ''
+  interpret 'r =' arg(1)
+  if arg(2, 'E') then shown = arg(2)
+  else shown = s
+  say arg(1) '[' || r || ']' shown~description hits
+  return
+
+caught:
+  hits = 'raised' condition('D') '[' || condition('O')~result || ']'
+  return
diff --git a/rust/corpus/lang/stream_command_open_failure.rex b/rust/corpus/lang/stream_command_open_failure.rex
new file mode 100644
index 000000000..5e4ed4570
--- /dev/null
+++ b/rust/corpus/lang/stream_command_open_failure.rex
@@ -0,0 +1,56 @@
+/* An OPEN through the COMMAND method that the file system refuses answers
+   ERROR:n. The native open raises NOTREADY inside COMMAND, whose own handler
+   propagates it: the caller's trap takes the same condition object, marked
+   PROPAGATED, and an untrapped condition makes COMMAND answer the object's
+   RESULT. ::OPTIONS NOTREADY SYNTAX does not turn the propagated condition
+   into an error. The OPEN method's own raise is 98.974 in an activation
+   with no CALL OFF NOTREADY in force. A RAISE PROPAGATE of a command's ERROR returns its RESULT too. */
+say 'directory' stream('/', 'c', 'open read')
+say 'directory write' stream('/', 'c', 'open write')
+say 'missing' stream('zz_missing.dat', 'C', 'OPEN READ')
+say 'missing path' stream('nodir/x', 'c', 'open read')
+say 'method' .Stream~new('/')~command('open read')
+call on notready name caught
+say 'call on' stream('/', 'c', 'open read')
+call off notready
+signal on notready name signalled
+say 'signal on' stream('/', 'c', 'open read')
+say 'not reached'
+signalled:
+call show 'signalled'
+say 'routine' viaRoutine()
+say 'method returns' .Opener~new~open('/')
+say 'open method, CALL OFF in force' .Stream~new('/')~open('read')
+say 'open method' directOpen()
+say 'not reached'
+exit
+
+caught:
+  call show 'caught'
+  return
+
+show:
+  o = condition('O')
+  say arg(1) condition('C') condition('D') o~instruction o~propagated o~result,
+    o~additional~class~id o~additional~string
+  return
+
+viaRoutine: procedure
+  signal on notready name inner
+  return stream('/', 'c', 'open read')
+inner:
+  return 'inner' condition('O')~propagated condition('O')~result
+
+::routine directOpen
+  return .Stream~new('/')~open('read')
+
+::class Opener
+::method open
+  use arg name
+  signal on error name failed
+  'exit 7'
+  return 'not reached'
+failed:
+  raise propagate
+
+::options notready syntax
diff --git a/rust/corpus/lang/stream_notready_names.rex b/rust/corpus/lang/stream_notready_names.rex
new file mode 100644
index 000000000..6bd02ff67
--- /dev/null
+++ b/rust/corpus/lang/stream_notready_names.rex
@@ -0,0 +1,55 @@
+/* NOTREADY from a stream whose name is a directory, a name nothing resolves
+   to, a missing path, or a name holding a '80'x byte. An implicit open
+   rejects a directory as it rejects a missing file. The condition carries the
+   name as written as DESCRIPTION, the Stream object as ADDITIONAL, and the
+   value the call answers as RESULT. LINEOUT and CHAROUT with no data run the
+   write setup before they close, which creates a missing file. */
+names = .array~of('/', '*', 'non-existing-file', 'bad' || '80'x || 'name', 'nodir/x')
+ops = .array~of('chars', 'lines', 'linesC', 'linein', 'charin', 'lineout', 'charout', 'close')
+call on notready name caught
+do n over names
+  do op over ops
+    hits = 0
+    seen = ''
+    select
+      when op = 'chars' then r = chars(n)
+      when op = 'lines' then r = lines(n)
+      when op = 'linesC' then r = lines(n, 'C')
+      when op = 'linein' then r = linein(n)
+      when op = 'charin' then r = charin(n)
+      when op = 'lineout' then r = lineout(n, 'x')
+      when op = 'charout' then r = charout(n, 'xy')
+      when op = 'close' then r = lineout(n)
+    end
+    say c2x(n) op '[' || r || '] hits' hits 'state' stream(n) '[' || stream(n, 'D') || ']' seen
+    call lineout n
+  end
+end
+call off notready
+/* The object path: the condition's ADDITIONAL is the receiver itself. */
+s = .Stream~new('/')
+signal on notready name direct
+say s~chars
+direct:
+say 'direct' condition('C') condition('D') (condition('A') == s) condition('O')~result s~description
+/* A charout and a close of a stream opened read-only. */
+call charout 'ro.txt', 'abc'
+call charout 'ro.txt'
+say 'open read' stream('ro.txt', 'c', 'open read')
+call on notready name caught
+hits = 0
+seen = ''
+say 'charout read-only' charout('ro.txt', 'xyz') stream('ro.txt', 'D')
+say 'handler' hits seen
+say 'close read-only' charout('ro.txt') stream('ro.txt', 'D')
+say 'content' charin('ro.txt', 1, 10)
+call lineout 'ro.txt'
+say 'created by close' (stream('*', 'c', 'query exists') \== '') (stream('nodir/x', 'c', 'query exists') \== '')
+exit
+
+caught:
+  hits = hits + 1
+  o = condition('O')
+  seen = 'D=' || c2x(condition('D')) 'A=' || o~additional~class~id || ':' || c2x(o~additional~string),
+    'R=[' || o~result || '] I=' || o~instruction 'P=' || o~propagated
+  return
diff --git a/rust/corpus/lang/stream_position_arguments.rex b/rust/corpus/lang/stream_position_arguments.rex
new file mode 100644
index 000000000..ba947312e
--- /dev/null
+++ b/rust/corpus/lang/stream_position_arguments.rex
@@ -0,0 +1,42 @@
+/* Position and count arguments of the stream builtins and methods. The
+   builtins LINEIN, CHARIN, LINEOUT and CHAROUT take each as a whole number in
+   the 64-bit range, or raise 40.12 naming the builtin and the argument. The
+   methods take a position the same way, or raise 88.907 naming the argument,
+   and a count as an unsigned one. A position below 1 is 93.907, which names
+   argument 1 whichever argument carried it, and is checked only after the
+   implicit open. */
+call lineout 'r.txt', 'abc'
+call lineout 'r.txt'
+values = .array~of('line', '1.5', ' 2 ', '1E1', '-1', 0, .nil, 99999999999999999999, '1.0')
+do v over values
+  call t "lineout('w.txt', , v)"
+  call t "linein('r.txt', v)"
+  call t "linein('r.txt', 1, v)"
+  call t "charin('r.txt', v)"
+  call t "charin('r.txt', 1, v)"
+  call t "charout('w.txt', , v)"
+  call t "charout('w.txt', 'q', v)"
+  call t ".Stream~new('r.txt')~lineIn(v)"
+  call t ".Stream~new('r.txt')~charIn(1, v)"
+  call t ".Stream~new('w.txt')~lineOut('q', v)"
+  call t ".Stream~new('w.txt')~charOut('q', v)"
+end
