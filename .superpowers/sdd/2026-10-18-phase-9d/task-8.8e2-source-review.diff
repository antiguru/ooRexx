+  if name == 'FOO' then self~bar('BAR')
+  a = .array~new(10)
+  m = .context~executable
+  if name == 'FOO' then original = .foo~value
+  else original = .bar~value
+  say name (m == original) m~isGuarded m~isPrivate m~isProtected
+::method other
+  return 17
+::class s subclass k
