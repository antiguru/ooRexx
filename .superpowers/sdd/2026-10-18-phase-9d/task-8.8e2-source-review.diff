+    assert_eq!(ran.outcome.exit_code, 0, "{}", ran.stderr());
+    assert_eq!(ran.stdout(), "48.1 progress\n48.1 progress\n");
+    assert_eq!(ran.exits, 0);
+    assert_eq!(ran.abandoned, 0);
+}
+
+#[test]
+fn configured_inline_and_fixed_saturation_are_not_spawn_errors() {
+    let disabled = crate::scheduler::Pool::new(1 << 46, 0);
+    assert!(matches!(disabled.reserve(), Ok(None)));
+    let pool = crate::scheduler::Pool::new(1 << 20, 1);
+    pool.fix_at_bound();
+    let worker = pool.reserve().expect("spawn").expect("worker");
+    assert!(matches!(pool.reserve(), Ok(None)));
+    let (sent, received) = std::sync::mpsc::channel();
+    worker.run(Box::new(move || sent.send(()).expect("receiver")));
+    received
+        .recv_timeout(std::time::Duration::from_secs(5))
+        .expect("body ran");
+}
diff --git a/rust/crates/rexx-exec/src/test_process.rs b/rust/crates/rexx-exec/src/test_process.rs
new file mode 100644
index 000000000..1dc65d7ba
--- /dev/null
+++ b/rust/crates/rexx-exec/src/test_process.rs
@@ -0,0 +1,52 @@
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+/// Runs the named unit test alone with bounded virtual address space and an
+/// open, empty stdin pipe. The resident cap is inherited from the test driver.
+pub(crate) fn isolated(name: &str) -> bool {
+    isolated_with_input(name, None)
+}
+
+#[expect(
+    clippy::disallowed_methods,
+    reason = "bounds the isolated test process using real time"
+)]
+pub(crate) fn isolated_with_input(name: &str, input: Option<&[u8]>) -> bool {
+    const CHILD: &str = "REXX_POOL_FAILURE_CHILD";
+    if std::env::var(CHILD).as_deref() == Ok(name) {
+        let pool = crate::scheduler::Pool::new(1 << 46, 1);
+        match pool.reserve() {
+            Err(_) => assert_eq!(pool.threads(), 0),
+            Ok(Some(worker)) => {
+                worker.run(Box::new(|| {}));
+                panic!("huge-stack seam unexpectedly spawned a worker");
+            }
+            Ok(None) => panic!("huge-stack seam selected configured inline mode"),
+        }
+        return false;
+    }
+    let executable = std::env::current_exe().expect("test executable");
+    let mut child = Command::new("python3")
+        .args(["-c", "import os,resource,sys; resource.setrlimit(resource.RLIMIT_AS,(8<<30,8<<30)); os.execv(sys.argv[1],sys.argv[1:])"])
+        .arg(executable).args(["--exact", name, "--nocapture"])
+        .env(CHILD, name).stdin(Stdio::piped()).spawn().expect("isolated test");
+    let mut writer = child.stdin.take().expect("open empty pipe");
+    if let Some(input) = input {
+        std::io::Write::write_all(&mut writer, input).expect("test input");
+    }
+    let deadline = Instant::now() + Duration::from_secs(25);
+    let status = loop {
+        if let Some(status) = child.try_wait().expect("wait") {
+            break status;
+        }
+        if Instant::now() >= deadline {
+            child.kill().expect("kill timed out child");
+            child.wait().expect("reap timed out child");
+            panic!("isolated test blocked, possibly reading stdin inline");
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    };
+    drop(writer);
+    assert!(status.success(), "isolated test failed: {status}");
+    true
+}
