+/// A terminal RETURN leaves no slice request for the incoming sort.
+#[cfg(feature = "pinning")]
+#[test]
+fn a_terminal_return_leaves_no_slice_for_the_incoming_sort() {
+    assert_no_incoming_sort_slice("return");
+}
