diff --git a/rust/bench-programs/pingpong/pingguard.rex b/rust/bench-programs/pingpong/pingguard.rex
new file mode 100644
index 000000000..a00762e86
--- /dev/null
+++ b/rust/bench-programs/pingpong/pingguard.rex
@@ -0,0 +1,28 @@
+/* GUARD WHEN handoff: two activities pass a turn through one object's
+   variable, each waiting in GUARD ON WHEN for its own turn, n times each. */
+n = 100000
+t = .table~new
+t~start('pong', n)
+t~ping(n)
+say 'done'
+
+::class table
+::method init
+    expose turn
+    turn = 0
+::method ping
+    expose turn
+    use arg n
+    do i = 1 to n
+        guard on when turn = 0
+        turn = 1
+        guard off
+    end
+::method pong
+    expose turn
+    use arg n
+    do i = 1 to n
+        guard on when turn = 1
+        turn = 0
+        guard off
+    end
diff --git a/rust/bench-programs/pingpong/pingmsg.rex b/rust/bench-programs/pingpong/pingmsg.rex
new file mode 100644
index 000000000..70ebd557b
--- /dev/null
+++ b/rust/bench-programs/pingpong/pingmsg.rex
@@ -0,0 +1,14 @@
+/* Message round trip: a message started on a new activity and its result
+   awaited, n times. */
+n = 80000
+o = .echo~new
+total = 0
+do i = 1 to n
+    total = total + o~start('back', 1)~result
+end
+say total
+
+::class echo
+::method back
+    use arg i
+    return i
diff --git a/rust/bench-programs/pingpong/pingsem.rex b/rust/bench-programs/pingpong/pingsem.rex
new file mode 100644
index 000000000..4b045d676
--- /dev/null
+++ b/rust/bench-programs/pingpong/pingsem.rex
@@ -0,0 +1,21 @@
+/* Semaphore post/wait: two activities hand a turn back and forth through two
+   event semaphores, n times each way. */
+n = 100000
+ping = .eventSemaphore~new
+pong = .eventSemaphore~new
+.player~new~start('play', ping, pong, n)
+do i = 1 to n
+    ping~post
+    pong~wait
+    pong~reset
+end
+say 'done'
+
+::class player
+::method play
+    use arg ping, pong, n
+    do i = 1 to n
+        ping~wait
+        ping~reset
+        pong~post
+    end
