 /// Whether `outcome` is a run that did not finish -- either layer's.
 pub fn did_not_finish(outcome: &Outcome) -> bool {
     outcome.stderr.ends_with(rexx_exec::DEADLINE_REPORT)
         || outcome.stderr.starts_with(b"rexx-watchdog: ")
 }
