index 000000000..71f65a599
--- /dev/null
+++ b/rust/corpus/lang/routine_object_add_copy.env
@@ -0,0 +1,4 @@
+# The oracle's own build of librxmath.so. The spawned side is given this
+# directory anyway; the in-process side reads it from here because the process
+# loader cannot be told later.
+LD_LIBRARY_PATH={oraclelib}
diff --git a/rust/corpus/lang/routine_object_add_copy.rex b/rust/corpus/lang/routine_object_add_copy.rex
new file mode 100644
index 000000000..ebdfcaee5
--- /dev/null
+++ b/rust/corpus/lang/routine_object_add_copy.rex
@@ -0,0 +1,26 @@
+/* ~addRoutine of a library or internal row's Routine object, and of a copy
+   of one: findRoutine answers the object added, and a call runs the row. */
+p = .context~package
+u = .Routine~loadExternalRoutine('x', 'LIBRARY rexxutil SysSleep')
+c = u~copy
+p~addRoutine('C1', c)
+say 'internal copy' (p~findRoutine('c1') == c) (p~findRoutine('c1') == u) c1(0)
+q = p~findRoutine('RXCALCSQRT')
+p~addRoutine('SQ2', q)
+say 'library' (p~findRoutine('sq2') == q) sq2(16)
+d = q~copy
+p~addRoutine('SQ3', d)
+say 'library copy' (p~findRoutine('sq3') == d) (d == q) sq3(25)
+r = .Package~new('r', 'nop')
+p~addPublicRoutine('C2', u~copy)
+r~addPackage(p)
+p~addPublicRoutine('C2', u)
+do i = 1 to 20; zj = 'filler' i; end
+f = r~findRoutine('C2')
+say 'importer' (f == u) (f == p~findRoutine('C2')) f~class~id f~call(0)
+signal on syntax
+p~addRoutine('M1', .Method~new('m', 'nop'))
+say 'method added'
+exit
+syntax: say 'method' condition('o')~code
+::requires 'rxmath' LIBRARY
