+rexx-run-9b1-t4f pkghold20k 638300 kB
+rexx-run-9b1-t4f methloop20k 502908 kB
+
+# programs
+== pkgloop20k.rex
+do i = 1 to 20000
+  p = .Package~new('p', 'return 1')
+end
+say 'done'
+== pkgloop40k.rex
+do i = 1 to 40000
+  p = .Package~new('p', 'return 1')
+end
+say 'done'
+== pkgloop80k.rex
+do i = 1 to 80000
+  p = .Package~new('p', 'return 1')
+end
+say 'done'
+== pkghold20k.rex
+a = .array~new
+do i = 1 to 20000
+  a~append(.Package~new('p', 'return 1'))
+end
+say 'done'
+== methloop20k.rex
+do i = 1 to 20000
+  m = .Method~new('m', 'return 1')
+end
+say 'done'
