+# Peak RSS, /usr/bin/time -f %M on each interpreter binary itself, from a fresh empty directory.
+# oracle: ( ulimit -v 1048576 -t 120; LD_LIBRARY_PATH=/home/moritz/dev/repos/ooRexx/build/lib /usr/bin/time -f 'oracle NAME %M kB' /home/moritz/dev/repos/ooRexx/build/bin/rexx NAME.rex )
+# crate:  ( ulimit -v 4194304 -t 120; /usr/bin/time -f 'BIN NAME %M kB' BIN NAME.rex )
+# rexx-run-9b1-t5a is built at dd5017a8e; rexx-run-9b1-t4f is Task 4's final binary.
+
+oracle pkgloop20k 20436 kB
+oracle pkgloop80k 20312 kB
+oracle pkghold20k 52028 kB
+oracle methloop20k 20436 kB
+rexx-run-9b1-t5a pkgloop20k 593424 kB
+rexx-run-9b1-t5a pkgloop40k 1146484 kB
