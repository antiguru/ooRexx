diff --git a/docs/superpowers/records/2026-10-14-phase-9b1/task-8/class-shapes/shapes.rex b/docs/superpowers/records/2026-10-14-phase-9b1/task-8/class-shapes/shapes.rex
new file mode 100644
index 000000000..0ca534643
--- /dev/null
+++ b/docs/superpowers/records/2026-10-14-phase-9b1/task-8/class-shapes/shapes.rex
@@ -0,0 +1,25 @@
+/* For each way a program makes a class: does a WeakReference to a dropped one
+   clear while the loop makes more of them? Prints the iteration it cleared at. */
+call try 'subclass', "c = .object~subclass('t')"
+call try 'class new', "c = .class~new('t2')"
+call try 'mixinclass', "c = .object~mixinclass('m')"
+call try 'metaclass', "c = .class~subclass('meta')"
+call try 'subclass of subclass', "c = .object~subclass('a')~subclass('b')"
+call try 'class uninit', "c = .object~subclass('u'); c~define('UNINIT', 'nop')"
+call try 'package new', "c = .Package~new('p', ('::class c', '::method a'))~classes['C']"
+call try 'requires', "c = .Package~new('pr', '::requires ''reqc.rex''')~importedPackages[1]~classes['RC']"
+call try 'routine new', "c = .Routine~new('r', ('return 1', '::class rcl'))~package~classes['RCL']"
+call try 'with instance dropped', "c = .object~subclass('wi'); i = c~new"
+call try 'class new subclass', "c = .class~new('t3')~subclass('t4')"
+exit
+try: procedure
+  parse arg tag, make
+  interpret make
+  w = .WeakReference~new(c)
+  drop c i
+  do n = 1 to 20000 until w~value == .nil
+    interpret make
+    drop c i
+  end
+  say tag 'cleared:' (w~value == .nil)
+  return
diff --git a/docs/superpowers/records/2026-10-14-phase-9b1/task-8/enumerate-maps.sh b/docs/superpowers/records/2026-10-14-phase-9b1/task-8/enumerate-maps.sh
new file mode 100755
index 000000000..3e4e3dcd5
--- /dev/null
+++ b/docs/superpowers/records/2026-10-14-phase-9b1/task-8/enumerate-maps.sh
@@ -0,0 +1,36 @@
+#!/bin/sh
+# Prints file:line<TAB>struct<TAB>field<TAB>type for every map, set or vector
+# field of the long-lived interpreter tables: Interp and what it holds by value
+# (the program table, the object and environment models, the libraries, the
+# activity and its scheduler), Heap and RootSet, ClassRegistry and its graph,
+# a package's own data, and the rexx-api handle tables. Byte buffers
+# (Vec<u8>, Vec<Vec<u8>>) are left out. Run from rust/.
+structs='^(Interp|Programs|ObjectModel|EnvironmentModel|Libraries|PackageTable|Activities|GuardTable|Semaphores|Activity|PackageData|Heap|RootSet|ActivityRoots|ClassRegistry|ClassGraph|ClassDef|MethodDict|Table|Released)$'
+for f in \
+  crates/rexx-exec/src/lib.rs \
+  crates/rexx-exec/src/plan.rs \
+  crates/rexx-exec/src/environment.rs \
+  crates/rexx-exec/src/dispatch.rs \
+  crates/rexx-exec/src/libraries.rs \
+  crates/rexx-exec/src/scheduler.rs \
+  crates/rexx-exec/src/guards.rs \
+  crates/rexx-exec/src/semaphores.rs \
+  crates/rexx-exec/src/activity.rs \
+  crates/rexx-exec/src/package_state.rs \
+  crates/rexx-core/src/heap.rs \
+  crates/rexx-core/src/roots.rs \
+  crates/rexx-classes/src/registry.rs \
+  crates/rexx-classes/src/class_graph.rs \
+  crates/rexx-classes/src/method_dict.rs \
+  crates/rexx-api/src/handles.rs
+do
+  awk -v f="$f" -v keep="$structs" '
+    /^(pub(\([a-z]+\))? )?struct [A-Za-z]+ *\{/ { s = $0; sub(/^.*struct /, "", s); sub(/[ <{].*/, "", s); inside = (s ~ keep); next }
+    inside && /^\}/ { inside = 0; next }
+    inside && /^    (pub(\([a-z]+\))? )?[a-z_0-9]+: / && /(Map|Set|Vec)</ && !/: (Vec<u8>|Vec<Vec<u8>>|std::cell::Cell<Vec<u8>>),?$/ {
+      line = $0; sub(/^ +/, "", line); sub(/^pub(\([a-z]+\))? /, "", line)
+      name = line; sub(/:.*/, "", name); type = line; sub(/^[a-z_0-9]+: /, "", type); sub(/,$/, "", type)
+      printf "%s:%d\t%s\t%s\t%s\n", f, NR, s, name, type
+    }
+  ' "$f"
+done
