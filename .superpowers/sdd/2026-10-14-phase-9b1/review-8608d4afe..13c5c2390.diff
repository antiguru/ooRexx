+rexx-run-9b1-t6d pkgloop80000 421156 kB
+rexx-run-9b1-t5c pkgloop80000 2240644 kB
+
+charge-experiment methloop80000 54532 kB
+charge-experiment routloop80000 53796 kB
+charge-experiment setmloop80000 54624 kB
+charge-experiment pkgloop80000 67028 kB
+
+# programs
+== empty.rex
+say 'done'
+== methloop20000.rex
+do i = 1 to 20000
+  m = .Method~new('m', 'return 1')
+end
+say 'done'
+== routloop20000.rex
+do i = 1 to 20000
+  r = .Routine~new('r', 'return 1')
+end
+say 'done'
+== setmloop20000.rex
+o = .k~new
+do i = 1 to 20000
+  o~go
+end
+say 'done'
+::class k
+::method go
+  self~setMethod('FOO', 'return 1')
+== pkgloop20000.rex
+do i = 1 to 20000
+  p = .Package~new('p', 'return 1')
+end
+say 'done'
+# the 80000 programs are the 20000 ones with 80000 as the bound
