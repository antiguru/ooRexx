+# Peak RSS, /usr/bin/time -f %M on each interpreter binary itself, from a fresh directory holding only the programs below.
+# oracle: ( ulimit -v 1048576 -t 120; LD_LIBRARY_PATH=/home/moritz/dev/repos/ooRexx/build/lib /usr/bin/time -f 'oracle NAME %M kB' /home/moritz/dev/repos/ooRexx/build/bin/rexx NAME.rex )
+# crate:  ( ulimit -v 4194304 -t 120; /usr/bin/time -f 'BIN NAME %M kB' /home/moritz/dev/repos/ooRexx-p9-pin/BIN NAME.rex )
+# rexx-run-9b1-t6d is this task's binary (.text identical to a release build at c27f3b938).
+# rexx-run-9b1-t5c is Task 5's final binary.
+# rexx-run-9b1-t6-charge-experiment is t6d plus `self.charge_unheld(20_000)` where package_object
+# builds a program's package, measured once and not committed.
+
+oracle empty 8248 kB
+rexx-run-9b1-t6d empty 19900 kB
+rexx-run-9b1-t5c empty 20100 kB
+oracle methloop20000 20888 kB
+rexx-run-9b1-t6d methloop20000 175540 kB
+rexx-run-9b1-t5c methloop20000 450332 kB
+oracle methloop80000 20748 kB
+rexx-run-9b1-t6d methloop80000 175688 kB
+rexx-run-9b1-t5c methloop80000 1728540 kB
+oracle routloop20000 19984 kB
+rexx-run-9b1-t6d routloop20000 174776 kB
+rexx-run-9b1-t5c routloop20000 447536 kB
+oracle routloop80000 20692 kB
