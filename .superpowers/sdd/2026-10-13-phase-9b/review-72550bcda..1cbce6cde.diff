diff --git a/rust/corpus/lang/rexxutil_file_copy_move.rex b/rust/corpus/lang/rexxutil_file_copy_move.rex
new file mode 100644
index 000000000..d36dcf55b
--- /dev/null
+++ b/rust/corpus/lang/rexxutil_file_copy_move.rex
@@ -0,0 +1,110 @@
+/* SysFileCopy and SysFileMove: the answers for a missing source, one file
+   named twice, a directory at either end, a link at either end, a target
+   that exists, a source that cannot be read, a name with a blank and names
+   that are not UTF-8. Then the times and mode a copy keeps, and the
+   argument errors. Everything is made under a directory this program makes
+   and removes. A move across file systems is not here: the oracle answers an
+   uninitialised errno for it (oracle-crashes.txt entry 39). */
+d = 'copymove.d'
+call SysMkDir d
+call make d'/a.txt', 'alpha'
+say 'copy missing   ' SysFileCopy(d'/none', d'/b.txt')
+say 'copy           ' SysFileCopy(d'/a.txt', d'/b.txt') show(d'/b.txt')
+say 'copy same      ' SysFileCopy(d'/a.txt', d'/../'d'/./a.txt')
+say 'copy over      ' SysFileCopy(d'/a.txt', d'/b.txt') show(d'/b.txt')
+say 'copy empty     ' SysFileCopy('', d'/x') SysFileCopy(d'/a.txt', '')
+call SysMkDir d'/sub'
+say 'copy from dir  ' SysFileCopy(d'/sub', d'/c.txt') SysFileExists(d'/c.txt') show(d'/c.txt')
+say 'copy to dir    ' SysFileCopy(d'/a.txt', d'/sub')
+say 'copy to dir/   ' SysFileCopy(d'/a.txt', d'/sub/')
+say 'copy into none ' SysFileCopy(d'/a.txt', d'/none/x')
+say 'copy blank     ' SysFileCopy(d'/a.txt', d'/with blank.txt') show(d'/with blank.txt')
+odd = d'/n' || 'ff'x || '.txt'
+lossy = d'/n' || 'efbfbd'x || '.txt'
+say 'copy not utf8  ' SysFileCopy(d'/a.txt', odd) SysFileExists(odd) SysFileExists(lossy) show(odd)
+say 'copy utf8      ' SysFileCopy(odd, d'/caf' || 'c3a9'x || '.txt') show(d'/caf' || 'c3a9'x || '.txt')
+say 'copy nul cut   ' SysFileCopy(d'/a.txt' || '00'x || 'junk', d'/cut.txt' || '00'x || 'more') show(d'/cut.txt')
+-- times kept to the second, mode given only to a target the copy creates
+'chmod 640' d'/a.txt'
+call SysSetFileDateTime d'/a.txt', '2001-02-03', '04:05:06'
+'touch -a -d @1000000000' d'/a.txt'
+'chmod 600' d'/b.txt'
+say 'copy times     ' SysFileCopy(d'/a.txt', d'/new.txt') SysFileCopy(d'/a.txt', d'/b.txt')
+'stat -c "%n %a %X %Y"' d'/new.txt'
+'stat -c "%n %a %Y"' d'/b.txt'
+-- links: a copy follows them, a move keeps them
+'ln -s a.txt' d'/link'
+'ln -s nowhere' d'/dangling'
+'ln -s sub' d'/dirlink'
+say 'copy from link ' SysFileCopy(d'/link', d'/fromlink.txt') SysIsFileLink(d'/fromlink.txt') show(d'/fromlink.txt')
+call make d'/beta.txt', 'beta'
+say 'copy to link   ' SysFileCopy(d'/beta.txt', d'/link') SysIsFileLink(d'/link') show(d'/a.txt')
+say 'copy dangling  ' SysFileCopy(d'/dangling', d'/x') SysFileCopy(d'/a.txt', d'/dangling') SysIsFileLink(d'/dangling') show(d'/nowhere')
+call SysFileDelete d'/nowhere'
+say 'copy dirlink   ' SysFileCopy(d'/a.txt', d'/dirlink/in.txt') show(d'/sub/in.txt')
+-- a directory that cannot be read or searched
+call SysMkDir d'/closed'
+call make d'/closed/f.txt', 'shut'
+'chmod 000' d'/closed'
+say 'copy closed    ' SysFileCopy(d'/closed/f.txt', d'/x') SysFileCopy(d'/a.txt', d'/closed/g.txt')
+say 'move closed    ' SysFileMove(d'/closed/f.txt', d'/x') SysFileMove(d'/a.txt', d'/closed/g.txt')
+'chmod 700' d'/closed'
+call make d'/unreadable.txt', 'secret'
+'chmod 200' d'/unreadable.txt'
+say 'copy unreadable' SysFileCopy(d'/unreadable.txt', d'/x') SysFileExists(d'/x')
+-- moves
+say 'move missing   ' SysFileMove(d'/none', d'/m.txt')
+say 'move same      ' SysFileMove(d'/a.txt', d'/a.txt')
+say 'move onto file ' SysFileMove(d'/a.txt', d'/b.txt')
+say 'move           ' SysFileMove(d'/b.txt', d'/m.txt') SysFileExists(d'/b.txt') show(d'/m.txt')
+say 'move to dir    ' SysFileMove(d'/m.txt', d'/sub')
+say 'move dir       ' SysFileMove(d'/sub', d'/sub2') SysIsFileDirectory(d'/sub2') SysIsFileLink(d'/dirlink')
+say 'move link      ' SysFileMove(d'/link', d'/link2') SysIsFileLink(d'/link2') show(d'/link2')
+say 'move dangling  ' SysFileMove(d'/dangling', d'/dangling2') SysIsFileLink(d'/dangling2')
+say 'move onto link ' SysFileMove(d'/m.txt', d'/link2') SysIsFileLink(d'/link2')
+say 'move not utf8  ' SysFileMove(odd, d'/o' || 'fe'x) SysFileExists(odd) SysFileExists(d'/o' || 'fe'x)
+say 'move trailing /' SysFileMove(d'/m.txt/', d'/t.txt/') show(d'/t.txt')
+-- argument errors
+call t "call SysFileCopy"
+call t "call SysFileCopy 'x'"
+call t "call SysFileCopy .nil, 'x'"
+call t "call SysFileCopy 'x', .nil"
+call t "call SysFileCopy 'x', 'y', 'z'"
+call t "call SysFileMove , 'y'"
+call t "call SysFileMove 'x', .nil"
+call t "call SysFileMove 'x', 'y', 'z'"
+call t "r = SysFileCopy(d'/none', d'/x'); say 'returned' r"
+'chmod -R 700' d
+'rm -rf' d
+call SysFileMove 'x'
+exit
+
+make: procedure
+  parse arg name, text
+  call lineout name, text
+  call lineout name
+  return
+
+show: procedure
+  parse arg name
+  if \SysFileExists(name) then return '(none)'
+  -- a stream opens a name that is not UTF-8 as this crate spells it, so
+  -- the contents are read through a copy under a plain name
+  view = 'view.txt'
+  call SysFileDelete view
+  call SysFileCopy name, view
+  text = charin(view, 1, chars(view))
+  call stream view, 'c', 'close'
+  call SysFileDelete view
+  return '['text']'
+
+t: procedure expose d
+  parse arg code
+  signal on syntax name bad
+  interpret code
+  say 'ok   ' code
+  return
+bad:
+  c = condition('O')
+  say 'error' code '|' c~code c~message
+  return
diff --git a/rust/corpus/lang/rexxutil_file_date_time.rex b/rust/corpus/lang/rexxutil_file_date_time.rex
new file mode 100644
index 000000000..a33decfbd
--- /dev/null
+++ b/rust/corpus/lang/rexxutil_file_date_time.rex
@@ -0,0 +1,110 @@
+/* SysSetFileDateTime and SysGetFileDateTime: dates and times that scan and
+   ones that do not, fields past their range carrying into the next, a
+   reading the local zone skips and one it repeats (each also as seconds
+   since the epoch, which tells the two instants of a repeated reading
+   apart), years before 1000 and before 1970, the access time a set keeps,
+   either half omitted, links, a directory, names that resolve to nothing,
+   and the argument errors. The daylight-saving lines are the zone's own
+   transitions in Europe and in North America. Everything is made under a
+   directory this program makes and removes. */
+d = 'datetime.d'
+call SysMkDir d
+f = d'/a.txt'
+call lineout f, 'x'
+call lineout f
+call s '2020-03-04', '05:06:07'
+call s '2020-03-29', '02:30:00', 'epoch'
+call s '2020-03-29', '01:59:59', 'epoch'
+call s '2020-03-29', '03:00:00', 'epoch'
+call s '2020-10-25', '02:30:00', 'epoch'
+call s '2020-10-25', '01:59:59', 'epoch'
+call s '2020-10-25', '03:00:00', 'epoch'
+call s '2020-03-08', '02:30:00', 'epoch'
+call s '2020-11-01', '01:30:00', 'epoch'
+call s '2020-07-01', '12:00:00', 'epoch'
+call s '2020-13-01', '00:00:00'
+call s '2020-02-30', '00:00:00'
+call s '2020-00-00', '00:00:00'
+call s '2020-01-01', '24:00:00'
+call s '2020-01-01', '99:99:99'
+call s '2020-1-2', '3:4:5'
+call s ' 2020-01-02', ' 3: 4: 5'
+call s '2020-01-02junk', '03:04:05junk'
+call s '20200-01-01', '00:00:00'
+call s '+2020-01-01', '00:00:00'
+call s '+202-01-01', '00:00:00'
+call s '-202-01-01', '00:00:00', 'epoch'
+call s '1800-01-01', '00:00:00', 'epoch'
+call s '0999-05-06', '00:00:00'
+call s '1969-12-31', '23:59:59', 'epoch'
+call s '2020-01-01', '05:06'
+call s '', ''
+call s '2021-06-07', ''
+call s '2021-06-08'
+call s , '11:12:13'
+call s '2020-1-1', '1:2:3' || '00'x || 'x'
+call s '2020-1-1' || '00'x || 'x', '1:2:3'
+call s 'a020-01-01', '00:00:00'
+call s '2020-01-01', '00:00:-1'
+call s '2020-01-01', '-1:00:00'
+call s '2020-01-01', '+1:+2:+3'
+call s '2020-01-01', '1: 2:3'
+call s '2020-01-01', '1 :2:3'
+call s '2020-01-01', '1:2:'
+call s '2020-01-01', '-:2:3'
+'touch -a -d @1000000000' f
+say 'keeps access' SysSetFileDateTime(f, '2011-12-13', '14:15:16')
+'stat -c "%X %Y"' f
+say 'now         ' SysSetFileDateTime(f) (left(SysGetFileDateTime(f), 10) == date('I'))
+'stat -c "%X"' f
+call SysSetFileDateTime f, '2002-02-02', '02:02:02'
+say 'selectors   ' SysGetFileDateTime(f, 'w') SysGetFileDateTime(f, 'Write') ,
+  SysGetFileDateTime(f, 'axe') SysGetFileDateTime(f, 'A' || '00'x)
+'ln -s a.txt' d'/link'
+'ln -s nowhere' d'/dangling'
+say 'link        ' SysSetFileDateTime(d'/link', '2003-03-03', '03:03:03') SysGetFileDateTime(f)
+say 'dangling    ' SysSetFileDateTime(d'/dangling', '2003-03-03', '03:03:03') SysGetFileDateTime(d'/dangling')
+say 'directory   ' SysSetFileDateTime(d, '2004-04-04', '04:04:04') SysGetFileDateTime(d) SysGetFileDateTime(d'/')
+say 'blank, utf8 ' SysFileCopy(f, d'/a b' || 'c3a9ff'x) SysSetFileDateTime(d'/a b' || 'c3a9ff'x, '2005-05-05', '05:05:05') ,
+  SysGetFileDateTime(d'/a b' || 'c3a9ff'x)
+say 'missing     ' SysSetFileDateTime(d'/none', '2020-01-01', '00:00:00') SysSetFileDateTime(d'/none') ,
+  SysGetFileDateTime(d'/none') SysGetFileDateTime('') SysSetFileDateTime('')
+call SysMkDir d'/closed'
+call SysFileCopy f, d'/closed/in.txt'
+'chmod 000' d'/closed'
+say 'closed      ' SysGetFileDateTime(d'/closed/in.txt') SysSetFileDateTime(d'/closed/in.txt', '2006-06-06')
+'chmod 700' d'/closed'
+call t "call SysGetFileDateTime"
+call t "call SysGetFileDateTime f, ''"
+call t "call SysGetFileDateTime f, 'x'"
+call t "call SysGetFileDateTime d'/none', 'x'"
+call t "call SysGetFileDateTime f, .nil"
+call t "call SysGetFileDateTime f, 'w', 'x'"
+call t "call SysSetFileDateTime"
+call t "call SysSetFileDateTime f, .nil"
+call t "call SysSetFileDateTime f, , .nil"
+call t "call SysSetFileDateTime f, 1, 2, 3"
+call t "r = SysSetFileDateTime(f, '2020-01-01'); say 'returned' r"
+'rm -rf' d
+call SysGetFileDateTime f, 'Q'
+exit
+
+s: procedure expose f
+  if arg(1, 'e') & arg(2, 'e') then r = SysSetFileDateTime(f, arg(1), arg(2))
+  else if arg(1, 'e') then r = SysSetFileDateTime(f, arg(1))
+  else r = SysSetFileDateTime(f, , arg(2))
+  say left('['translate(arg(1), '?', '00'x)'] ['translate(arg(2), '?', '00'x)']', 34) r ,
+    SysGetFileDateTime(f) SysGetFileDateTime(f, 'W')
+  if arg(3) == 'epoch' then 'stat -c "  %Y"' f
+  return
+
+t: procedure expose f d
+  parse arg code
+  signal on syntax name bad
+  interpret code
+  say 'ok   ' code
+  return
+bad:
+  c = condition('O')
+  say 'error' code '|' c~code c~message
+  return
diff --git a/rust/corpus/lang/rexxutil_file_search.rex b/rust/corpus/lang/rexxutil_file_search.rex
new file mode 100644
index 000000000..e1ef7cbe2
--- /dev/null
+++ b/rust/corpus/lang/rexxutil_file_search.rex
@@ -0,0 +1,113 @@
+/* SysFileSearch: line ends (LF, CR LF, a lone CR, none at the end, empty
+   lines), case and its options, line numbers, a NUL in the needle and in
+   a line, an empty needle, a line longer than the reader's buffer, an
+   array, a stem object, a stem name with and without its period, tails
+   past the count left alone, a missing file, a directory, a file that
+   cannot be read, names with a blank and bytes that are not UTF-8, and the
+   errors. The array is given lines longer than a string held inline, so
+   it grows while it holds values that live in the heap. Everything is
+   made under a directory this program makes and removes. */
+d = 'filesearch.d'
+call SysMkDir d
+f = d'/a.txt'
+call charout f, 'Alpha beta' || '0a'x || 'gamma' || '0d0a'x || 'ALPHA' || '00'x || 'x' || '0a'x || ,
+  '0a'x || 'cr only' || '0d'x || 'alpha' || '0d0d0a'x || '1a'x || 'alpha tail' || '0d'x
+call charout f
+s.5 = 'keep'
+s.7 = 'keep too'
+say SysFileSearch('alpha', f, 's.') s.0 s.5 s.7
+call show 's.'
+drop s.
+say SysFileSearch('alpha', f, 's.', 'CN') s.0
+call show 's.'
+say SysFileSearch('ALPHA', f, 's', 'c') s.0
+call show 's.'
+say SysFileSearch('alpha', f, 's.', 'cI') s.0 SysFileSearch('alpha', f, 's.', 'IC') s.0
+say SysFileSearch('alpha', f, 's.', 'nnN') s.0 SysFileSearch('alpha', f, 's.', '') s.0
+say SysFileSearch('', f, 's.') s.0
+say SysFileSearch('ALPHA' || '00'x, f, 's.', 'c') s.0 c2x(s.1)
+say SysFileSearch('beta' || '0a'x, f, 's.') s.0
+say SysFileSearch('a', f, 's.', 'n' || '00'x || 'Q') s.0
+say SysFileSearch('a', f || '00'x || 'junk', 's.') s.0
+a = .array~of(1, 2, 3)
+say SysFileSearch('a', f, a, 'n') a~items a~size
+do x over a; say '  ' c2x(x); end
+long = ''
+do i = 1 to 6
+  long = long || copies('alpha', 10 + i) || '0a'x
+end
+call charout d'/long.txt', long
+call charout d'/long.txt'
+a = .array~of('x')
+say SysFileSearch('alpha', d'/long.txt', a, 'n') a~items a~size
+do x over a; say '  ' x~length left(x, 3); end
+st = .stem~new
+say SysFileSearch('alpha', f, st) st[0]
+call charout d'/e.txt', ''
+call charout d'/e.txt'
+say SysFileSearch('a', d'/e.txt', 's.') s.0
+call charout d'/l.txt', copies('x', 5000) || 'needle' || copies('y', 5000) || '0a'x || 'needle'
+call charout d'/l.txt'
+say SysFileSearch('needle', d'/l.txt', 's.', 'n') s.0 length(s.1) left(s.1, 3) s.2
+call SysFileCopy f, d'/with blank'
+call SysFileCopy f, d'/n' || 'ff'x
+say SysFileSearch('tail', d'/with blank', 's.') s.0 SysFileSearch('tail', d'/n' || 'ff'x, 's.') s.0 ,
+  SysFileSearch('tail', d'/n' || 'efbfbd'x, 's.') s.0
+-- nothing to read: the count is still set, and an array is still emptied
+s.0 = 9
+say SysFileSearch('a', d'/none', 's.') s.0
+t. = 'dflt'
+say SysFileSearch('a', d'/none', 't') t.0 t.1
+say SysFileSearch('a', d, 's.') s.0
+say SysFileSearch('a', d'/', 's.') s.0
+say SysFileSearch('a', d'/none', a) a~items
+call make d'/unreadable.txt'
+'chmod 200' d'/unreadable.txt'
+say SysFileSearch('a', d'/unreadable.txt', 's.') s.0
+-- errors
+b = .myarray~new
+call t "say SysFileSearch('a', f, b)"
+call t "call SysFileSearch 'a', f, .nil"
+call t "call SysFileSearch 'a', f, 'a.1'"
+call t "call SysFileSearch 'a', f, '*'"
+call t "call SysFileSearch 'a', f, .object~new"
+call t "call SysFileSearch 'a', f, 's.', 'Q'"
+call t "call SysFileSearch 'a', f, 's.', 'nNiIcCzz'"
+call t "call SysFileSearch 'a', f, 's.', copies('Z', 300)"
+call t "call SysFileSearch 'a', f, 's.', 'q' || '00'x || 'r'"
+call t "call SysFileSearch .nil, f, 's.'"
+call t "call SysFileSearch 'a', .nil, 's.'"
+call t "call SysFileSearch 'a', f"
+call t "call SysFileSearch 'a', , 's.'"
+call t "call SysFileSearch 'a', f, 's.', .nil"
+call t "call SysFileSearch 'a', f, 's.', 'x', 'y'"
+call t "r = SysFileSearch('zzz', f, 's.'); say 'returned' r s.0"
+'chmod 600' d'/unreadable.txt'
+'rm -rf' d
+call SysFileSearch 'a', 'x', 's.', 'Y'
+exit
+
+show: procedure expose s.
+  do i = 1 to s.0
+    say '  ' i c2x(s.i)
+  end
+  return
+
+make: procedure
+  parse arg name
+  call lineout name, 'x'
+  call lineout name
+  return
+
+t: procedure expose f b
+  parse arg code
+  signal on syntax name bad
+  interpret code
+  say 'ok   ' code
+  return
+bad:
+  c = condition('O')
+  say 'error' translate(code, '?', '00'x) '|' c~code c~message
+  return
+
+::class myarray subclass array
diff --git a/rust/corpus/lang/rexxutil_file_tests.rex b/rust/corpus/lang/rexxutil_file_tests.rex
new file mode 100644
index 000000000..a61287754
--- /dev/null
+++ b/rust/corpus/lang/rexxutil_file_tests.rex
@@ -0,0 +1,101 @@
+/* SysFileExists, SysIsFile, SysIsFileDirectory and SysIsFileLink over names
+   with a blank, with bytes that are not UTF-8 and with a NUL, a trailing
+   slash, a link to a directory, a dangling link, a directory that cannot be
+   read or searched, and the home-directory forms. Then the same
+   qualification in QUALIFY, .File, .Stream, the stream builtins and
+   DIRECTORY, and the argument errors. Everything is made under a directory this program makes
+   and removes. */
+d = 'filetests.d'
+call SysMkDir d
+call SysMkDir d'/sub'
+call make d'/f.txt'
+call make d'/with blank'
+call make d'/caf' || 'c3a9'x
+call SysFileCopy d'/f.txt', d'/n' || 'ff'x
+'ln -s f.txt' d'/link'
+'ln -s sub' d'/dirlink'
+'ln -s nowhere' d'/dangling'
+call SysMkDir d'/closed'
+call make d'/closed/in.txt'
+'chmod 000' d'/closed'
+names = d d'/' d'/sub' d'/sub/' d'/f.txt' d'/f.txt/' d'/none' d'/link' d'/link/' ,
+  d'/dirlink' d'/dirlink/' d'/dangling' d'/closed' d'/closed/in.txt' . '..' '/' ''
+do i = 1 to words(names)
+  call row word(names, i)
+end
+call row d'/with blank'
+call row d'/caf' || 'c3a9'x
+call row d'/n' || 'ff'x
+call row d'/n' || 'efbfbd'x
+call row d'/f.txt' || '00'x || 'more'
+call row d'/none' || '00'x || '/f.txt'
+call row d'/./sub/../f.txt'
+call row d'//f.txt'
+call row '~'
+call row '~/'
+call row '~root'
+call row '~nosuchuser.rexxutil'
+call row '~nosuchuser.rexxutil/x'
+say 'qualify' quiet(qualify('~')) qualify('~root/a/../b') '['qualify('~nosuchuser.rexxutil/a')']' '['qualify('')']'
+say 'nul    ' (qualify(d'/f.txt' || '00'x || 'x') == qualify(d'/f.txt')) '['qualify('00'x || 'x')']' ,
+  (.File~new(d'/f.txt' || '00'x || 'x')~absolutePath == qualify(d'/f.txt'))
+say 'file   ' quiet(.File~new('~')~absolutePath) .File~new('~root/x')~absolutePath ,
+  '['.File~new('~nosuchuser.rexxutil/a')~absolutePath']' '['.File~new('')~absolutePath']'
+say 'home   ' (qualify('~') == value('HOME', , 'ENVIRONMENT'))
+-- with HOME moved into this program's directory, a tilde name reaches the
+-- same file through the routines, QUALIFY, .File, .Stream, the stream
+-- builtins and DIRECTORY
+here = directory()
+home = value('HOME', qualify(d), 'ENVIRONMENT')
+call lineout '~/home.txt', 'via tilde'
+call lineout '~/home.txt'
+say 'tilde  ' SysFileExists(d'/home.txt') SysIsFile('~/home.txt') linein('~/home.txt') ,
+  (stream('~/home.txt', 'c', 'query exists') == qualify(d'/home.txt')) ,
+  (.Stream~new('~/home.txt')~qualify == qualify(d'/home.txt')) ,
+  (.File~new('~/home.txt')~absolutePath == qualify(d'/home.txt'))
+call stream '~/home.txt', 'c', 'close'
+moved = qualify(d)
+say 'chdir  ' (directory('~') == moved) '['directory('~nosuchuser.rexxutil')']' ,
+  (directory(here || '00'x || 'more') == here)
+call value 'HOME', home, 'ENVIRONMENT'
+call t "call SysFileExists .nil"
+call t "call SysIsFile .nil"
+call t "call SysIsFileDirectory .nil"
+call t "call SysIsFileLink .nil"
+call t "call SysIsFileDirectory"
+call t "call SysIsFileLink"
+call t "call SysIsFileDirectory 'a', 'b'"
+call t "call SysIsFileLink 'a', 'b'"
+call t "say SysFileExists(.stem~new('S.'))"
+'chmod 700' d'/closed'
+'rm -rf' d
+say SysIsFileLink(.nil)
+exit
+
+row: procedure
+  parse arg name
+  say left('['translate(name, '?', '00'x)']', 34) SysFileExists(name) SysIsFile(name) ,
+    SysIsFileDirectory(name) SysIsFileLink(name)
+  return
+
+-- the home directory differs between machines, so only its shape is shown
+quiet: procedure
+  parse arg path
+  return '<'left(path, 1)'..>'
+
+make: procedure
+  parse arg name
+  call lineout name, 'x'
+  call lineout name
+  return
+
+t: procedure
+  parse arg code
+  signal on syntax name bad
+  interpret code
+  say 'ok   ' code
+  return
+bad:
+  c = condition('O')
+  say 'error' code '|' c~code c~message
+  return
diff --git a/rust/corpus/lang/rexxutil_search_path.rex b/rust/corpus/lang/rexxutil_search_path.rex
new file mode 100644
index 000000000..7c4cf6f89
--- /dev/null
+++ b/rust/corpus/lang/rexxutil_search_path.rex
@@ -0,0 +1,102 @@
+/* SysSearchPath: the current directory first or not, empty entries, an
+   entry with a trailing slash, a relative entry, a home-directory entry, a
+   directory found first ending the search, names that carry their own
+   directory, names with a blank and bytes that are not UTF-8, an unset
+   variable, a directory that cannot be searched, a NUL in either name, and
+   the argument errors. Answers are shown relative to the current directory.
+   Everything is made under a directory this program makes and removes. */
+d = 'searchpath.d'
+call SysMkDir d
+call SysMkDir d'/p1'
+call SysMkDir d'/p2'
+call SysMkDir d'/p2/f.dir'
+call make d'/p1/f.dir'
+call make d'/p1/g'
+call make d'/p2/g'
+call make d'/p1/only1'
+call make d'/p2/with blank'
+call SysFileCopy d'/p1/g', d'/p2/n' || 'ff'x
+call make 'top'
+call SysMkDir d'/closed'
+call make d'/closed/g'
+'chmod 000' d'/closed'
+call set d'/p2::'d'/p1'
+call s 'SP', 'g'
+call s 'SP', 'only1'
+call s 'SP', 'f.dir'
+call s 'SP', 'top'
+call s 'SP', 'top', 'N'
+call s 'SP', 'top', 'c'
+call s 'SP', 'top', 'Nothing'
+call s 'SP', 'with blank', 'N'
+call s 'SP', 'n' || 'ff'x, 'N'
+call s 'SP', 'n' || 'efbfbd'x, 'N'
+call s 'SP', ''
+call s 'SP', './top', 'N'
+call s 'SP', '../'filespec('name', directory())'/top', 'N'
+call s 'SP', d'/p1/g', 'N'
+call s 'SP', directory()'/'d'/p1/g', 'N'
+call s 'SP', directory()'/'d'/p1', 'N'
+call s 'SP', 'p1/g', 'N'
+call s 'SP', 'g' || '00'x || 'zz', 'N'
+call s 'SP' || '00'x || 'Q', 'g', 'N'
+call s 'NOSUCHVAR.REXXUTIL', 'top'
+call s 'NOSUCHVAR.REXXUTIL', 'top', 'N'
+call s 'sp', 'g', 'N'
+call set d
+call s 'SP', 'p1/g', 'N'
+call s 'SP', 'p1', 'N'
+call set d'/p1/g/:'d'/p1/'
+call s 'SP', 'g', 'N'
+call set '~/nosuchdir.rexxutil:'d'/p2'
+call s 'SP', 'g', 'N'
+call set '~nosuchuser.rexxutil:'d'/p2'
+call s 'SP', 'g', 'N'
+call set d'/closed:'d'/p2'
+call s 'SP', 'g', 'N'
+call set ''
+call s 'SP', 'top'
+call s 'SP', 'top', 'N'
+call set ':::'
+call s 'SP', 'top', 'N'
+call t "call SysSearchPath"
+call t "call SysSearchPath 'SP'"
+call t "call SysSearchPath .nil, 'x'"
+call t "call SysSearchPath 'SP', .nil"
+call t "call SysSearchPath 'SP', 'x', .nil"
+call t "call SysSearchPath 'SP', 'x', ''"
+call t "call SysSearchPath 'SP', 'x', 'q'"
+call t "call SysSearchPath 'SP', 'x', 'C', 'd'"
+'chmod 700' d'/closed'
+'rm -rf' d 'top'
+call SysSearchPath 'SP', 'x', 'Z'
+exit
+
+set: procedure
+  call value 'SP', arg(1), 'ENVIRONMENT'
+  return
+
+s: procedure
+  if arg(3, 'e') then r = SysSearchPath(arg(1), arg(2), arg(3))
+  else r = SysSearchPath(arg(1), arg(2))
+  shown = changestr(filespec('name', directory()), changestr(directory(), arg(2), '<cwd>'), '<here>')
+  say left(translate(arg(1)'|'shown'|'arg(3), '?', '00'x), 40) ,
+    '['changestr(directory()'/', r, '')']'
+  return
+
+make: procedure
+  parse arg name
+  call lineout name, 'x'
+  call lineout name
+  return
+
+t: procedure
+  parse arg code
+  signal on syntax name bad
+  interpret code
+  say 'ok   ' code
+  return
+bad:
+  c = condition('O')
+  say 'error' code '|' c~code c~message
+  return
diff --git a/rust/corpus/lang/rexxutil_temp_file_name.rex b/rust/corpus/lang/rexxutil_temp_file_name.rex
new file mode 100644
index 000000000..9c6a8e12e
--- /dev/null
+++ b/rust/corpus/lang/rexxutil_temp_file_name.rex
@@ -0,0 +1,99 @@
+/* SysTempFileName. Its digits are random, so each answer is shown by its
+   properties: how it differs from the qualified template, where only filler
+   places may differ and only by holding digits, and whether it names
+   nothing. Fillers counted, an exhausted template, a filler that is a
+   letter of the template, the home-directory forms, a directory that cannot
+   be searched, bytes that are not UTF-8 and a NUL, and the argument
+   errors. Everything is made under a directory this program makes and
+   removes. */
+d = 'tempname.d'
+call SysMkDir d
+call p d'/t???.x'
+call p d'/t???.x', '?'
+call p d'/x?', 'x'
+call p d'/a.?/b.?'
+call p d'/../'d'/./u??'
+call p d'/v?/'
+call p 'rel??'
+call p '?????????'
+call p '~/rexxutil-temp-??????'
+call p d'/blank ??'
+call p d'/n' || 'ff'x || '??'
+call p d'/c' || '00'x || '??'
+call p d'/q??' || '00'x || '??'
+call p d'/q' || 'ff'x || '?', 'ff'x
+call SysMkDir d'/closed'
+'chmod 000' d'/closed'
+call p d'/closed/c?'
+'chmod 700' d'/closed'
+-- no filler, more than nine, and every name taken
+call e ''
+call e '', '?'
+call e 'file'
+call e '?', '*'
+call e '***', '.'
+call e 'file??', '-'
+call e '??????????'
+call e '?????file?????'
+call e '~nosuchuser.rexxutil/f?'
+do i = 0 to 9
+  call SysFileCopy d'/../'d'/none', d'/e'i
+  call SysMkDir d'/e'i
+end
+call e d'/e?'
+call SysRmDir d'/e4'
+say 'one left  ' (SysTempFileName(d'/e?') == qualify(d'/e4'))
+call SysMkDir d'/e4'
+call e d'/e?'
+call t "call SysTempFileName"
+call t "call SysTempFileName 'a?', 'xy'"
+call t "call SysTempFileName 'a?', ''"
+call t "call SysTempFileName 'a?', '00'x"
+call t "call SysTempFileName 'a?', 'x' || '00'x || 'y'"
+call t "call SysTempFileName .nil"
+call t "call SysTempFileName 'a?', .nil"
+call t "call SysTempFileName 'a?', '?', 'x'"
+call t "r = SysTempFileName(''); say 'returned [' || r || ']'"
+'rm -rf' d
+call SysTempFileName d'/x', '--'
+exit
+
+-- the answer's properties: its length beyond the qualified template's, the
+-- number of places where they differ, which must be filler places that now
+-- hold digits, and whether the answer names anything
+p: procedure
+  parse arg template, filler
+  if arg(2, 'e') then name = SysTempFileName(template, filler)
+  else do
+    name = SysTempFileName(template)
+    filler = '?'
+  end
+  if name == '' then do
+    say left(translate(template, '?', '00'x), 28) '[]'
+    return
+  end
+  q = qualify(template)
+  changed = 0
+  do i = 1 to min(q~length, name~length)
+    if q~subchar(i) == name~subchar(i) then iterate
+    if q~subchar(i) \== filler | \datatype(name~subchar(i), 'W') then changed = changed + 1000
+    changed = changed + 1
+  end
+  say left(translate(template, '?', '00'x), 28) name~length - q~length changed SysFileExists(name)
+  return
+
+e: procedure
+  if arg(2, 'e') then say 'empty     ' '['SysTempFileName(arg(1), arg(2))']'
+  else say 'empty     ' '['SysTempFileName(arg(1))']'
+  return
+
+t: procedure
+  parse arg code
+  signal on syntax name bad
+  interpret code
+  say 'ok   ' code
+  return
+bad:
+  c = condition('O')
+  say 'error' translate(code, '?', '00'x) '|' c~code translate(c~message, '?', '00'x)
+  return
diff --git a/rust/corpus/oracle-crashes.txt b/rust/corpus/oracle-crashes.txt
index 97f8fcfb3..41b371599 100644
--- a/rust/corpus/oracle-crashes.txt
+++ b/rust/corpus/oracle-crashes.txt
@@ -17,20 +17,24 @@
 # hazard (unbounded allocation, OOM-killed), which is not a crash in that
 # sense; or an INDEFINITE BLOCK -- the process alive and healthy, consuming no
 # CPU, parked on a wait that nothing in the program can ever satisfy. Each
 # entry below says which it is.
 #
 # The third mode was added on 2026-08-23 for entry 7 and needs the wrapper
 # above to grow a deadline: a block produces no bytes and no status of its
 # own, so it is the one mode whose entry can only be characterised by killing
 # it. Every such entry states the deadline it was killed at, and rc 137 there
 # is the kill and not the oracle's answer.
+#
+# A fourth mode, an UNDEFINED ANSWER, was added on 2026-10-13 for entry 39:
+# a value the oracle reads from memory it never set, different from run to
+# run.
 
 ## 1. `select; when 1 = 0 then; when 2 = 2 then nop; end`
 
     select
       when 1 = 0 then
       when 2 = 2 then nop
     end
 
 Effect: SIGSEGV, rc 139, deterministic.
 
@@ -1354,10 +1358,27 @@ the witness's own last clause. This crate raises each of the three as the trappe
     ::method string
       raise syntax 93.900 array('boom')
 
 SIGSEGV, rc 139, 3 runs of 3 under the standard wrapper and `memcap 4G`, measured 2026-10-13 by
 Phase 9b Task 3's fix round: stdout `Name=A, Value='first'`, nothing from the interpreter on
 stderr. The `SIGNAL ON SYNTAX` does not save it. Found by Task 3's review. Cause not read: the
 raise comes out of `ObjectToString` inside `writeVariable` (`runtime/RexxUtilCommon.cpp:1449`).
 This crate traps the 93.900 and prints `trapped 93.900`, pinned by
 `builtin::rexxutil::stems::tests::a_string_method_raising_inside_the_dump_is_trapped`. No
 upstream ticket.
+
+## 39. `SysFileMove` across file systems
+
+    call lineout 'xfs.txt', 'x'
+    call lineout 'xfs.txt'
+    away = SysTempFileName('/tmp/rexxutil-xfs-?????')
+    say SysFileMove('xfs.txt', away) SysFileExists('xfs.txt') SysFileExists(away)
+
+Not a crash: an UNDEFINED ANSWER, a fourth mode. Run from a directory on another file system than
+`/tmp`, 3 runs under the standard wrapper and `memcap 4G`, measured 2026-10-13 by Phase 9b Task 4:
+stdout `32617 1 0`, `32685 1 0`, `32756 1 0`, nothing moved and rc 0. The oracle's
+`temporaryFilename` (`platform/unix/SysFileSystem.cpp` at the oracle's `cb9563364`) returns
+without setting `errInfo` on success, so `moveFile` answers whatever the stack held. It also
+formats the spare name into a 7-byte `snprintf` bound. This checkout's `interpreter/` has both
+fixed, and this crate follows it: the move copies and unlinks, answering 0, pinned by
+`builtin::rexxutil::files::tests::a_move_across_file_systems_copies_and_unlinks`. No corpus
+witness can run it.
