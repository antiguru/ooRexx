+/// A fresh empty directory at `path`.
+fn fresh(path: PathBuf) -> PathBuf {
+    let _ = fs::remove_dir_all(&path);
+    fs::create_dir_all(&path).unwrap_or_else(|e| panic!("cannot create {}: {e}", path.display()));
