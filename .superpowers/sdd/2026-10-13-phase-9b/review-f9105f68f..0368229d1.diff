 PINGPONG="pingguard pingmsg pingsem"
@@ -107,40 +113,55 @@ for p in $PROGRAMS; do
             if [ "$(cat "$out/$p.$name.r$r.rc")" != 0 ]; then
                 echo "$p $name r$r exited $(cat "$out/$p.$name.r$r.rc")" >&2; status=1
             fi
