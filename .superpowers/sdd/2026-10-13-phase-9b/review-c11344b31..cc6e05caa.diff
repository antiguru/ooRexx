+pub(crate) fn expand_tilde(interp: &Interp, name: &[u8]) -> Option<Vec<u8>> {
     let rest = &name[1..];
     if rest.is_empty() || rest[0] == b'/' {
         let mut out = interp.env_get(b"HOME").unwrap_or_default().to_vec();
