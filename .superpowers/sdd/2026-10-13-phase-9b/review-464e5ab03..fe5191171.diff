diff --git a/rust/crates/rexx-exec/Cargo.toml b/rust/crates/rexx-exec/Cargo.toml
index 4c90beca8..8289527e8 100644
--- a/rust/crates/rexx-exec/Cargo.toml
+++ b/rust/crates/rexx-exec/Cargo.toml
@@ -55,24 +55,25 @@ rexx-lib = { path = "../rexx-lib" }
 # RUSTSEC-2020-0071) and `wasmbind`. What is left compiles four crates on
 # this target -- chrono, num-traits, iana-time-zone and the autocfg build
 # helper -- and chrono's own unix path carries no `unsafe` and no libc call:
 # it parses TZif out of `/etc/localtime` itself.
 chrono = { version = "0.4.45", default-features = false, features = ["clock", "std"] }
 # The system calls `std` does not expose: `access(2)`, which answers for the
 # caller's own credentials where a mode bit does not; `utimensat` with
 # `UTIME_OMIT`, which sets one file stamp and leaves the other, and which
 # `std`'s own `File::set_times` cannot stand in for because it needs a
 # writable open handle where a read-only file's stamp is still the owner's to
-# set; and `uname`, for `SysVersion`. `event` and `time` are the timer
-# thread's `poll` and Linux `timerfd`. Each feature is a leaf here --
-# they gate their modules and pull no further crate.
-rustix = { version = "1.1.4", features = ["event", "fs", "param", "process", "system", "time"] }
+# set; `uname`, for `SysVersion`; and `tcsetattr`, for `SysGetKey`'s
+# terminal mode. `event` and `time` are the timer thread's `poll` and Linux
+# `timerfd`. Each feature is a leaf here -- they gate their modules and pull
+# no further crate.
+rustix = { version = "1.1.4", features = ["event", "fs", "param", "process", "system", "termios", "time"] }
 # `sigaction` and the async-signal-safe `write` the signal module needs
 # (D-U3, `src/signal.rs`). Already in the graph through `std`'s users.
 libc = "0.2.186"
 # The zone `SysGetFileDateTime` and `SysSetFileDateTime` convert through: the
 # program's own `TZ` resolved as glibc resolves it, and each local time
 # type's `is_dst`, which glibc's `mktime` uses to place a skipped reading and
 # chrono does not expose. `#![forbid(unsafe_code)]`, no dependencies.
 tz-rs = "0.7.3"
 
 [features]
@@ -98,12 +99,15 @@ rexx-extract = { path = "../rexx-extract" }
 # dependency set is unchanged. Each use is a `par_iter().map().collect()` that
 # precomputes one pure function into an index-ordered `Vec`, leaving the serial
