diff --git a/rust/corpus/lang/rexxutil_process.rex b/rust/corpus/lang/rexxutil_process.rex
new file mode 100644
index 000000000..d311ac7db
--- /dev/null
+++ b/rust/corpus/lang/rexxutil_process.rex
@@ -0,0 +1,143 @@
+/* SysUtilVersion, SysLoadFuncs, SysDropFuncs, SysQueryProcess,
+   SysSetPriority, SysCls, SysGetKey and SysCreatePipe. Process numbers,
+   times and descriptors differ from run to run, so each is shown by how it
+   relates to /proc. A command sends a line through a pipe by the inherited
+   descriptors, from two activities at once. */
+say '-- version and the no-ops'
+say SysUtilVersion() (SysUtilVersion() == .RexxInfo~version)
+say SysLoadFuncs() SysDropFuncs()
+call SysLoadFuncs
+say result
+call t "SysUtilVersion(1)"
+call t "SysLoadFuncs('x')"
+call t "SysDropFuncs(, )"
+call t "SysCls(1)"
+call t "SysWait(1)"
+call t "SysFork(1)"
+
+say '-- SysQueryProcess'
+stat = statFields('/proc/self/stat')
+say 'pid' (SysQueryProcess() = stat~pid) (SysQueryProcess('pid') = stat~pid) (SysQueryProcess('Pid'||'00'x||'x') = stat~pid)
+say 'ppid' (SysQueryProcess('PPID') = stat~ppid)
+parent = statFields('/proc/'stat~ppid'/stat')
+say 'pgid of the parent' (SysQueryProcess('pgid') = parent~group)
+say 'pprio' (SysQueryProcess('PPRIO') = statFields('/proc/thread-self/stat')~nice)
+say translate(SysQueryProcess('PTIME'), '9999999999', '0123456789')
+parse value SysQueryProcess('pmem') with label size
+say label datatype(size, 'W') (size > 0)
+say SysQueryProcess('PSWAPS')
+say SysQueryProcess('prcvdsig')
+call t "SysQueryProcess('bogus')"
+call t "SysQueryProcess('')"
+call t "SysQueryProcess('PID', 1)"
+call t "SysQueryProcess(.array~new)"
+
+say '-- SysSetPriority'
+nice = SysQueryProcess('PPRIO')
+if nice < 19 then do
+  say SysSetPriority(0, -(nice + 1)) (SysQueryProcess('PPRIO') - nice)
+  say 'thread' (statFields('/proc/thread-self/stat')~nice - nice)
+  say SysSetPriority(, -(nice + 1)) (SysQueryProcess('PPRIO') - nice)
+end
+say SysSetPriority(, -30) SysQueryProcess('PPRIO')
+call t "SysSetPriority()"
+call t "SysSetPriority(1)"
+call t "SysSetPriority('a')"
+call t "SysSetPriority('a', 0)"
+call t "SysSetPriority(, 'a')"
+call t "SysSetPriority(, 1.5)"
+call t "SysSetPriority(, 2147483648)"
+call t "SysSetPriority(1, 2, 3)"
+
+say '-- SysCls'
+call value 'TERM', 'xterm', 'ENVIRONMENT'
+say 'before'
+r = SysCls()
+say 'after' r
+call value 'TERM', 'dumb', 'ENVIRONMENT'
+say 'dumb' SysCls()
+call value 'TERM', 'nosuchterm', 'ENVIRONMENT'
+say 'unknown' SysCls()
+path = value('PATH', , 'ENVIRONMENT')
+call value 'PATH', '/nonexistent', 'ENVIRONMENT'
+say 'no clear' SysCls()
+call value 'PATH', path, 'ENVIRONMENT'
+
+say '-- SysGetKey, standard input not a terminal'
+say '['SysGetKey()']' '['SysGetKey('noecho')']' '['SysGetKey('ECHO')']' '['SysGetKey(,)']'
+call t "SysGetKey('bogus')"
+call t "SysGetKey('')"
+call t "SysGetKey('echo', 1)"
+
+say '-- SysCreatePipe'
+call pipe SysCreatePipe(), 'default'
+call pipe SysCreatePipe('b'), 'b'
+call pipe SysCreatePipe('Blocking'), 'Blocking'
+call pipe SysCreatePipe('n'), 'n'
+call pipe SysCreatePipe('Nonblocking'||'00'x||'x'), 'Nonblocking'
+call t "SysCreatePipe('')"
+call t "SysCreatePipe('x')"
+call t "SysCreatePipe('00'x||'n')"
+call t "SysCreatePipe('b', 1)"
+
+say '-- two activities at once'
+a = .sender~new~start('send', 'first')
+b = .sender~new~start('send', 'second')
+say a~result
+say b~result
+
+say '-- an untrapped error'
+say SysQueryProcess('PTIMES')
+exit
+
+t:
+  parse arg expr
+  signal on syntax name trap
+  interpret 'r = ' expr
+  say expr '->' r
+  return
+trap:
+  say expr '->' condition('O')~code condition('O')~message
+  return
+
+/* A process's /proc stat line as a directory of the fields this program
+   compares: proc(5) fields 1, 4, 5 and 19. */
+statFields: procedure
+  parse arg name
+  line = linein(name)
+  call stream name, 'c', 'close'
+  after = substr(line, lastpos(')', line) + 1)
+  fields = .directory~new
+  fields~pid = word(line, 1)
+  fields~ppid = word(after, 2)
+  fields~group = word(after, 3)
+  fields~nice = word(after, 17)
+  return fields
+
+/* The flags line of a descriptor's /proc fdinfo. */
+fdFlags: procedure
+  parse arg fd
+  name = '/proc/self/fdinfo/'fd
+  flags = '?'
+  do 10
+    parse value linein(name) with key ':' found
+    if key == 'flags' then flags = strip(found)
+  end
+  call stream name, 'c', 'close'
+  return flags
+
+/* A pipe's two descriptors and their flags. */
+pipe: procedure
+  parse arg ends, label
+  parse var ends reading writing extra
+  say label words(ends) datatype(reading, 'W') datatype(writing, 'W') (reading <> writing)
+  say label 'flags' fdFlags(reading) fdFlags(writing)
+  return
+
+::class sender
+::method send
+  use arg text
+  parse value SysCreatePipe() with reading writing
+  command = 'printf "%s\n" "'text' through a pipe" > /proc/self/fd/'writing'; head -n 1 /proc/self/fd/'reading
+  address system command with output stem out.
+  return rc out.0 out.1
diff --git a/rust/corpus/oracle-crashes.txt b/rust/corpus/oracle-crashes.txt
index 6b979602f..daf4fcab2 100644
--- a/rust/corpus/oracle-crashes.txt
+++ b/rust/corpus/oracle-crashes.txt
@@ -1462,10 +1462,61 @@ ticket.
     'cd ~'
     say rc
 
 Run with `HOME` removed from the environment (`env -u HOME`): SIGSEGV, rc 139, 3 runs of 3 under
 the standard wrapper and `memcap 4G`, nothing on stdout, measured 2026-10-13 by Phase 9b Task 6.
 `sys_process_cd` (`platform/unix/SystemCommands.cpp:494`) hands a bare `cd` and `cd ~/x` to the
 shell where `getenv("HOME")` is null, but for `cd ~` and `cd ~ x` it runs `strlen` on it. This
 crate hands those to the shell too, and the shell's answer is the command's, the directory
 unchanged, pinned by `command::tests::cd_home_with_home_unset_goes_to_the_shell`. No upstream
 ticket.
+
+## 45. `SysWait` with no child to wait for
+
+    say SysWait()
+
+Not a crash: an UNDEFINED ANSWER. 3 runs under the standard wrapper and `memcap 4G`, measured
+2026-10-13 by Phase 9b Task 7: stdout `32582`, `32589`, `32624`, rc 0, and a second call in the
+same run answers the same value as the first. `SysWait` (`platform/unix/SysRexxUtil.cpp`) answers
+the status `wait` would have set, and `wait` fails with `ECHILD` and sets nothing. This checkout's
+`interpreter/` is the same. A command whose child a `SysWait` on another activity reaped is the
+same defect one step on: `ioCommandHandler` (`platform/unix/SystemCommands.cpp`) reads the status
+of its own failed `waitpid`. With `'exit 3'` then `'sleep 0.6; exit 5'` run on a started activity
+and `SysWait` after `SysSleep 0.2` on the main one, 3 runs printed the wait's answer and the
+command's `rc` as `1280` and `3` twice, then `32631` and `5`
+(`docs/superpowers/records/2026-10-13-phase-9b/task-7/probe-runs.txt`). This crate answers `-1` for a wait that finds no
+child or fails, pinned by `tests/rexxutil_process.rs`, and a command whose child was reaped elsewhere
+answers `127` with a `FAILURE`. No upstream ticket.
+
+## 46. `SysFork` with a second activity running
+
+    t = .worker~new
+    t~start('spin')
+    call SysSleep 0.2
+    pid = SysFork()
+    if pid = 0 then do
+      say 'child: alive'
+      exit 3
+    end
+    say 'parent: wait status' SysWait()
+    t~stop = 1
+    exit
+    ::class worker
+    ::attribute stop
+    ::method init
+      expose stop; stop = 0
+    ::method spin
+      expose stop
+      n = 0
+      do until stop
+        n = n + 1
+        if n // 1000 = 0 then call SysSleep 0.001
+      end
+
+An INDEFINITE BLOCK, and one that outlives its wrapper: the forked child holds no thread but the
+forking one and never ends, so the parent's `SysWait` waits for ever. 5 runs under the standard
+wrapper with `timeout -k 5 20` and `memcap 4G`, measured 2026-10-13 by Phase 9b Task 7: each
+killed at the deadline, rc 124; the child printed `child: alive` in 3 of the 5 and nothing in the
+other 2, and every child was still running after its parent was killed, to be killed by hand.
+`SysFork` with no other activity works: 3 runs of 3 printed the child's line and a wait status of
+`768` for its `exit 3`, rc 0. This crate refuses `SysFork`, whose `fork` is an `unsafe` call it
+holds no grant for. No upstream ticket.
