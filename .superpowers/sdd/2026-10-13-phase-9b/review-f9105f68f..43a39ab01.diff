++            None => compare_whole(left, right, self.caseless),
++            Some((start, length)) => compare_columns(left, right, start, length, self.caseless),
++        };
++        let sign = match ordering {
++            Ordering::Less => -1,
++            Ordering::Equal => 0,
++            Ordering::Greater => 1,
