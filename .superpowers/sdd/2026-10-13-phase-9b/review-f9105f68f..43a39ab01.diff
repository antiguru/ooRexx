++    args: &[Option<ObjRef>],
++) -> Result<ObjRef, Failure> {
++    let set = positive(interp, args, 1)?;
++    let number = positive(interp, args, 2)?;
++    let catalog = optional_text(interp, args, 3)?;
++    let message = error_message(
