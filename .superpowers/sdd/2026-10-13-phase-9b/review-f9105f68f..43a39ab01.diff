diff --git a/docs/superpowers/records/2026-10-13-phase-9b/task-5/probes/sweep.rex b/docs/superpowers/records/2026-10-13-phase-9b/task-5/probes/sweep.rex
new file mode 100644
index 000000000..65c7a649b
--- /dev/null
+++ b/docs/superpowers/records/2026-10-13-phase-9b/task-5/probes/sweep.rex
@@ -0,0 +1,20 @@
+parse arg file
+call SysMkDir 'n'
+do name over 'a', 'b', 'c', 'A', 'z', 'Z', '-', ']', '^', '!', '[', '=', ':', '\', 'x.y', 'ab', 'a]', 'c]', '[a', 'A]'
+  call charout 'n/'name, ''
+  call charout 'n/'name
+end
+call directory 'n'
+do while lines(file) > 0
+  p = linein(file)
+  do o over 'o', 'oi'
+    drop f.
+    call SysFileTree p, f., o
+    a = .array~new
+    do j = 1 to f.0; a~append(filespec('n', f.j)); end
+    a~sort
+    say p '|' o '|' a~toString('l', ' ')
+  end
+end
+call directory '..'
+'rm -rf n'
