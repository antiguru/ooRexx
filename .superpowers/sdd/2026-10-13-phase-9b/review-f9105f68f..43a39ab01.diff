+/// file system is taken to be case-sensitive.
+fn same_paths(first: &[u8], second: &[u8]) -> bool {
+    let Ok(first) = std::fs::canonicalize(os_path(first)) else {
+        return false;
+    };
+    std::fs::canonicalize(os_path(second)).is_ok_and(|second| first == second)
