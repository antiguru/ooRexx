diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/rexxutil_temp_file_name.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/rexxutil_temp_file_name.txt
new file mode 100644
index 000000000..b4aeae661
--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/rexxutil_temp_file_name.txt
@@ -0,0 +1,100 @@
+count 99
+/* SysTempFileName. Its digits are random, so each answer is shown by its
+   properties: how it differs from the qualified template, where only filler
+   places may differ and only by holding digits, and whether it names
+   nothing. Fillers counted, an exhausted template, a filler that is a
+   letter of the template, the home-directory forms, a directory that cannot
+   be searched, bytes that are not UTF-8 and a NUL, and the argument
+   errors. Everything is made under a directory this program makes and
+   removes. */
+d = 'tempname.d'
+call SysMkDir d
+call p d'/t???.x'
+call p d'/t???.x', '?'
+call p d'/x?', 'x'
+call p d'/a.?/b.?'
+call p d'/../'d'/./u??'
+call p d'/v?/'
+call p 'rel??'
+call p '?????????'
+call p '~/rexxutil-temp-??????'
+call p d'/blank ??'
+call p d'/n' || 'ff'x || '??'
+call p d'/c' || '00'x || '??'
+call p d'/q??' || '00'x || '??'
+call p d'/q' || 'ff'x || '?', 'ff'x
+call SysMkDir d'/closed'
+'chmod 000' d'/closed'
+call p d'/closed/c?'
+'chmod 700' d'/closed'
+-- no filler, more than nine, and every name taken
+call e ''
+call e '', '?'
+call e 'file'
+call e '?', '*'
+call e '***', '.'
+call e 'file??', '-'
+call e '??????????'
+call e '?????file?????'
+call e '~nosuchuser.rexxutil/f?'
+do i = 0 to 9
+  call SysFileCopy d'/../'d'/none', d'/e'i
+  call SysMkDir d'/e'i
+end
+call e d'/e?'
+call SysRmDir d'/e4'
+say 'one left  ' (SysTempFileName(d'/e?') == qualify(d'/e4'))
+call SysMkDir d'/e4'
+call e d'/e?'
+call t "call SysTempFileName"
+call t "call SysTempFileName 'a?', 'xy'"
+call t "call SysTempFileName 'a?', ''"
+call t "call SysTempFileName 'a?', '00'x"
+call t "call SysTempFileName 'a?', 'x' || '00'x || 'y'"
+call t "call SysTempFileName .nil"
+call t "call SysTempFileName 'a?', .nil"
+call t "call SysTempFileName 'a?', '?', 'x'"
+call t "r = SysTempFileName(''); say 'returned [' || r || ']'"
+'rm -rf' d
+call SysTempFileName d'/x', '--'
+exit
+
+-- the answer's properties: its length beyond the qualified template's, the
+-- number of places where they differ, which must be filler places that now
+-- hold digits, and whether the answer names anything
+p: procedure
+  parse arg template, filler
+  if arg(2, 'e') then name = SysTempFileName(template, filler)
+  else do
+    name = SysTempFileName(template)
+    filler = '?'
+  end
+  if name == '' then do
+    say left(translate(template, '?', '00'x), 28) '[]'
+    return
+  end
+  q = qualify(template)
+  changed = 0
+  do i = 1 to min(q~length, name~length)
+    if q~subchar(i) == name~subchar(i) then iterate
+    if q~subchar(i) \== filler | \datatype(name~subchar(i), 'W') then changed = changed + 1000
+    changed = changed + 1
+  end
+  say left(translate(template, '?', '00'x), 28) name~length - q~length changed SysFileExists(name)
+  return
+
+e: procedure
+  if arg(2, 'e') then say 'empty     ' '['SysTempFileName(arg(1), arg(2))']'
+  else say 'empty     ' '['SysTempFileName(arg(1))']'
+  return
+
+t: procedure
+  parse arg code
+  signal on syntax name bad
+  interpret code
+  say 'ok   ' code
+  return
+bad:
+  c = condition('O')
+  say 'error' translate(code, '?', '00'x) '|' c~code translate(c~message, '?', '00'x)
+  return
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/stream_handle_names.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/stream_handle_names.txt
new file mode 100644
index 000000000..45d5babed
--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/stream_handle_names.txt
@@ -0,0 +1,41 @@
+count 40
+/* A HANDLE:n stream: the answers that do not read or write the descriptor,
+   which agree with the oracle. Reads, writes, QUERY HANDLE after an open and
+   a second open are Deviation 35, and nothing here touches them. */
+do name over .array~of('HANDLE:0', 'handle:1', 'HANDLE:2')
+  s = .Stream~new(name)
+  say name 'init' s~state s~description s~string
+  say name 'unopened' '[' || s~query('streamtype') || ']' '[' || s~query('handle') || ']' -
+    '[' || s~query('exists') || ']' (s~qualify == .File~new(name)~absolutePath)
+  say name 'open' s~open('read') s~state s~description
+  say name 'opened' '[' || s~query('exists') || ']' '[' || s~qualify || ']'
+  say name 'close' s~close s~state s~description '[' || s~query('exists') || ']' '[' || s~qualify || ']'
+end
+
+say '-- the descriptor is an int'
+do name over .array~of('HANDLE:01', 'HANDLE: 1', 'HANDLE:+2', 'HANDLE:1.0', 'HANDLE:1e0', -
+    'HANDLE:x', 'HANDLE:', 'HANDLE:1.5', 'HANDLE:2147483648', 'HANDLE:2.0000000000000000001')
+  call try name
+end
+
+say '-- open takes the options a file takes'
+s = .Stream~new('HANDLE:0')
+call badopen s
+exit
+
+try:
+  signal on syntax name refused
+  s = .Stream~new(arg(1))
+  say '[' || arg(1) || '] init' s~state
+  return
+refused:
+  say '[' || arg(1) || ']' condition('o')~code condition('o')~message
+  return
+
+badopen:
+  signal on syntax name badopened
+  say arg(1)~open('zork')
+  return
+badopened:
+  say 'open zork' condition('o')~code
+  return
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/sys_semaphore_names_rejected.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/sys_semaphore_names_rejected.txt
new file mode 100644
index 000000000..813fcac05
--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/sys_semaphore_names_rejected.txt
@@ -0,0 +1,29 @@
+count 28
+/* A semaphore name sem_open rejects creates and opens nothing: nothing left
+   once leading slashes go, a slash after them, or more than 251 bytes after
+   them. A name ends at its first NUL. A create answers the empty string and
+   an open answers zero. An open checks its argument before it counts the
+   arguments. */
+say 'create' (SysCreateEventSem('') == '') (SysCreateEventSem('//') == '') (SysCreateEventSem('a/b') == '')
+say 'create mutex' (SysCreateMutexSem('/') == '') (SysCreateMutexSem('/a/') == '')
+say 'create long' (SysCreateEventSem(copies('r', 252)) == '') (SysCreateMutexSem('//' || copies('s', 252)) == '')
+say 'open' SysOpenEventSem('') SysOpenEventSem('//') SysOpenEventSem('a/b')
+say 'open mutex' SysOpenMutexSem('/') SysOpenMutexSem('/a/')
+say 'open long' SysOpenEventSem(copies('q', 252)) SysOpenMutexSem('/' || copies('q', 300))
+say 'open nul' SysOpenEventSem('0'x || 'abc') SysOpenMutexSem('//' || '0'x)
+say 'create nul' (SysCreateEventSem('/' || '0'x || 'abc') == '') (SysCreateMutexSem('//' || '0'x || 'q/r') == '')
+signal on syntax name e1
+say SysOpenEventSem()
+e1: say 'error' condition('o')~code condition('o')~message
+signal on syntax name e2
+say SysOpenMutexSem('a', 'b')
+e2: say 'error' condition('o')~code condition('o')~message
+signal on syntax name e3
+say SysOpenEventSem(.nil)
+e3: say 'error' condition('o')~code condition('o')~message
+signal on syntax name e4
+say SysOpenMutexSem(, 'b')
+e4: say 'error' condition('o')~code condition('o')~message
+signal on syntax name e5
+say SysOpenEventSem(.nil, 'b')
+e5: say 'error' condition('o')~code condition('o')~message
