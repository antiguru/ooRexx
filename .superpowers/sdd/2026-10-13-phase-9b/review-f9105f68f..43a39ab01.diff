++/// `count` bytes of `value` from `start`, a NUL standing for each byte past
++/// its end.
++fn terminated(value: &[u8], start: usize, count: usize) -> impl Iterator<Item = u8> + '_ {
++    (start..start + count).map(|at| value.get(at).copied().unwrap_or(0))
