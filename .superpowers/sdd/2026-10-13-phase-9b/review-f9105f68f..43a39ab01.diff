++const DEFAULT_NLSPATH: &[u8] = b"/usr/share/locale/%L/%N:/usr/share/locale/%L/LC_MESSAGES/%N:\
++/usr/share/locale/%l/%N:/usr/share/locale/%l/LC_MESSAGES/%N:";
