++/// `TreeFinder::recursiveFindFile`: the entries of `directory` whose names
++/// match `pattern`, then, under `S`, every subdirectory's the same way. A
++/// directory that does not open contributes nothing.
++fn search(
++    directory: &[u8],
++    pattern: &[u8],
++    options: TreeOptions,
++    zone: &tz::TimeZone,
++    out: &mut Vec<Vec<u8>>,
++) {
++    for (name, stat) in entries(directory) {
++        if !matches(pattern, &name, options.caseless) {
++            continue;
++        }
++        let mut path = directory.to_vec();
++        path.extend_from_slice(&name);
++        if let Some(line) = entry_line(options, zone, path, &stat) {
++            out.push(line);
++        }
++    }
++    if options.recurse {
++        for (name, stat) in entries(directory) {
++            if FileType::from_raw_mode(stat.st_mode) != FileType::Directory {
++                continue;
++            }
++            let mut path = directory.to_vec();
++            path.extend_from_slice(&name);
++            path.push(b'/');
++            search(&path, pattern, options, zone, out);
++        }
++    }
++}
++
++/// The names in `directory` other than `.` and `..`, each with what `stat`
++/// answers for it, following a symbolic link. Where `stat` fails, a dangling
++/// link among them, it is `lstat`'s answer: the oracle reports whatever its
++/// buffer last held (`corpus/oracle-crashes.txt` entry 40).
++fn entries(directory: &[u8]) -> Vec<(Vec<u8>, Stat)> {
++    use std::os::unix::ffi::OsStrExt as _;
++    let Ok(listing) = std::fs::read_dir(os_path(directory)) else {
++        return Vec::new();
++    };
++    let mut out = Vec::new();
++    for entry in listing.flatten() {
++        let name = entry.file_name().as_bytes().to_vec();
++        let mut path = directory.to_vec();
++        path.extend_from_slice(&name);
++        let stat =
++            rustix::fs::stat(path.as_slice()).or_else(|_| rustix::fs::lstat(path.as_slice()));
++        if let Ok(stat) = stat {
++            out.push((name, stat));
++        }
++    }
++    out
++}
