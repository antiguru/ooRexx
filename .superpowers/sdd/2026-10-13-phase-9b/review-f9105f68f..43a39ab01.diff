++    fn has_word(text: &[u8], name: &str) -> bool {
++        let text = text.to_ascii_lowercase();
++        let name = name.to_ascii_lowercase().into_bytes();
++        let word = |byte: u8| byte.is_ascii_alphanumeric() || byte == b'_';
