+-/// What one `SysFileTree` call is looking for and how it reports what it
+-/// finds, from the option letters.
+-#[derive(Clone, Copy)]
+-struct TreeOptions {
+-    files: bool,
+-    directories: bool,
+-    recurse: bool,
+-    /// `O`: the qualified name alone, with no date, size or attributes.
+-    names_only: bool,
+-    /// `I`: fold case when matching the pattern.
+-    caseless: bool,
+-    stamp: Stamp,
