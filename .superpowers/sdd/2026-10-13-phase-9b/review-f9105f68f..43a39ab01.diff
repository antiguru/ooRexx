++/// Where `formatMessage` reads its substitution values.
++enum Substitutions<'a> {
++    /// The routine's own arguments.
++    Arguments(&'a [Option<ObjRef>]),
++    /// An array, read item by item as each is converted, since a conversion
++    /// can change it.
++    Array(ObjRef),
++}
