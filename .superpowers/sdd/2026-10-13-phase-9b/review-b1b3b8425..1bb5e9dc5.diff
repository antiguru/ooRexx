+call t "SysGetMessage(1, here'/'d'/cut.cat')"
+call write d'/open.cat', left(whole, length(whole) - 1)
+call t "SysGetMessage(1, here'/'d'/open.cat')"
+call t "SysGetMessageX(100, 1, here'/'d'/open.cat')"
