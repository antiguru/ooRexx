+call t "SysGetMessage('x')"
+call t "SysGetMessage(1000000000000000000)"
+call t "SysGetMessage(.seven~new)"
+call t "SysGetMessage(5, .arrayString~new)"
+call t "SysGetMessage()"
+call t "SysGetMessageX(1)"
+call t "SysGetMessageX(0, 5)"
