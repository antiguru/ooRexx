+/// `sem.` prefix and the 255-byte file name limit).
+fn sem_open_rejects(text: &[u8]) -> bool {
+    let rest = &text[text.iter().take_while(|&&byte| byte == b'/').count()..];
+    rest.is_empty() || rest.contains(&b'/') || rest.len() > 251
