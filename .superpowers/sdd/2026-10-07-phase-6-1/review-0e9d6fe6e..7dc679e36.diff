index 000000000..c2c72cb96
--- /dev/null
+++ b/docs/superpowers/records/2026-10-07-phase-6-1/notify-window.rex
@@ -0,0 +1,16 @@
+m = .message~new('abc', 'reverse')
+m~notify(.slow~new)
+m~start
+call SysSleep 0.3
+w = .message~new(.counter~new, 'bump')
+m~notify(w)
+say 'notified' m~completed
+w~wait
+say 'waited'
+exit
+::class slow inherit MessageNotification
+::method messageComplete
+  call SysSleep 1
+::class counter
+::method bump
+  return 1
