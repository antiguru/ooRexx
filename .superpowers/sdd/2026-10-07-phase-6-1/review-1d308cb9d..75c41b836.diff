@@ -0,0 +1,25 @@
+/* USE LOCAL beside EXPOSE: a name USE LOCAL does not list is the same
+   object variable another method exposes. */
+o = .t~new
+o~init2
+say o~m o~v
+say o~m2 o~v o~w
+::class t
+::method init2
+expose v
+v = 1
+::method v
+expose v
+return v
+::method w
+expose w
+return w
+::method m
+use local a
+a = 5
+v = 9
+return a v
+::method m2
+use local
+v = v + 1; w = 'w'
+return v
diff --git a/rust/corpus/lang/use_local_method_guard.rex b/rust/corpus/lang/use_local_method_guard.rex
new file mode 100644
index 000000000..89d3cedbe
--- /dev/null
+++ b/rust/corpus/lang/use_local_method_guard.rex
@@ -0,0 +1,16 @@
+/* GUARD WHEN in a USE LOCAL method reads a name USE LOCAL did not list
+   from the object's pool. */
+o = .t~new
+o~set
+say o~waitit
+::class t
+::method set
+expose flag
+flag = 1
+::method waitit
+use local a
+trace r
+guard on when flag = 1
+a = 'local'
+trace o
+return 'passed' flag a
diff --git a/rust/corpus/lang/use_strict_arg_msg.rex b/rust/corpus/lang/use_strict_arg_msg.rex
new file mode 100644
index 000000000..4f998405f
--- /dev/null
+++ b/rust/corpus/lang/use_strict_arg_msg.rex
@@ -0,0 +1,12 @@
+/* USE STRICT ARG into a message term; an omitted position with no default
+   is still an error. */
+o = .t~new
+call sub 'x'
+say o~a
+call sub2 , 'y'
+exit
+sub: use strict arg o~a; return
+sub2: use strict arg o~a, o~b; return
+::class t
+::attribute a
+::attribute b
