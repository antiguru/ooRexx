+signal on syntax name s1
+lbl: do i = .k~new(1) to 3; say 'x' i; iterate lbl; end
+exit
+s1: say 'trapped' rc condition('O')~message; say sigl
+do i = .k~new(5) to .k~new(1) ; say 'y' i; end
+exit
+nothing: return
+::class k
+::method init; expose v; use arg v
+::method '+'; expose v; if arg() = 0 then return self; use arg o; return .k~new(v + o)
+::method string; expose v; return 'k'v
