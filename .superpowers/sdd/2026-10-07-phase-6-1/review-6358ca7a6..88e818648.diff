+fn draw_points(stream: &mut Rng, count: u64, k: u64) -> Vec<u64> {
+    if count >= k {
+        return (1..=k).collect();
+    }
+    let mut points = Vec::new();
+    while (points.len() as u64) < count {
+        let point = stream.within(1..=k);
+        if !points.contains(&point) {
+            points.push(point);
+        }
+    }
+    points.sort_unstable();
