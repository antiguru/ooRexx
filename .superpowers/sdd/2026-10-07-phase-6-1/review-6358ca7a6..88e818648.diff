+
+impl Replaying {
+    fn new(decisions: &[Decision]) -> Replaying {
+        let mut replaying = Replaying {
+            preempts: Vec::new(),
+            picks: Vec::new(),
+            collects: Vec::new(),
+            next_preempt: 0,
+            next_pick: 0,
+            next_collect: 0,
