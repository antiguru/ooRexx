+/// A replay's place in each kind of decision it reads back.
+struct Replaying {
+    preempts: Vec<u64>,
+    picks: Vec<u64>,
+    collects: Vec<u64>,
+    next_preempt: usize,
+    next_pick: usize,
+    next_collect: usize,
