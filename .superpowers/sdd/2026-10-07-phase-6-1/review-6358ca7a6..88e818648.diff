+fn reached(points: &[u64], next: &mut usize, at: u64) -> bool {
+    while points.get(*next).is_some_and(|point| *point < at) {
+        *next += 1;
+    }
+    if points.get(*next) == Some(&at) {
+        *next += 1;
+        return true;
+    }
+    false
