+                    .iter()
+                    .filter(|row| {
+                        !matches!(row.part.as_str(), "rest" | "single")
+                            && !row.group.starts_with(PROGRAMS)
+                    })
+                    .map(|row| (row.group.clone(), row.part.clone()))
+                    .collect();
