diff --git a/rust/corpus/lang/select_case_object.rex b/rust/corpus/lang/select_case_object.rex
new file mode 100644
index 000000000..33ee7a6de
--- /dev/null
+++ b/rust/corpus/lang/select_case_object.rex
@@ -0,0 +1,26 @@
+/* SELECT CASE sends == to the case value with each WHEN CASE value and
+   judges the answer's truth. */
+trace r
+select case 3
+  when 1, 2+1 then say 'a'
+  otherwise say 'b'
+end
+c = .c~new
+select case c
+  when 'x', 'y' then say 'x'
+  when c then say 'self'
+  otherwise say 'none'
+end
+trace o
+select case .c~new
+  when 'z' then say 'z'
+  otherwise say 'otherwise'
+end
+exit
+::class c
+::method '=='
+  use arg other
+  if other == 'y' then return .s1~new
+  return 0
+::class s1
+::method string; return 1
diff --git a/rust/corpus/lang/truth_user_string.rex b/rust/corpus/lang/truth_user_string.rex
new file mode 100644
index 000000000..aaadb9f07
--- /dev/null
+++ b/rust/corpus/lang/truth_user_string.rex
@@ -0,0 +1,20 @@
+/* A value is judged by its string value: a user object by what its STRING
+   method answers, an array by its items joined. IF, WHEN, WHILE, UNTIL, a
+   comma list, & and | each judge alike. */
+call t .s1~new
+call t .s0~new
+call t .array~of(1)
+call t .array~of(0)
+exit
+t: use arg v
+if v then say 'if T'; else say 'if F'
+select; when v then say 'when T'; otherwise say 'when F'; end
+n = 0; do while v; n = n + 1; leave; end; say 'while' n
+n = 0; do until v; n = n + 1; if n = 2 then leave; end; say 'until' n
+if 1, v then say 'list T'; else say 'list F'
+say 'and' (1 & v) 'or' (0 | v)
+return
+::class s1
+::method string; return 1
+::class s0
+::method string; return 0
