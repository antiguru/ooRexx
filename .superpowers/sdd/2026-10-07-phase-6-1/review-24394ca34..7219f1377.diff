+pub(crate) fn truth_without_conversion(value: ObjRef) -> Option<bool> {
+    if value == LOGICAL_TRUE {
+        return Some(true);
+    }
+    if value == LOGICAL_FALSE {
+        return Some(false);
+    }
+    match value.decode() {
+        Decoded::SmallInt(1) => Some(true),
+        Decoded::SmallInt(0) => Some(false),
