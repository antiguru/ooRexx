+        if let Some(quick) = truth_without_conversion(value) {
+            assert_eq!(Some(quick), judged, "{value:?}");
+            answered += 1;
+        } else {
+            assert_eq!(judged, None, "{value:?}");
+        }
+    }
+    assert_eq!(answered, 4);
