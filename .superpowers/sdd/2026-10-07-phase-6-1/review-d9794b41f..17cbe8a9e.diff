+#[test]
+fn copied_strings_are_collected_on_their_bytes() {
+    assert_collected_on_bytes(
+        b"y = copies('abc', 100000); do i = 1 to 1000; x = y~copy; end\n",
+        300_000,
+        1000,
+    );
