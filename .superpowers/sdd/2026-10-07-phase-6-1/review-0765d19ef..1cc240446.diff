+#[test]
+fn a_config_reads_back_what_it_prints() {
+    for text in [
+        "sim:7,fifo",
+        "sim:18446744073709551615,fifo,gc=0.25,halt@3,fail=wait:2,clock=midnight",
+        "sim:0,fifo,clock=real",
