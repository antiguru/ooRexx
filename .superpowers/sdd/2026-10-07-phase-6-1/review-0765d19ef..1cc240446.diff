+        "sim:1,gc=2",
+        "sim:1,halt@0",
+        "sim:1,fail=wait:",
+        "sim:1,pre:1",
+        "simx",
+    ] {
+        assert!(SimConfig::parse(wrong).is_err(), "{wrong} parsed");
+    }
+}
