+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/routine_new_directive_subclass.txt
@@ -0,0 +1,20 @@
+count 19
+/* A ::CLASS directive in a Routine~new source resolves its SUBCLASS through
+   the installing package and its parent, not through the caller. */
+/* Routine~new source with directives that subclass a parent class */
+signal on syntax name s1
+say 'routine subclass:' .routine~new('r', .array~of('return .kid~new~name', '::class kid subclass hidden'))~call
+s1r:
+signal on syntax name s2
+p1 = .package~new('p1', .array~of('::class other', '::method name', '  return "other"'))
+say 'routine subclass other ctx:' .routine~new('r', .array~of('return .kid~new~name', '::class kid subclass other'), p1)~call
+s2r:
+signal on syntax name s3
+say 'routine subclass hidden via p1:' .routine~new('r', .array~of('return .kid~new~name', '::class kid subclass hidden'), p1)~call
+exit
+s1: say 'routine subclass: error' condition('O')~code; signal s1r
+s2: say 'routine subclass other ctx: error' condition('O')~code; signal s2r
+s3: say 'routine subclass hidden via p1: error' condition('O')~code; exit
+::class hidden
+::method name
+  return 'hidden'
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/routine_new_parent_required.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/routine_new_parent_required.txt
new file mode 100644
index 000000000..5f106c0b3
--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/routine_new_parent_required.txt
@@ -0,0 +1,12 @@
+count 11
+/* A compiled source sees the public classes its parent package got through
+   ::REQUIRES, not the non-public ones; the parent's own classes come first. */
+/* parent's ::requires: public class visible, non-public not; public required vs parent installed */
+say 'reqpub:' .routine~new('r', 'return .rpub~new~name')~call
+say 'reqhidden:' .routine~new('r', 'return .rhid')~call
+say 'dup:' .routine~new('r', 'return .dup~new~name')~call
+say 'own req beats parent?:' .routine~new('r', .array~of('return .dup2~new~name', '::class dup2', '::method name', '  return "own2"'))~call
+::requires 'lib.rex'
+::class dup
+::method name
+  return 'main dup'
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/string_answer_nil_consumers.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/string_answer_nil_consumers.txt
new file mode 100644
index 000000000..3af3119f8
--- /dev/null
+++ b/rust/crates/rexx-parse/tests/sourceline_oracle/string_answer_nil_consumers.txt
@@ -0,0 +1,55 @@
+count 54
+/* A STRING answer with no string value is .nil, and the consumers that read
+   .nil as an object answer as the oracle does: SIGNAL VALUE, a stem tail,
+   arithmetic, NUMERIC DIGITS and FUZZ, a DO count and FOR, a host command,
+   INTERPRET, a comparison, PARSE VALUE and ARG, OPTIONS, NUMERIC FORM VALUE
+   and a semaphore timeout. The errors that name the operand name the original
+   object, and .nil is equal to no string. */
+o = .sn~new
+signal on syntax name s1
+signal value o
+s1: say 'signal value' condition('O')~code condition('O')~message
+x.o = 1
+say 'tail' x.o x.['The NIL object']
+signal on syntax name s2
+say 1 + o
+s2: say 'arithmetic' condition('O')~code condition('O')~message
+signal on syntax name s3
+say 2 ** o
+s3: say 'power' condition('O')~code condition('O')~message
+signal on syntax name s4
+numeric digits o
+s4: say 'digits' condition('O')~code condition('O')~message
+signal on syntax name s5
+numeric fuzz o
+s5: say 'fuzz' condition('O')~code condition('O')~message
+signal on syntax name s6
+do o; end
+s6: say 'do count' condition('O')~code condition('O')~message
+signal on syntax name s7
+do i = 1 for o; end
+s7: say 'do for' condition('O')~code condition('O')~message
+signal on syntax name s8
+numeric form value o
+s8: say 'form' condition('O')~code condition('O')~message
+signal on syntax name s9
+say .eventsemaphore~new~wait(o)
+s9: say 'timeout' condition('O')~code condition('O')~message
+options o
+say 'options done'
+say 'equal' ("abc" = o) ("The NIL object" = o) ("The NIL object" == o) ("abc" \= o) ("abc" \== o)
+say 'ordered' ("abc" < o) ("abc" >> o) ("Z" > o)
+parse value o with pv
+say 'parse value' pv
+call pa o
+address system o
+say 'command rc' rc
+interpret o
+say 'interpret rc' rc
+exit
+pa: parse arg pa1
+say 'parse arg' pa1
+return
+::class sn
+::method string
+  return .directory~new
diff --git a/rust/crates/rexx-parse/tests/sourceline_oracle/string_answer_nil_native.txt b/rust/crates/rexx-parse/tests/sourceline_oracle/string_answer_nil_native.txt
