+/* An external routine whose file does not parse raises SYNTAX in that file,
+   trapped and then untrapped. */
+signal on syntax
+call 'badcall.cls'
+say 'not reached'
+exit
+syntax:
+  o = condition('O')
+  say o~code o~position rc o~traceback~items
+  do l over o~traceback; say '  tb:' l; end
+  call 'badcall2.cls'
+  say 'not reached'
diff --git a/rust/corpus/lang/parse_error_interpret.rex b/rust/corpus/lang/parse_error_interpret.rex
new file mode 100644
index 000000000..f0be37272
--- /dev/null
+++ b/rust/corpus/lang/parse_error_interpret.rex
@@ -0,0 +1,24 @@
+/* An INTERPRET string that does not parse raises SYNTAX with its clause as
+   the first traceback line, at the INTERPRET's own line. */
+do n = 1 to 8
+  call t n
+end
+say 'end'
+exit
+t: signal on syntax
+  select
+    when arg(1) = 1 then interpret "y=("
+    when arg(1) = 2 then interpret "v=1; y=(  ; z=2"
+    when arg(1) = 3 then interpret "v=1" || '0a'x || "y=(" || '0a'x || "z=2"
+    when arg(1) = 4 then interpret "do forever then"
+    when arg(1) = 5 then interpret "say 'abc"
+    when arg(1) = 6 then interpret "v = 1 +"
+    when arg(1) = 7 then interpret "if then"
+    when arg(1) = 8 then interpret "end"
+  end
+  return
+syntax:
+  o = condition('O')
+  say o~code o~position rc o~traceback~items
+  do l over o~traceback; say '  tb:' l; end
+  return
