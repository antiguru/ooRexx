 /// (`execution/BaseExecutable.cpp:174`, `classes/StringClassUtil.cpp:428`).
 fn is_source_line(interp: &Interp, value: ObjRef) -> bool {
     matches!(
         interp.receiver_kind(value),
         Ok(Primitive::String | Primitive::SmallInt)
     )
