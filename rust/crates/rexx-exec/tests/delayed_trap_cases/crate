# a SYNTAX condition the debug pause's input read raises is trapped
program
.local~debuginput = .src~new
.local~reads = 0
signal on syntax name s
trace ?r
nop
say 'not reached'
exit
s:
  trace off
  say 's' condition('o')~code condition('o')~message
  exit
::class src
::method linein
  .local~reads = .local~reads + 1
  say 'linein' .local~reads
  if .local~reads > 1 then return ''
  raise syntax 98.900 array('from input') return ''
----
rc> 0
out> linein 1
out> linein 2
out> linein 3
out> s 98.900 from input.
out> linein 4
err>        +++ "LINUX COMMAND /t.rex"
err>      5 *-* nop
err> +++ Interactive trace. "Trace Off" to end debug, ENTER to continue. +++
err>      8 *-* s:
err>      9 *-* trace off
err>     10 *-* say 's' condition('o')~code condition('o')~message
err>        >>>   "s 98.900 from input."
err>     11 *-* exit

# ERROR and FAILURE raised again are ignored, and a FAILURE does not
# become an ERROR
program
call on failure name hf
call on error name he
address system 'no_such_command_zz 2>/dev/null'
say 'after failure'
call on error name he2
k = 0
call re 5
say 'after error, k =' k
exit
re: raise error (arg(1)) return
hf:
  say 'hf' condition('c')
  address system 'no_such_command_zz 2>/dev/null'
  say 'hf returns'
  return
he:
  say 'he' condition('c') rc
  return
he2:
  k = k + 1
  say 'he2' k rc
  if k = 1 then raise error 6 return
  return
----
rc> 0
out> hf FAILURE
out> hf returns
out> after failure
out> he2 1 5
out> after error, k = 1
err>      3 *-* address system 'no_such_command_zz 2>/dev/null'
err>        >>>   "no_such_command_zz 2>/dev/null"
err>        +++   "RC(127)"
err>     13 *-*   address system 'no_such_command_zz 2>/dev/null'
err>        >>>     "no_such_command_zz 2>/dev/null"
err>        +++     "RC(127)"
