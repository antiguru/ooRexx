# A condition raised again while its CALL ON trap is delayed, which rexxref
# (condtra.xml, CALL ON) holds until the handler returns or a trap
# instruction for the condition is processed. The oracle drops it, so the
# expected blocks are this crate's own output.

# a RETURN from the handler calls it again for a USER condition
program
call on user ping name h
n = 0
call rp 'first'
say 'after first, n =' n
exit
rp: parse arg dd; raise user ping description (dd) return
h:
  n = n + 1
  say 'handler' n condition('d')
  if n = 1 then call rp 'again'
  say 'handler' n 'returns'
  return
----
rc> 0
out> handler 1 first
out> handler 1 returns
out> handler 2 again
out> handler 2 returns
out> after first, n = 2

# and for HALT
program
call on halt name hh
call rh 'one'
say 'after halt'
exit
rh: parse arg dd; raise halt description (dd) return
hh:
  say 'hh' condition('d')
  if condition('d') == 'one' then call rh 'two'
  say 'hh returns' condition('d')
  return
----
rc> 0
out> hh one
out> hh returns one
out> hh two
out> hh returns two
out> after halt

# a RAISE ... RETURN in the handler itself
program
call on user ping name h
n = 0
call rp 'first'
say 'after first, n =' n
exit
rp: parse arg dd; raise user ping description (dd) return
h:
  n = n + 1
  say 'h' n condition('d')
  if n = 1 then raise user ping description 'again' return
  say 'h' n 'returns'
  return
----
rc> 0
out> h 1 first
out> h 2 again
out> h 2 returns
out> after first, n = 2

# a CALL ON re-issued in the handler calls it at once
program
call on user ping name h
n = 0
call rp 'first'
say 'after first, n =' n
exit
rp: parse arg dd; raise user ping description (dd) return
h:
  n = n + 1
  say 'handler' n condition('d')
  if n = 1 then do
    call rp 'again'
    say 'raised again'
    call on user ping name h
    say 'after call on'
  end
  say 'handler' n 'returns'
  return
----
rc> 0
out> handler 1 first
out> raised again
out> handler 2 again
out> handler 2 returns
out> after call on
out> handler 2 returns
out> after first, n = 2

# a SIGNAL ON re-issued in the handler signals at once, with the held
# condition's ADDITIONAL, RESULT, POSITION and TRACEBACK; SIGL names the
# SIGNAL ON
program
call on user sig name hs
call rs 'one'
say 'not reached'
exit
rs: parse arg dd; raise user sig description (dd) additional (dd'-add') return (dd'-res')
hs:
  say 'hs' condition('d') condition('i') condition('a')
  call rs 'two'
  say 'hs raised again'
  signal on user sig name sg
  say 'hs not reached'
  return
sg:
  say 'sg' condition('d') condition('i') sigl condition('a') condition('o')~result
  say 'sg' condition('o')~position condition('o')~traceback~firstitem
  exit
----
rc> 0
out> hs one CALL one-add
out> hs raised again
out> sg two SIGNAL 10 two-add two-res
out> sg 5      5 *-*     raise user sig description (dd) additional (dd'-add') return (dd'-res')

# a CALL OFF in the handler: a USER condition is ignored
program
call on user off name h
call rp 'one'
say 'after user'
exit
rp: parse arg dd; raise user off description (dd) return
h:
  say 'h' condition('d')
  call rp 'two'
  call off user off
  say 'h after off'
  return
----
rc> 0
out> h one
out> h after off
out> after user

# and a HALT takes its default action at the end of the CALL OFF
program
call on halt name hh
call rh 'one'
say 'not reached'
exit
rh: parse arg dd; raise halt description (dd) return
hh:
  say 'hh' condition('d')
  call rh 'two'
  say 'hh before off'
  call off halt
  say 'hh not reached'
  return
----
rc> 252
out> hh one
out> hh before off
err>     10 *-*   call off halt
err>      2 *-* call rh 'one'
err> Error 4 running /t.rex line 10:  Program interrupted.
err> Error 4.1:  Program interrupted with HALT condition.

# NOTREADY raised again is ignored, and a CALL ON ANY trap holds USER
program
call on notready name hn
n = 0
x = linein('no_such_file_zz.txt')
say 'after notready, n =' n
call on any name ha
m = 0
call rp 'first'
say 'after any, m =' m
exit
rp: parse arg dd; raise user anyc description (dd) return
hn:
  n = n + 1
  say 'hn' n condition('c') condition('d')
  if n = 1 then x = linein('no_such_file_zz2.txt')
  say 'hn' n 'returns'
  return
ha:
  m = m + 1
  say 'ha' m condition('c') condition('d')
  if m = 1 then call rp 'again'
  return
----
rc> 0
out> hn 1 NOTREADY no_such_file_zz.txt
out> hn 1 returns
out> after notready, n = 1
out> ha 1 USER ANYC first
out> ha 2 USER ANYC again
out> after any, m = 2

# NOTREADY is ignored under a delayed CALL ON ANY trap, and when raised
# twice in one clause
program
call on any name ha
m = 0
x = linein('no_such_file_zz.txt')
say 'after any, m =' m
call on notready name hn
n = 0
x = linein('no_such_file_zz3.txt') || linein('no_such_file_zz4.txt')
say 'after two, n =' n
exit
ha:
  m = m + 1
  say 'ha' m condition('c') condition('d')
  x = linein('no_such_file_zz2.txt')
  say 'ha' m 'returns'
  return
hn:
  n = n + 1
  say 'hn' n condition('c') condition('d')
  return
----
rc> 0
out> ha 1 NOTREADY no_such_file_zz.txt
out> ha 1 returns
out> after any, m = 1
out> hn 1 NOTREADY no_such_file_zz3.txt
out> after two, n = 1

# NOTREADY is ignored under a CALL ON ANY trap a USER condition queued
# at the same clause delayed
program
call on any name ha
m = 0
x = ru('one') || linein('no_such_file_zz.txt')
say 'after a, m =' m
exit
ru: raise user u description (arg(1)) return 'r'
ha:
  m = m + 1
  say 'ha' m condition('c') condition('d')
  return
----
rc> 0
out> ha 1 USER U one
out> after a, m = 1

# a NOTREADY inside an internal routine the clause calls after queueing
# one is ignored: the routine inherits the trap's DELAY state
program
call on notready name hn
m = 0
x = linein('no_such_file_zz.txt') || rn()
say 'after a, m =' m
exit
rn: return linein('no_such_file_zz2.txt')
hn:
  m = m + 1
  say 'hn' m condition('c') condition('d')
  return
----
rc> 0
out> hn 1 NOTREADY no_such_file_zz.txt
out> after a, m = 1

# and under a CALL ON ANY a USER condition queued at the clause delayed
program
call on any name ha
m = 0
x = ru('one') || rn()
say 'after a, m =' m
exit
ru: raise user u description (arg(1)) return 'r'
rn: return linein('no_such_file_zz.txt')
ha:
  m = m + 1
  say 'ha' m condition('c') condition('d')
  return
----
rc> 0
out> ha 1 USER U one
out> after a, m = 1

# an internal routine's own CALL ON NOTREADY is not delayed by the NOTREADY
# its caller's clause queued: a trap the routine sets is its own
program
call on notready name hn
m = 0
x = linein('no_such_file_zz.txt') || rn()
say 'after a, m =' m
exit
rn:
  call on notready name hn
  y = linein('no_such_file_zz2.txt')
  say 'rn after its linein'
  return y
hn:
  m = m + 1
  say 'hn' m condition('c') condition('d')
  return
----
rc> 0
out> hn 1 NOTREADY no_such_file_zz2.txt
out> rn after its linein
out> hn 2 NOTREADY no_such_file_zz.txt
out> after a, m = 2

# a condition the debug pause's input read raises is an ordinary read's:
# trapped, and held while its handler runs (the handler pauses too)
program
.local~debuginput = .src~new
.local~reads = 0
call on user ping name h
n = 0
trace ?r
nop
say 'after' n
exit
h:
  n = n + 1
  say 'h' n condition('d')
  return
::class src
::method linein
  .local~reads = .local~reads + 1
  say 'linein' .local~reads
  if .local~reads > 6 then return ''
  raise user ping description 'from input' return ''
