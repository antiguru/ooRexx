#!/usr/bin/env rexx
/* TEST_A leaves a flag beside the copy and refuses; a run that finds the
   flag refuses in its prolog, before any test starts. */
  if .stream~new('../refuse-at-load')~query('exists') \== '' then do
    name = 'SysQueryRexx' || 'Macro'
    interpret 'r =' name || '(''x'')'
  end
  parse source . . s
  group = .TestGroup~new(s)
  group~add(.RefusedAfterFirst.testGroup)
  if group~isAutomatedTest then return group
  testResult = group~suite~execute~~print
return testResult

::requires 'ooTest.frm'

::class "RefusedAfterFirst.testGroup" subclass ooTestCase public

::method test_a
  .stream~new('../refuse-at-load')~~lineout('x')~~close
  name = 'SysQueryRexx' || 'Macro'
  interpret 'r =' name || '(''x'')'

::method test_b
  self~assertSame(1, 1)
