#!/usr/bin/env rexx
/* TEST_A runs a child rexx that refuses on the inherited stderr; the group
   itself ends normally. The routine's name is built at run time, so
   reaching_rxapi does not rename the test out. */
  parse source . . s
  group = .TestGroup~new(s)
  group~add(.ChildRefuses.testGroup)
  if group~isAutomatedTest then return group
  testResult = group~suite~execute~~print
return testResult

::requires 'ooTest.frm'

::class "ChildRefuses.testGroup" subclass ooTestCase public

::method test_a
  child = .stream~new('child.rex')
  child~lineout("name = 'SysQueryRexx' || 'Macro'")
  child~lineout("interpret 'r =' name || '(''x'')'")
  child~close
  address system 'rexx child.rex'
  self~assertSame(120, rc)
