# a bad TO bound under trace r
# **The row that says each header value is echoed before it is validated.** The
# `>K>  "TO"` line is printed for the very value that then fails, so an echo
# emitted after the validation would be missing here and nowhere else -- every
# other traced header row echoes values that all pass.
#
# The second `do i = 1 to 'a' by 2` line is the failing clause's own echo, which
# every raise inside a clause prints.
program
trace r
do i = 1 to 'a' by 2
  nop
end
