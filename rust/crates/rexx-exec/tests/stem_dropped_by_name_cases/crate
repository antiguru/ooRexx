# A stem passed by name to a RexxUtil stem routine, whose variable a STRING
# method run by the same call drops before allocating. The oracle's answer
# depends on when it collects (oracle-crashes.txt entry 47), so the expected
# blocks are this crate's own output: the routine works on the stem it
# resolved, as the oracle does when it does not collect.

# SysStemCopy: the start argument's STRING drops the source stem
program
.k~new~run
::class k
::method run
  expose s.
  s.0 = 2; s.1 = copies('first ', 3); s.2 = copies('second ', 3)
  say SysStemCopy('s.', 't.', self) t.0
  say t.1 '/' t.2
  say symbol('s.0')
::method string
  expose s.
  drop s.
  x = copies('filler ', 50)
  return 1
----
rc> 0
out> 0 2
out> first first first  / second second second 
out> LIT

