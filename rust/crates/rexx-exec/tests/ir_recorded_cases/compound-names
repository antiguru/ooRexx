# How a compound variable's name splits, one shape of the split per row.

# a constant tail, set and unset
# `zc.9` was never written, so it derives its own fully resolved spelling.
program
zc.5 = 'five'
say zc.5
say zc.9
----
rc> 0
out> five
out> ZC.9

# a variable tail, read back through the variable and through the literal it
# resolved to -- one tail, reached two ways
program
zi = 7
zv.zi = 'val'
say zv.zi
say zv.7
----
rc> 0
out> val
out> val

# several tails, and a mixed constant/variable tail that is NOT the same tail
# `za.zi.3.zj` resolves to ZA.1.3.2, a different key from ZA.1.2, so the
# period-joined pieces are a key rather than a nesting.
program
zi = 1
zj = 2
za.zi.zj = 'deep'
say za.zi.zj
say za.1.2
say za.zi.3.zj
----
rc> 0
out> deep
out> deep
out> ZA.1.3.2

# an unset tail variable, which contributes its own upcased spelling, and the
# constant piece with that same spelling, which is the same tail
# `zu.` is a bare stem read and announces the stem's own name.
program
zu.zk = 'set'
say zu.zk
say zu.ZK
say zu.
----
rc> 0
out> set
out> set
out> ZU.

# a tail variable whose value changes between references
program
zi = 1
zm.zi = 'one'
zi = 2
zm.zi = 'two'
zi = 1
say zm.zi
zi = 2
say zm.zi
----
rc> 0
out> one
out> two

# a bare stem: its default, a tail taking that default, a tail overriding it,
# and an untouched stem deriving its own name
program
zs. = 'def'
say zs.
say zs.1
zs.1 = 'x'
say zs.1
say zt.
----
rc> 0
out> def
out> def
out> x
out> ZT.

# DROP of a compound, with and without a stem default underneath it
# A dropped tail is a tombstone: it derives its own name rather than falling
# back to the stem's default, while an untouched tail takes the default.
program
zi = 3
zd.zi = 'gone'
say zd.zi
drop zd.zi
say zd.zi
zd. = 'dflt'
zd.4 = 'four'
drop zd.4
say zd.4
say zd.5
----
rc> 0
out> gone
out> ZD.3
out> ZD.4
out> dflt

# a compound built inside an INTERPRET, and an INTERPRET inside a loop
program
zi = 1
interpret "zp.zi = 'in'"
say zp.1
do zi = 1 to 3
  interpret "zq.zi = zi * 10"
  say zq.zi
end
say zq.1 zq.2 zq.3
----
rc> 0
out> in
out> 10
out> 20
out> 30
out> 10 20 30

# a fragment's compound read against the ENCLOSING body's split table
program
za.1 = 'first'
zi = 5
interpret "zb.zi = 'in'"
say zb.5
say za.1
do zj = 1 to 2
  interpret "zc.zj = zj"
  say zc.zj
end
say za.1
----
rc> 0
out> in
out> first
out> 1
out> 2
out> first

# a DO control variable that is itself a compound, its tail re-resolved on
# every pass
# `zi = 'k'` makes the control write the tail keyed by the lowercase value,
# which `zb.k`'s upcased constant piece does not name.
program
do za.zi = 1 to 3
  say za.zi
end
zi = 'k'
do zb.zi = 1 to 2
  say zb.zi zb.k
end
----
rc> 0
out> 1
out> 2
out> 3
out> 1 ZB.K
out> 2 ZB.K

# a tail piece introduced by an INTERPRET, on both sides of the slot question
program
interpret "zi = 4"
zv.zi = 'via fragment'
say zv.zi
say zv.4
interpret "zk = 9"
do za.zk = 1 to 2
  nop
end
say za.9
----
rc> 0
out> via fragment
out> via fragment
out> 3

# one compound read either side of a DROP of its tail variable, and of its own
# tail
program
zi = 1
zv.zi = 'one'
say zv.zi
zn = 'ZI'
drop (zn)
say zv.zi
zi = 1
say zv.zi
drop zv.zi
say zv.zi
----
rc> 0
out> one
out> ZV.ZI
out> one
out> ZV.1

# a stem's own operations, with compound reads through it on either side
program
zs. = 'dflt'
zi = 1
say zs.zi
zs.zi = 'one'
say zs.zi
say zs.
drop zs.
say zs.zi
say zs.
zs.2 = 'two'
say zs.2 zs.9
----
rc> 0
out> dflt
out> one
out> dflt
out> ZS.1
out> ZS.
out> two ZS.9

# PROCEDURE EXPOSE of a stem, written through on both sides of the call
program
zi = 3
zp.zi = 'outer'
call zsub
say zp.3 zp.4
exit
zsub:
procedure expose zp.
zj = 4
zp.zj = 'inner'
say zp.3
return
----
rc> 0
out> outer
out> outer inner

# a compound inside an INTERPRET, on both sides of the stem's slot question
program
interpret "zq.1 = 'frag'"
say zq.1
say zq.
interpret "zr.2 = 'only'"
interpret "say zr.2"
----
rc> 0
out> frag
out> ZQ.
out> only
