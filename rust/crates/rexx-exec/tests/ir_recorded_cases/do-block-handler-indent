# The trace indent a CALL ON handler is given when it is delivered at a plain
# DO's own two clause boundaries, pinned on the oracle's own bytes.

# Delivered at the DO's header clause. `zn = ra()` queues zx, its own boundary
# runs `h`, and `h` requeues zy -- which the next boundary owes, and the next
# boundary is the `DO`'s own. The block is open there, so that boundary settles
# 2 and `g:` echoes at column 4, ahead of the body's `say` at column 2.
program
trace r
call on user zx name h
call on user zy name g
zn = ra()
do
say 'body'
end
say 'after' zn
exit 0
ra:
raise user zx return 1
h:
say 'h ran' sigl
raise user zy return 1
g:
say 'g ran' sigl
return
----
rc> 0
out> h ran 4
out> g ran 5
out> body
out> after 1
err>      2 *-* call on user zx name h
err>      3 *-* call on user zy name g
err>      4 *-* zn = ra()
err>     10 *-*   ra:
err>     11 *-*   raise user zx return 1
err>        >K>     "RESULT" => "1"
err>        >>>   "1"
err>     12 *-*   h:
err>     13 *-*   say 'h ran' sigl
err>        >>>     "h ran 4"
err>     14 *-*   raise user zy return 1
err>        >K>     "RESULT" => "1"
err>      5 *-* do
err>     15 *-*     g:
err>     16 *-*     say 'g ran' sigl
err>        >>>       "g ran 5"
err>     17 *-*     return
err>      6 *-*   say 'body'
err>        >>>     "body"
err>      7 *-* end
err>      8 *-* say 'after' zn
err>        >>>   "after 1"
err>      9 *-* exit 0
err>        >>>   "0"

# Delivered at the END clause. Nothing is queued before the `DO`, so its header
# boundary has nothing to deliver; the body clause queues zx, runs `h` at its
# own boundary, and `h`'s requeue of zy is owed to the `END`. The block is
# closed by then, so that boundary settles 0 -- the `DO`'s own -- and `g:`
# echoes at column 2, the body clause's own column.
program
trace r
call on user zx name h
call on user zy name g
do
zn = ra()
end
say 'after' zn
exit 0
ra:
raise user zx return 1
h:
say 'h ran' sigl
raise user zy return 1
g:
say 'g ran' sigl
return
----
rc> 0
out> h ran 5
out> g ran 6
out> after 1
err>      2 *-* call on user zx name h
err>      3 *-* call on user zy name g
err>      4 *-* do
err>      5 *-*   zn = ra()
err>      9 *-*     ra:
err>     10 *-*     raise user zx return 1
err>        >K>       "RESULT" => "1"
err>        >>>     "1"
err>     11 *-*     h:
err>     12 *-*     say 'h ran' sigl
err>        >>>       "h ran 5"
err>     13 *-*     raise user zy return 1
err>        >K>       "RESULT" => "1"
err>      6 *-* end
err>     14 *-*   g:
err>     15 *-*   say 'g ran' sigl
err>        >>>     "g ran 6"
err>     16 *-*   return
err>      7 *-* say 'after' zn
err>        >>>   "after 1"
err>      8 *-* exit 0
err>        >>>   "0"

# The same two boundaries with a non-zero `do_indent`. The inner `DO` sits in an
# outer block, so it echoes at column 2 and both of its boundaries settle from 2
# rather than 0: the header settles 4 and `g:` echoes at column 6, the `END`
# settles 2 and `m:` echoes at column 4. Measured, replacing `do_indent` with a
# literal `0` at either site moves that site's own handler two columns out --
# `g:` to 4, or `m:` to 2 -- and leaves the two rows above byte-identical.
program
trace r
call on user zx name h
call on user zy name g
call on user zw name k
call on user zv name m
do
zn = ra()
do
zp = rb()
end
end
say 'after' zn zp
exit 0
ra:
raise user zx return 1
rb:
raise user zw return 1
h:
say 'h ran' sigl
raise user zy return 1
g:
say 'g ran' sigl
return
k:
say 'k ran' sigl
raise user zv return 1
m:
say 'm ran' sigl
return
----
rc> 0
out> h ran 7
out> g ran 8
out> k ran 9
out> m ran 10
out> after 1 1
err>      2 *-* call on user zx name h
err>      3 *-* call on user zy name g
err>      4 *-* call on user zw name k
err>      5 *-* call on user zv name m
err>      6 *-* do
err>      7 *-*   zn = ra()
err>     14 *-*     ra:
err>     15 *-*     raise user zx return 1
err>        >K>       "RESULT" => "1"
err>        >>>     "1"
err>     18 *-*     h:
err>     19 *-*     say 'h ran' sigl
err>        >>>       "h ran 7"
err>     20 *-*     raise user zy return 1
err>        >K>       "RESULT" => "1"
err>      8 *-*   do
err>     21 *-*       g:
err>     22 *-*       say 'g ran' sigl
err>        >>>         "g ran 8"
err>     23 *-*       return
err>      9 *-*     zp = rb()
err>     16 *-*       rb:
err>     17 *-*       raise user zw return 1
err>        >K>         "RESULT" => "1"
err>        >>>       "1"
err>     24 *-*       k:
err>     25 *-*       say 'k ran' sigl
err>        >>>         "k ran 9"
err>     26 *-*       raise user zv return 1
err>        >K>         "RESULT" => "1"
err>     10 *-*   end
err>     27 *-*     m:
err>     28 *-*     say 'm ran' sigl
err>        >>>       "m ran 10"
err>     29 *-*     return
err>     11 *-* end
err>     12 *-* say 'after' zn zp
err>        >>>   "after 1 1"
err>     13 *-* exit 0
err>        >>>   "0"
