# What `NUMERIC FUZZ` does, including in the state only its own reset reaches.

# the reset refuses rather than storing a default that would sit under FUZZ, and
# the rejected value it names is the default (9) rather than the 30 in force.
program
numeric digits 30
numeric fuzz 20
numeric digits
say digits() fuzz()
numeric fuzz
say digits() fuzz()
----
rc> 223
err>      3 *-* numeric digits
err> Error 33 running /nonexistent/ir-dual-case.rex line 3:  Invalid expression result.
err> Error 33.1:  Value of NUMERIC DIGITS ("9") must exceed value of NUMERIC FUZZ ("20").

# the adjacent case, FUZZ equal to the default rather than above it: the check
# is `<=`, so equality refuses too, and both substituted values read 9. The
# comparison rows these two blocks used to carry are gone with the state they
# needed -- nothing after the refusal ran, so they pinned this message twice
# over rather than any comparison.
program
numeric digits 30
numeric fuzz 9
numeric digits
say digits() fuzz()
----
rc> 223
err>      3 *-* numeric digits
err> Error 33 running /nonexistent/ir-dual-case.rex line 3:  Invalid expression result.
err> Error 33.1:  Value of NUMERIC DIGITS ("9") must exceed value of NUMERIC FUZZ ("9").

# integer objects against everything adjacent to them. The first row is the
# exact comparison; the rest each miss it for one reason -- a decimal point, a
# digit more than DIGITS admits, or a result the interpreter builds as a string.
program
numeric digits 9
numeric fuzz 8
say 100000000 = 100000001
say 100000000.0 = 100000001
say 1000000000 = 1000000001
say trunc(100000000.4) = 100000001
say x2d('5F5E100') = 100000001
say c2d('05F5E100'x) = 100000001
say format(100000000) = 100000001
----
rc> 0
out> 1
out> 1
out> 1
out> 1
out> 1
out> 1
out> 1

# a controlled loop's bound test is an ordinary comparison, so a non-zero FUZZ
# reaches it whichever way the values are spelled. Neither loop terminates on its
# own here -- the `leave` is what bounds both -- because 100000002 and 100000001
# compare equal at DIGITS 9 FUZZ 8.
program
numeric digits 9
numeric fuzz 8
zc = 0
do zi = 100000002 to 100000001
  zc = zc + 1
  if zc > 3 then leave
end
say 'int' zc
zc = 0
do zi = 100000002.0 to 100000001
  zc = zc + 1
  if zc > 3 then leave
end
say 'frac' zc
----
rc> 0
out> int 4
out> frac 4
