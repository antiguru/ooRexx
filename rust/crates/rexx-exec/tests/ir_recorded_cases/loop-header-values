# What a DO/LOOP header's values print while they are being computed.

# trace i over a TO/BY/FOR header, which is the `>K>` order per header value
# The interleave is the property: each value's own intermediate lines come
# first, then that value's `>K>`, then the next value is evaluated at all. The
# initial value has intermediate lines and no `>K>` of its own, and the TO
# bound is a symbol read rather than a literal, so the run of lines is not one
# shape repeated.
program
trace i
zn = 6
do zi = 1 to zn by 2 for 2
  say zi
end
----
rc> 0
out> 1
out> 3
err>      2 *-* zn = 6
err>        >L>   "6"
err>        >>>   "6"
err>        >=>   ZN <= "6"
err>      3 *-* do zi = 1 to zn by 2 for 2
err>        >L>   "1"
err>        >V>   ZN => "6"
err>        >K>   "TO" => "6"
err>        >L>   "2"
err>        >K>   "BY" => "2"
err>        >L>   "2"
err>        >K>   "FOR" => "2"
err>        >=>   ZI <= "1"
err>      4 *-*   say zi
err>        >V>     ZI => "1"
err>        >>>     "1"
err>      5 *-* end
err>      3 *-* do zi = 1 to zn by 2 for 2
err>        >V>     ZI => "1"
err>        >>>     "1"
err>        >>>     "3"
err>        >=>     ZI <= "3"
err>      4 *-*   say zi
err>        >V>     ZI => "3"
err>        >>>     "3"
err>      5 *-* end
err>      3 *-* do zi = 1 to zn by 2 for 2
err>        >V>     ZI => "3"
err>        >>>     "3"
err>        >>>     "5"
err>        >=>     ZI <= "5"

# trace r over the same header, where the `>K>` lines are the whole of it
# The same values under a setting that prints no intermediate line at all, which
# is what separates the echo order from the values' own ops: `trace i` shows a
# `>K>` sitting among the lines its value produced, and this shows them adjacent
# and in the order the keywords were written.
program
trace r
zn = 6
do zi = 1 to zn by 2 for 2
  say zi
end
----
rc> 0
out> 1
out> 3
err>      2 *-* zn = 6
err>        >>>   "6"
err>      3 *-* do zi = 1 to zn by 2 for 2
err>        >K>   "TO" => "6"
err>        >K>   "BY" => "2"
err>        >K>   "FOR" => "2"
err>      4 *-*   say zi
err>        >>>     "1"
err>      5 *-* end
err>      3 *-* do zi = 1 to zn by 2 for 2
err>        >>>     "1"
err>        >>>     "3"
err>      4 *-*   say zi
err>        >>>     "3"
err>      5 *-* end
err>      3 *-* do zi = 1 to zn by 2 for 2
err>        >>>     "3"
err>        >>>     "5"

# trace i over a header whose bound is a call
# The call takes an `Op::CallExpr` addressed at slot 1 of the DO, which resolves
# only because `Interp::chunk_node_at` descends a header slot through
# `loop_header_slot`. The argument's `>A>` and the call's own `>F>` sit in front
# of the `>K>` the bound owes, so this row holds the address and the order at
# once.
program
trace i
zs = 'ab'
do zi = 1 to length(zs)
  say zi
end
----
rc> 0
out> 1
out> 2
err>      2 *-* zs = 'ab'
err>        >L>   "ab"
err>        >>>   "ab"
err>        >=>   ZS <= "ab"
err>      3 *-* do zi = 1 to length(zs)
err>        >L>   "1"
err>        >V>   ZS => "ab"
err>        >A>   "ab"
err>        >F>   LENGTH => "2"
err>        >K>   "TO" => "2"
err>        >=>   ZI <= "1"
err>      4 *-*   say zi
err>        >V>     ZI => "1"
err>        >>>     "1"
err>      5 *-* end
err>      3 *-* do zi = 1 to length(zs)
err>        >V>     ZI => "1"
err>        >>>     "1"
err>        >>>     "2"
err>        >=>     ZI <= "2"
err>      4 *-*   say zi
err>        >V>     ZI => "2"
err>        >>>     "2"
err>      5 *-* end
err>      3 *-* do zi = 1 to length(zs)
err>        >V>     ZI => "2"
err>        >>>     "2"
err>        >>>     "3"
err>        >=>     ZI <= "3"

# trace i over a DO OVER ... FOR
program
trace i
zs = 'abc'
do qq over zs for 1
  say qq
end
----
rc> 0
out> abc
err>      2 *-* zs = 'abc'
err>        >L>   "abc"
err>        >>>   "abc"
err>        >=>   ZS <= "abc"
err>      3 *-* do qq over zs for 1
err>        >V>   ZS => "abc"
err>        >K>   "OVER" => "abc"
err>        >L>   "1"
err>        >K>   "FOR" => "1"
err>        >=>     QQ <= "abc"
err>      4 *-*   say qq
err>        >V>     QQ => "abc"
err>        >>>     "abc"
err>      5 *-* end
err>      3 *-* do qq over zs for 1
