# What promoting an arithmetic operator has to keep, by kind.

# every operator, over two variable operands
program
za = 7
zb = 2
say za + zb
say za - zb
say za * zb
say za / zb
say za % zb
say za // zb
say za ** zb
----
rc> 0
out> 9
out> 5
out> 14
out> 3.5
out> 3
out> 1
out> 49

# chains: one operator's result is the next one's operand, with precedence and
# parentheses deciding which. The left-associative forms are what make a
# compiled operand register hold an intermediate rather than a read.
program
za = 2
zb = 3
zc = 4
say za + zb + zc
say za + zb * zc
say (za + zb) * zc
say za - zb - zc
say za * zb - zc + 1
----
rc> 0
out> 9
out> 14
out> 20
out> -5
out> 3

# an operand that is a call, which fills its operand register from an op that
# runs the call rather than from a read or an inner operator. The last row puts
# the call at the far end of an operator chain, where the register it lands in
# is the one the enclosing operator reads as its right.
program
zt = 5
say length('abcd') + 1
say zt + length('ab')
say abs(-3) * zt
say zt + 1 + length('x')
----
rc> 0
out> 5
out> 7
out> 15
out> 7

# NUMERIC DIGITS 3: the operands are rounded before the operation, so the exact
# integer answer is the wrong one. `1000 - 25` is `980`; `999 + 6` is `1005`,
# which renders `1.01E+3`; `500 * 500` has operands inside the precision and a
# result outside it.
program
numeric digits 3
say 1000 - 25
say 999 + 6
say 500 * 500
say 0.5 - 25
----
rc> 0
out> 980
out> 1.01E+3
out> 2.50E+5
out> -24.5

# one site, run three times, whose operands leave the exact-integer range part
# way through: the first pass is exact, and the two after it are not. A site
# specialised on what it saw the first time has to give this up when it stops
# holding.
program
numeric digits 3
zn = 1
do zi = 1 to 3
  say zn - 25
  zn = zn * 1000
end
----
rc> 0
out> -24
out> 980
out> 1.00E+6

# NUMERIC DIGITS narrowed by a later clause of the same body, so a site that
# was exact under the wider setting stops being exact without its operands
# changing at all.
program
za = 300
say za + 45
numeric digits 2
say za + 45
numeric digits 9
say za + 45
----
rc> 0
out> 345
out> 3.5E+2
out> 345

# NUMERIC FORM ENGINEERING, which decides how a result too wide for the
# precision renders -- an exponent that is a multiple of three, and up to three
# digits in front of the point. `1.01E+3` is unchanged by the setting, its
# exponent already being one; `250E+3` is where the two forms part.
program
numeric digits 3
numeric form engineering
say 999 + 6
say 500 * 500
numeric form scientific
say 999 + 6
----
rc> 0
out> 1.01E+3
out> 250E+3
out> 1.01E+3

# trace i: the `>O>` line one operator's result owes, after both operands' own
# lines and in the order the operators are applied -- the inner `*` before the
# outer `+`.
program
trace i
za = 2
zb = 3
zc = za + zb * 4
say zc - 1
----
rc> 0
out> 13
err>      2 *-* za = 2
err>        >L>   "2"
err>        >>>   "2"
err>        >=>   ZA <= "2"
err>      3 *-* zb = 3
err>        >L>   "3"
err>        >>>   "3"
err>        >=>   ZB <= "3"
err>      4 *-* zc = za + zb * 4
err>        >V>   ZA => "2"
err>        >V>   ZB => "3"
err>        >L>   "4"
err>        >O>   "*" => "12"
err>        >O>   "+" => "14"
err>        >>>   "14"
err>        >=>   ZC <= "14"
err>      5 *-* say zc - 1
err>        >V>   ZC => "14"
err>        >L>   "1"
err>        >O>   "-" => "13"
err>        >>>   "13"

# trace r: the other direction. An emission that ignored its own gate would
# print a `>O>` line here, where the setting asks for results alone.
program
trace r
za = 2
zc = za + 1
say zc * 2
----
rc> 0
out> 6
err>      2 *-* za = 2
err>        >>>   "2"
err>      3 *-* zc = za + 1
err>        >>>   "3"
err>      4 *-* say zc * 2
err>        >>>   "6"

# every other binary family under trace i, in one clause stream with the
# arithmetic rows above: the tag each family prints, and the order an operator's
# own line takes among its operands'. On the compiled engine every line here
# comes from an op sitting behind the operation rather than from evaluating the
# node, and this harness requires the two engines to agree byte for byte -- so a
# family whose op carried the wrong tag, or sat in the wrong place, shows up
# here as a line under the wrong sign or in the wrong order.
program
trace i
za = 2
say za || 'x'
say za = 2
say za > 1 & za < 9
say 'p' 'q'
----
rc> 0
out> 2x
out> 1
out> 1
out> p q
err>      2 *-* za = 2
err>        >L>   "2"
err>        >>>   "2"
err>        >=>   ZA <= "2"
err>      3 *-* say za || 'x'
err>        >V>   ZA => "2"
err>        >L>   "x"
err>        >O>   "||" => "2x"
err>        >>>   "2x"
err>      4 *-* say za = 2
err>        >V>   ZA => "2"
err>        >L>   "2"
err>        >O>   "=" => "1"
err>        >>>   "1"
err>      5 *-* say za > 1 & za < 9
err>        >V>   ZA => "2"
err>        >L>   "1"
err>        >O>   ">" => "1"
err>        >V>   ZA => "2"
err>        >L>   "9"
err>        >O>   "<" => "1"
err>        >O>   "&" => "1"
err>        >>>   "1"
err>      6 *-* say 'p' 'q'
err>        >L>   "p"
err>        >L>   "q"
err>        >O>   " " => "p q"
err>        >>>   "p q"

# `**`'s exponent, which is not converted the way its base is: a base that will
# not convert is 41.1 and an exponent that is not whole is 26.8, and the base's
# failure is checked first.
program
say 2 ** 2.5
----
rc> 230
err>      1 *-* say 2 ** 2.5
err> Error 26 running /nonexistent/ir-dual-case.rex line 1:  Invalid whole number.
err> Error 26.8:  Operand to the right of the power operator (**) must be a whole number; found "2.5".

# **A nonnumeric exponent is 26.8 too, and that is what the row above cannot
# say.** `2.5` converts and then fails as a whole number, so an exponent routed
# through the ordinary operand conversion raises the identical 26.8 for it -- a
# mutation doing exactly that was invisible to the whole workspace, including
# the row above, and this row is what caught it. `'x'` does not convert at all,
# so it separates the two paths: 26.8 through `**`'s own conversion, 41.1
# through the operand one, and the base's failure winning when both are bad.
program
zq = 'x'
signal on syntax name z1
say 2 ** zq
z1:
say 'exponent' rc 'at' sigl
signal on syntax name z2
say zq ** 2
z2:
say 'base' rc 'at' sigl
signal on syntax name z3
say zq ** zq
z3:
say 'both' rc 'at' sigl
----
rc> 0
out> exponent 26 at 3
out> base 41 at 7
out> both 41 at 11

# a zero divisor, which raises 42.3 from `rexx-num` rather than from
# converting an operand. `/`, `%` and `//` all raise it, and the untrapped form
# is what pins the clause the report echoes.
program
zd = 0
say 6 // zd
----
rc> 214
err>      2 *-* say 6 // zd
err> Error 42 running /nonexistent/ir-dual-case.rex line 2:  Arithmetic overflow/underflow.
err> Error 42.3:  Arithmetic overflow; divisor must not be zero.

# the same divisor under each dividing operator, trapped, so that one row says
# every one of them reaches it and says which clause SIGL lands on for each.
program
zd = 0
signal on syntax name z1
say 6 / zd
z1:
say 'divide' rc 'at' sigl
signal on syntax name z2
say 6 % zd
z2:
say 'intdiv' rc 'at' sigl
signal on syntax name z3
say 6 // zd
z3:
say 'remainder' rc 'at' sigl
----
rc> 0
out> divide 42 at 3
out> intdiv 42 at 7
out> remainder 42 at 11

# a failure inside a chain: the clause the condition is reported against is the
# whole assignment's, not the operator's, and the operators to the left of the
# failing one have already run.
program
signal on syntax name zt
za = 1
zb = 'q'
say za * 2 + zb + 4
exit
zt:
say 'trapped' rc 'at' sigl
----
rc> 0
out> trapped 41 at 4
