# What promoting the message-send clause has to keep, and why an engine-against-
# engine sweep is the instrument for it.

# the plain and the ~~ forms as whole clauses, traced: the clause echo, the
# `>M>` line the send owes, and the RESULT each settles
program
trace i
'abc'~length
say result
'abc'~~length
say result
----
rc> 0
out> 3
out> abc
err>      2 *-* 'abc'~length
err>        >L>   "abc"
err>        >M>   "LENGTH" => "3"
err>      3 *-* say result
err>        >V>   RESULT => "3"
err>        >>>   "3"
err>      4 *-* 'abc'~~length
err>        >L>   "abc"
err>        >M>   "LENGTH" => "abc"
err>      5 *-* say result
err>        >V>   RESULT => "abc"
err>        >>>   "abc"

# a send inside a DO, whose clause echo and value lines carry the body's own
# indent and re-fire on every pass
program
trace i
do ii = 1 to 2
  'abc'~length
end
say result
----
rc> 0
out> 3
err>      2 *-* do ii = 1 to 2
err>        >L>   "1"
err>        >L>   "2"
err>        >K>   "TO" => "2"
err>        >=>   II <= "1"
err>      3 *-*   'abc'~length
err>        >L>     "abc"
err>        >M>     "LENGTH" => "3"
err>      4 *-* end
err>      2 *-* do ii = 1 to 2
err>        >V>     II => "1"
err>        >>>     "1"
err>        >>>     "2"
err>        >=>     II <= "2"
err>      3 *-*   'abc'~length
err>        >L>     "abc"
err>        >M>     "LENGTH" => "3"
err>      4 *-* end
err>      2 *-* do ii = 1 to 2
err>        >V>     II => "2"
err>        >>>     "2"
err>        >>>     "3"
err>        >=>     II <= "3"
err>      5 *-* say result
err>        >V>   RESULT => "3"
err>        >>>   "3"

# the failing clause's own site, resolved from inside a DO: the method's
# traceback line above the sending clause, at that clause's own indent
program
say 'before'
do ii = 1 to 1
  'abc'~length(1)
end
----
rc> 163
out> before
err>        *-* Compiled method "LENGTH" with scope "String".
err>      3 *-*   'abc'~length(1)
err> Error 93 running /nonexistent/ir-dual-case.rex line 3:  Incorrect call to method.
err> Error 93.902:  Too many arguments in invocation of method; 0 expected.

# a send inside an INTERPRET fragment, which is a body of its own with its own
# clause line and its own driver entry
program
trace i
interpret "'abc'~length"
say result
----
rc> 0
out> 3
err>      2 *-* interpret "'abc'~length"
err>        >L>   "'abc'~length"
err>        >>>   "'abc'~length"
err>      2 *-* 'abc'~length
err>        >L>   "abc"
err>        >M>   "LENGTH" => "3"
err>      3 *-* say result
err>        >V>   RESULT => "3"
err>        >>>   "3"

# a SIGNAL ON SYNTAX trap over a failing send: `sigl` is the sending clause's
# own line, which is what says the clause the region opened is the one the
# condition was raised in
program
signal on syntax name oops
'abc'~nosuch
say 'not reached'
exit
oops:
say 'trapped' rc 'at line' sigl
say condition('D')
----
rc> 0
out> trapped 97 at line 2
out> 

# the message-assignment form, whose name gains its `=` inside the same clause
program
x = 'abc'
say 'before'
x[1] = 2
