# a variable-reference argument, whose callee writes the caller's variable
# `>zp` is the one argument form whose value is not the whole of what the callee
# receives: the caller's slot travels with it, and a USE ARG > target writes
# through it.
program
zp = 'orig'
call zsub >zp
say 'after' zp
exit
zsub:
use arg >zq
zq = 'written'
return
----
rc> 0
out> after written

