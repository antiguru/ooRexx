out> got 20
out> got 30

# resolution order, in both directions that can be shown at once
# A builtin wins over a ::ROUTINE of the same name -- `max` reaches the builtin
# through both spellings and the routine never runs -- and a label wins over
# everything behind it.
program
say max(1, 9)
call max 1, 9
say result
say 'label wins:' zlab(2)
call zlab 3
say result
exit
zlab:
use arg zn
return 'LABEL' zn
::routine max
return 'ROUTINE'
----
rc> 0
out> 9
out> 9
out> label wins: LABEL 2
out> LABEL 3

# EXIT ends the program from a called label and only the routine from a ::ROUTINE
program
call zrtn
say 'after routine' result
call zlab
say 'not reached'
exit
zlab:
exit 3
::routine zrtn
exit 7
----
rc> 3
out> after routine 7

# two calls in one clause, under trace i
# **The row that pins the calling clause's indent being restored.** The second
# call's own `>A>` and `>F>` print at the caller's indent, not at the first
# callee's last clause's, and the enclosing `>O>`/`>>>` follow at that indent
# too.
program
trace i
say zf(1) + zg(2)
exit
zf:
use arg zn
return zn * 10
zg:
use arg zn
return zn * 100
