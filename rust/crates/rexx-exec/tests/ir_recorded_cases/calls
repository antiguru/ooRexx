# What promoting the call forms has to keep, across both routes into one
# resolution.

# an internal label, with arguments and the RESULT it settles
program
zx = 4
call zsub zx, 'q'
say 'result=' result
exit
zsub:
use arg za, zb
say 'zsub' za zb
return za + 1
----
rc> 0
out> zsub 4 q
out> result= 5

# a CALL inside an INTERPRET fragment reaches the enclosing program's label
# **The row a resolution against the compiled body cannot pass.** The fragment
# is a body of its own whose label table is empty, and its `call zsub` still
# finds `zsub:` in the program that ran the INTERPRET.
program
interpret "call zsub 1"
say 'result=' result
exit
zsub:
use arg za
say 'zsub got' za
return za + 1
----
rc> 0
out> zsub got 1
out> result= 2

# the same under trace i, where the fragment's clause and the callee's echo at
# lines and indents of their own
program
trace i
interpret "call zsub"
exit
zsub:
return 7
----
rc> 0
err>      2 *-* interpret "call zsub"
err>        >L>   "call zsub"
err>        >>>   "call zsub"
err>      2 *-* call zsub
err>      4 *-*   zsub:
err>      5 *-*   return 7
err>        >L>     "7"
err>        >>>     "7"
err>        >>>   "7"
err>      3 *-* exit

# a CALL ON handler delivered at the calling clause's own boundary
# The callee raises with RETURN, so the caller resumes and the trap is queued;
# `sigl` reports the CALL's own line, which is what says the handler ran at that
# clause's boundary rather than inside the callee or at the next clause.
program
call on user foo name uh
zmark = 'NOMARK'
call zsub
say 'after call mark=' zmark 'result=' result
exit
zsub:
raise user foo return 'SV'
uh:
zmark = 'HANDLER-AT' sigl
return
----
rc> 0
out> after call mark= HANDLER-AT 3 result= SV

# a ::ROUTINE reached by CALL and as a function
program
call zrtn 3
say 'result=' result
say zrtn(4)
exit
::routine zrtn
use arg zn
return zn * 2
----
rc> 0
out> result= 6
out> 8

# a builtin reached by CALL and as a function
program
call length 'abc'
say result
say length('abc')
----
rc> 0
out> 3
out> 3

# the same two under trace i
# **The row that separates the routes' trace.** Both emit `>A>` for the one
# argument, from the same argument loop; only the function form emits `>F>`, and
# only the CALL form emits the `>>>` its RESULT settle traces.
program
trace i
call length 'abc'
say result
say length('abc')
----
rc> 0
out> 3
out> 3
err>      2 *-* call length 'abc'
err>        >L>   "abc"
err>        >A>   "abc"
err>        >>>   "3"
err>      3 *-* say result
err>        >V>   RESULT => "3"
err>        >>>   "3"
err>      4 *-* say length('abc')
err>        >L>   "abc"
err>        >A>   "abc"
err>        >F>   LENGTH => "3"
err>        >>>   "3"

# a PROCEDURE EXPOSE callee
# The callee's PROCEDURE is its first instruction, so the permission the calling
# clause granted has to survive the call and be spent inside the callee.
program
zg = 'global'
zl = 'local'
call zsub
say 'after' zg zl
exit
zsub:
procedure expose zg
say 'in sub' zg
zg = 'changed'
zl = 'shadow'
return
----
rc> 0
out> in sub global
out> after changed local

# arguments under trace i, one of them omitted
# **The order row.** Each argument's own value lines precede its `>A>`, and an
# omitted position traces an empty `>A>` rather than no line, holding its place
# in the list.
program
trace i
zx = 2
call zsub zx + 1, , 'q'
exit
zsub:
return 5
----
rc> 0
err>      2 *-* zx = 2
err>        >L>   "2"
err>        >>>   "2"
err>        >=>   ZX <= "2"
err>      3 *-* call zsub zx + 1, , 'q'
err>        >V>   ZX => "2"
err>        >L>   "1"
err>        >O>   "+" => "3"
err>        >A>   "3"
err>        >A>   ""
err>        >L>   "q"
err>        >A>   "q"
err>      5 *-*   zsub:
err>      6 *-*   return 5
err>        >L>     "5"
err>        >>>     "5"
err>        >>>   "5"
err>      4 *-* exit

# the same call under trace r
# **The negative direction.** `>A>` and the argument's own value lines are gated
# on intermediates, so a call site that emitted them whenever it ran would add
# four lines here that the oracle does not print. The two `>>>` that remain are
# the callee's RETURN and the caller's RESULT, one value at two indents.
program
trace r
zx = 2
call zsub zx + 1
say 'done'
exit
zsub:
return 5
----
rc> 0
out> done
err>      2 *-* zx = 2
err>        >>>   "2"
err>      3 *-* call zsub zx + 1
err>      6 *-*   zsub:
err>      7 *-*   return 5
err>        >>>     "5"
err>        >>>   "5"
err>      4 *-* say 'done'
err>        >>>   "done"
err>      5 *-* exit

# a CALL inside a body entered while the setting was already in force
# **The row that reaches the compiled clause echo at all.** A chunk is compiled
# for the setting in force when its body is entered, so in every row above --
# where the `trace` clause is in the same body as the calls -- the chunk was
# compiled silent and the clause unit answers the setting at run time instead.
# Here the callee's body is entered under `trace i`, so its own `call zsub 7`
# clause carries the echo op that decides the `*-*` line below.
program
trace i
call zouter
exit
zouter:
call zsub 7
say 'outer got' result
return
zsub:
use arg zn
return zn + 1
----
rc> 0
out> outer got 8
err>      2 *-* call zouter
err>      4 *-*   zouter:
err>      5 *-*   call zsub 7
err>        >L>     "7"
err>        >A>     "7"
err>      8 *-*     zsub:
err>      9 *-*     use arg zn
err>        >>>       "7"
err>        >=>       ZN <= "7"
err>     10 *-*     return zn + 1
err>        >V>       ZN => "7"
err>        >L>       "1"
err>        >O>       "+" => "8"
err>        >>>       "8"
err>        >>>     "8"
err>      6 *-*   say 'outer got' result
err>        >L>     "outer got"
err>        >V>     RESULT => "8"
err>        >O>     " " => "outer got 8"
err>        >>>     "outer got 8"
err>      7 *-*   return
err>      3 *-* exit

