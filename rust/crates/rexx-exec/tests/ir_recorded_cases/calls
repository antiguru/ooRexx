# CALL (expr), whose target is a value rather than a spelling
# The value searches labels -- unlike CALL "name" -- and is not upcased on the
# way in, so the two forms pull in opposite directions from each other.
program
znm = 'ZSUB'
call (znm) 5
say result
exit
zsub:
use arg zn
return zn + 1
----
rc> 0
out> 6

# a recursive function call, one call site under many live activations
program
say zfact(5)
exit
zfact:
use arg zn
if zn <= 1 then return 1
return zn * zfact(zn - 1)
----
rc> 0
out> 120

