# Where a DO/LOOP header's clause boundaries fall, which is the axis a
# flattened header can get wrong and no shape case asks about.

# a call on handler queued by a TO expression
# The handler is queued while the header is being evaluated and has to run
# before the first body clause reads the variable it sets -- both passes print
# `set`. A header whose clause never ends would print `unset` twice.
program
call on user zx name h
zv = 'unset'
do i = 1 to raiser()
  say 'body' zv
end
say 'after' zv
exit
raiser:
raise user zx return 2
h:
zv = 'set'
return
----
rc> 0
out> body set
out> body set
out> after set

# a handler queued by a TO expression that queues again
# The premise a single boundary per construct gets wrong: `h` runs at the
# header's boundary and its own RAISE queues `zy`, which nothing at that same
# boundary delivers. SIGL 4 is the first body clause, so the second delivery is
# the *next* boundary rather than the header's own -- and a header that
# delivered both would report 3.
program
call on user zx name h
call on user zy name g
do i = 1 to raiser()
  nop
end
say 'after'
exit
raiser:
raise user zx return 1
h:
raise user zy return 1
g:
say 'G ran' sigl
return
----
rc> 0
out> G ran 4
out> after

# the same requeue with zero passes
# The row above with `raiser` returning 0 instead of 1, so the loop runs no
# pass and no body clause stands between the two deliveries. SIGL 6 names the
# `say` after the loop, not the `end` on line 5 and not the `do` on line 3, and
# `after` prints before `G ran 6` rather than after it. The row above, with one
# pass, reports `G ran 4` and prints it first, so it does not cover this shape.
program
call on user zx name h
call on user zy name g
do i = 1 to raiser()
  nop
end
say 'after'
exit
raiser:
raise user zx return 0
h:
raise user zy return 1
g:
say 'G ran' sigl
return
----
rc> 0
out> after
out> G ran 6

# a call on handler failing at a DO header's own boundary
# The failure the handler raises is attributed to the clause whose boundary ran
# it, which is the DO's own -- the defect one construct over was a promoted IF
# recording its own failure site but not its boundary's.
program
call on user zx name h
call on user zy name g
zv = 'unset'
zw = raiser()
do
say 'body'
end
say 'after' zv zw
exit
raiser:
raise user zx return 5
h:
zv = 'set'
raise user zy return 1
g:
say 'G ran' sigl
return
----
rc> 0
out> G ran 5
out> body
out> after set 5

# The `END`'s own boundary, which only a second requeue reaches. The first
# delivery is owed to the `do` on line 5 and the second to the `end` on line 6,
# so both land before the `say` that follows the block.
program
call on user zx name h
call on user zy name g
call on user zw name k
zn = raiser1()
do
end
say 'after' zn
exit
raiser1:
raise user zx return 5
h:
raise user zy return 1
g:
say 'G ran' sigl
raise user zw return 1
k:
say 'K ran' sigl
return
----
rc> 0
out> G ran 5
out> K ran 6
out> after 5

# The `DO UNTIL`, which runs the other way. The `UNTIL` test is the `END`'s own
# clause and takes the first delivery at line 6; the requeue is owed to the
# `say` on line 7, so that line prints before its handler rather than after.
program
call on user zx name h
call on user zy name g
zv = 'unset'
do until raiser1() > 0
nop
end
say 'after' zv
exit
raiser1:
raise user zx return 5
h:
say 'H ran' sigl
zv = 'set'
raise user zy return 1
g:
say 'G ran' sigl
return
----
rc> 0
out> H ran 6
out> after set
out> G ran 7

