# The oracle's own build of librxregexp.so, copied into the run directory
# under another name between the program's two asks; the run directory is on
# the search path so that the second ask can find the copy.
LD_LIBRARY_PATH={oraclelib}:{run}
RETRY_FROM={oraclelib}/librxregexp.so
RETRY_TO={run}/libyyregexp.so
