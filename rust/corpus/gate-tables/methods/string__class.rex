/* Table C method rows: String, class arm -- .String~hasMethod("M") for
   every method corpus/docs/class-methods.txt documents on this arm,
   one line per row and in the row set's own order. Derived by
   crates/rexx-exec/tests/gate_table_c.rs, which re-derives this file on
   every run and compares it in both directions. */
say 'class' .String~hasMethod("new")
say 'class' .String~hasMethod("alnum")
say 'class' .String~hasMethod("alpha")
say 'class' .String~hasMethod("blank")
say 'class' .String~hasMethod("cntrl")
say 'class' .String~hasMethod("cr")
say 'class' .String~hasMethod("digit")
say 'class' .String~hasMethod("graph")
say 'class' .String~hasMethod("lower")
say 'class' .String~hasMethod("nl")
say 'class' .String~hasMethod("null")
say 'class' .String~hasMethod("print")
say 'class' .String~hasMethod("punct")
say 'class' .String~hasMethod("space")
say 'class' .String~hasMethod("tab")
say 'class' .String~hasMethod("upper")
say 'class' .String~hasMethod("xdigit")
