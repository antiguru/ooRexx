/* Table C method rows: RexxInfo, instance arm -- one line per method
   corpus/docs/class-methods.txt documents on this arm, asked of the
   instance `.RexxInfo` answers, in the row set's own order. That
   expression is corpus/docs/class-set.txt's committed construction
   program for this class, and carrying one is what `covered` claims.
   Derived by crates/rexx-exec/tests/gate_table_c.rs, which re-derives
   this file on every run and compares it in both directions. */
o = .RexxInfo
say 'instance' o~hasMethod("architecture")
say 'instance' o~hasMethod("caseSensitiveFiles")
say 'instance' o~hasMethod("date")
say 'instance' o~hasMethod("debug")
say 'instance' o~hasMethod("digits")
say 'instance' o~hasMethod("directorySeparator")
say 'instance' o~hasMethod("endofline")
say 'instance' o~hasMethod("executable")
say 'instance' o~hasMethod("form")
say 'instance' o~hasMethod("fuzz")
say 'instance' o~hasMethod("internalDigits")
say 'instance' o~hasMethod("internalMaxNumber")
say 'instance' o~hasMethod("internalMinNumber")
say 'instance' o~hasMethod("languageLevel")
say 'instance' o~hasMethod("libraryPath")
say 'instance' o~hasMethod("majorVersion")
say 'instance' o~hasMethod("maxArraySize")
say 'instance' o~hasMethod("maxExponent")
say 'instance' o~hasMethod("maxPathLength")
say 'instance' o~hasMethod("minExponent")
say 'instance' o~hasMethod("modification")
say 'instance' o~hasMethod("name")
say 'instance' o~hasMethod("package")
say 'instance' o~hasMethod("pathSeparator")
say 'instance' o~hasMethod("platform")
say 'instance' o~hasMethod("release")
say 'instance' o~hasMethod("revision")
say 'instance' o~hasMethod("version")
