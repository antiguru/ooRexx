+        Ok(vec![
+            Tag::Symbol,
+            Tag::Blank,
+            Tag::Symbol,
+            Tag::Eoc,
+            Tag::Symbol,
+            Tag::Blank,
+            Tag::Symbol,
+            Tag::Eoc
+        ])
+    );
