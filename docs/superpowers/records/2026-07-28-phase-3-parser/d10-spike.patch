+
+//! The AST and error type both spike arms produce.
+//!
+//! Shared so that the two arms are compared on how hard they were to write,
+//! not on what they emitted.
+
+use crate::token::{Loc, Op};
+
+/// What a symbol token turned out to denote.
+///
+/// The classification is positional in Rexx and cannot live in the scanner: a
+/// bare `IF` is a variable here and a keyword at the head of a clause.
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub enum Symbol {
+    /// A numeric constant, kept as written because `1.50` prints as `1.50`.
+    Number(String),
+    /// A simple variable.
+    Simple(String),
+    /// A stem, meaning a name ending in a single trailing period.
+    Stem(String),
+    /// A compound variable: a stem plus one tail element per period.
+    Compound { stem: String, tails: Vec<String> },
+    /// An environment symbol, meaning a name with a leading period.
+    Environment(String),
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum UnOp {
+    Plus,
+    Minus,
+    Not,
+}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub enum Expr {
+    Literal(String),
+    Symbol(Symbol),
+    Unary(UnOp, Box<Expr>),
+    Binary(Op, Box<Expr>, Box<Expr>),
+    /// `NAME(...)`, with no blank before the parenthesis.
+    Call { name: String, args: Vec<Option<Expr>> },
+    /// `target~name(...)` or `target~~name(...)`.
+    Message {
+        target: Box<Expr>,
+        name: String,
+        args: Vec<Option<Expr>>,
+        cascade: bool,
+    },
+    /// `target[...]`, which is a `[]` message.
+    Index {
+        target: Box<Expr>,
+        args: Vec<Option<Expr>>,
+    },
+    /// A parenthesised comma list, which builds an array.
+    List(Vec<Option<Expr>>),
+}
+
+impl Expr {
+    /// A canonical parenthesised rendering, used to compare an arm's output
+    /// against the shape the oracle's evaluated answer implies.
+    pub fn render(&self) -> String {
+        match self {
+            Expr::Literal(s) => format!("'{s}'"),
+            Expr::Symbol(Symbol::Number(s)) => s.clone(),
+            Expr::Symbol(Symbol::Simple(s)) => s.clone(),
+            Expr::Symbol(Symbol::Stem(s)) => format!("stem:{s}"),
+            Expr::Symbol(Symbol::Compound { stem, tails }) => {
+                format!("compound:{stem}[{}]", tails.join(","))
+            }
+            Expr::Symbol(Symbol::Environment(s)) => format!("env:{s}"),
+            Expr::Unary(op, e) => {
+                let name = match op {
+                    UnOp::Plus => "u+",
+                    UnOp::Minus => "u-",
+                    UnOp::Not => "u\\",
+                };
+                format!("({name} {})", e.render())
+            }
+            Expr::Binary(op, l, r) => {
+                let name = match op {
+                    Op::Abuttal => "abut",
+                    Op::Blank => "blank",
+                    other => other.spelling(),
+                };
+                format!("({name} {} {})", l.render(), r.render())
+            }
+            Expr::Call { name, args } => format!("(call {name}{})", render_args(args)),
+            Expr::Message {
+                target,
+                name,
+                args,
+                cascade,
+            } => {
+                let twiddle = if *cascade { "~~" } else { "~" };
+                format!(
+                    "(msg{twiddle} {} {name}{})",
+                    target.render(),
+                    render_args(args)
+                )
+            }
+            Expr::Index { target, args } => {
+                format!("(index {}{})", target.render(), render_args(args))
+            }
+            Expr::List(args) => format!("(list{})", render_args(args)),
+        }
+    }
+}
+
+fn render_args(args: &[Option<Expr>]) -> String {
+    let mut out = String::new();
+    for a in args {
+        out.push(' ');
+        match a {
+            Some(e) => out.push_str(&e.render()),
+            None => out.push('_'),
+        }
+    }
+    out
+}
+
+/// A syntax error, carrying everything the oracle's message needs.
+///
+/// `major` and `sub` are the two numbers a program can trap on, and `subs` are
+/// the substitution values the message text interpolates. `loc` is the offending
+/// token's own location, which is where errors 36.901 and 36.902 get their
+/// position and line from.
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct ParseError {
+    pub major: u16,
+    pub sub: u16,
+    pub subs: Vec<String>,
+    pub loc: Loc,
+}
+
+impl ParseError {
+    pub fn at(major: u16, sub: u16, subs: Vec<String>, loc: Loc) -> Self {
+        ParseError {
+            major,
+            sub,
+            subs,
+            loc,
+        }
+    }
+
+    /// The error as `major.sub` plus substitutions, in the order the message
+    /// text uses them. This is the string the fidelity axis compares.
+    pub fn signature(&self) -> String {
+        format!("{}.{} [{}]", self.major, self.sub, self.subs.join("|"))
+    }
+}
+
+/// One instruction in a code body.
+///
+/// Step 3b's decision, made concrete: instructions form a **chain**, and the
+/// chain is flattened into one arena `Vec` per code body with `next` as an
+/// index. Nesting lives in the indices a block instruction holds, not in owned
+/// children, which is what lets `THEN`, `ELSE`, `OTHERWISE`, `WHEN` and `END`
+/// each stay an instruction with its own `clause_span`.
+#[derive(Clone, Debug)]
+pub struct Instruction {
+    pub kind: InstructionKind,
+    /// The byte range of the clause this instruction came from, which is what
+    /// `trace` echoes after the `*-*` marker.
+    pub clause_span: (usize, usize),
+    /// The next instruction in source order, or `None` at the end of the body.
+    pub next: Option<InstructionId>,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub struct InstructionId(pub u32);
+
+/// A stand-in for the 35 real instruction kinds, holding only the five that
+/// Step 3b constrains plus enough others to show the shape works.
+#[derive(Clone, Debug)]
+pub enum InstructionKind {
+    Say(Option<Expr>),
+    Assignment { target: Symbol, value: Expr },
+    If { condition: Expr, then_part: InstructionId },
+    /// Its own instruction, never absorbed into `If`, because the oracle traces
+    /// it as a separate `*-*` clause (`ThenInstruction.cpp:76`).
+    Then { body: InstructionId },
+    Else { body: InstructionId },
+    Select { end: InstructionId },
+    When { condition: Expr, then_part: InstructionId },
+    Otherwise { body: Option<InstructionId> },
+    End,
+}
+
+/// One code body: a `::method`, a `::routine`, or the main program.
+///
+/// The arena half of D13. Every instruction lives in this one `Vec`, and every
+/// reference between instructions is an index into it.
+#[derive(Clone, Debug, Default)]
+pub struct CodeBody {
+    pub instructions: Vec<Instruction>,
+    pub first: Option<InstructionId>,
+}
