+
+//! A minimal evaluator, shared by both arms.
+//!
+//! Its only job is to turn an AST back into the string the oracle printed, so
+//! that each arm is checked against `build/bin/rexx` rather than against the
+//! other arm. It covers operators, symbols and the handful of calls the corpus
+//! uses; anything object-related returns `Unsupported`, and those corpus cases
+//! are checked on their rendered shape instead.
+
+use rexx_num::{CompareOp, DivOp, Number};
+
+use crate::ast::{Expr, Symbol, UnOp};
+use crate::token::Op;
+
+/// NUMERIC DIGITS 9, the default the corpus runs under.
+const DIGITS: u64 = 9;
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum EvalError {
+    /// The AST uses something outside this evaluator's subset.
+    Unsupported,
+}
+
+/// Looks a variable up the way the corpus programs set them.
+///
+/// An unset simple variable evaluates to its own name in upper case, which is
+/// how `f (1)` becomes `F 1`.
+fn lookup(name: &str) -> String {
+    match name {
+        "A" => "2".to_string(),
+        "B" => "3".to_string(),
+        "C" => "4".to_string(),
+        "P" => "x".to_string(),
+        "Q" => "y".to_string(),
+        "R" => "z".to_string(),
+        "X" => "2".to_string(),
+        "AA" => "2".to_string(),
+        "BB" => "2".to_string(),
+        "CC" => "1".to_string(),
+        "I" => "1".to_string(),
+        "J" => "2".to_string(),
+        other => other.to_string(),
+    }
+}
+
+fn compound(stem: &str, tails: &[String]) -> String {
+    // Tail elements are variable values when they are symbols, and the literal
+    // digits when they are numbers.
+    let resolved: Vec<String> = tails
+        .iter()
+        .map(|t| {
+            if t.starts_with(|c: char| c.is_ascii_digit()) {
+                t.clone()
+            } else {
+                lookup(t)
+            }
+        })
+        .collect();
+    let key = format!("{stem}{}", resolved.join("."));
+    match key.as_str() {
+        "S.1" => "one".to_string(),
+        "S.2" => "two".to_string(),
+        "N.1.2" => "nested".to_string(),
+        other => other.to_string(),
+    }
+}
+
+fn number(text: &str) -> Result<Number, EvalError> {
+    Number::parse(text.trim()).ok_or(EvalError::Unsupported)
+}
+
+fn arith(op: Op, l: &str, r: &str) -> Result<String, EvalError> {
+    let a = number(l)?;
+    let b = number(r)?;
+    let out = match op {
+        Op::Plus => a.add(&b, DIGITS),
+        Op::Subtract => a.sub(&b, DIGITS),
+        Op::Multiply => a.mul(&b, DIGITS),
+        Op::Divide => a.div(&b, DIGITS, DivOp::Divide),
+        Op::IntDiv => a.div(&b, DIGITS, DivOp::IntegerDivide),
+        Op::Remainder => a.div(&b, DIGITS, DivOp::Remainder),
+        Op::Power => a.pow(&b, DIGITS),
+        _ => return Err(EvalError::Unsupported),
+    };
+    Ok(out.map_err(|_| EvalError::Unsupported)?.format(DIGITS))
+}
+
+/// Delegates the whole comparison family to `rexx_num`, which already
+/// implements the blank stripping and the strict/loose split.
+fn compare(op: CompareOp, l: &str, r: &str) -> Result<String, EvalError> {
+    let out = rexx_num::compare(l, r, DIGITS, 0, op).map_err(|_| EvalError::Unsupported)?;
+    Ok(boolean(out))
+}
+
+fn boolean(b: bool) -> String {
+    if b { "1".to_string() } else { "0".to_string() }
+}
+
+fn truthy(s: &str) -> Result<bool, EvalError> {
+    match s.trim() {
+        "1" => Ok(true),
+        "0" => Ok(false),
+        _ => Err(EvalError::Unsupported),
+    }
+}
+
+pub fn eval(e: &Expr) -> Result<String, EvalError> {
+    match e {
+        Expr::Literal(s) => Ok(s.clone()),
+        Expr::Symbol(Symbol::Number(s)) => Ok(s.clone()),
+        Expr::Symbol(Symbol::Simple(s)) => Ok(lookup(s)),
+        Expr::Symbol(Symbol::Compound { stem, tails }) => Ok(compound(stem, tails)),
+        Expr::Symbol(Symbol::Stem(_)) | Expr::Symbol(Symbol::Environment(_)) => {
+            Err(EvalError::Unsupported)
+        }
+        Expr::Unary(op, inner) => {
+            let v = eval(inner)?;
+            match op {
+                UnOp::Plus => arith(Op::Plus, "0", &v),
+                UnOp::Minus => arith(Op::Subtract, "0", &v),
+                UnOp::Not => Ok(boolean(!truthy(&v)?)),
+            }
+        }
+        Expr::Binary(op, l, r) => {
+            let a = eval(l)?;
+            let b = eval(r)?;
+            match op {
+                Op::Abuttal | Op::Concatenate => Ok(format!("{a}{b}")),
+                Op::Blank => Ok(format!("{a} {b}")),
+                Op::Plus
+                | Op::Subtract
+                | Op::Multiply
+                | Op::Divide
+                | Op::IntDiv
+                | Op::Remainder
+                | Op::Power => arith(*op, &a, &b),
+                Op::Equal => compare(CompareOp::Equal, &a, &b),
+                Op::BackslashEqual => compare(CompareOp::NotEqual, &a, &b),
+                Op::LessGreater | Op::GreaterLess => compare(CompareOp::NotEqual, &a, &b),
+                Op::GreaterThan => compare(CompareOp::Greater, &a, &b),
+                Op::LessThan => compare(CompareOp::Less, &a, &b),
+                Op::GreaterEqual => compare(CompareOp::GreaterEqual, &a, &b),
+                Op::LessEqual => compare(CompareOp::LessEqual, &a, &b),
+                Op::BackslashGreaterThan => compare(CompareOp::LessEqual, &a, &b),
+                Op::BackslashLessThan => compare(CompareOp::GreaterEqual, &a, &b),
+                Op::StrictEqual => compare(CompareOp::StrictEqual, &a, &b),
+                Op::StrictBackslashEqual => compare(CompareOp::StrictNotEqual, &a, &b),
+                Op::StrictGreaterThan => compare(CompareOp::StrictGreater, &a, &b),
+                Op::StrictLessThan => compare(CompareOp::StrictLess, &a, &b),
+                Op::StrictGreaterEqual => compare(CompareOp::StrictGreaterEqual, &a, &b),
+                Op::StrictLessEqual => compare(CompareOp::StrictLessEqual, &a, &b),
+                Op::And => Ok(boolean(truthy(&a)? && truthy(&b)?)),
+                Op::Or => Ok(boolean(truthy(&a)? || truthy(&b)?)),
+                Op::Xor => Ok(boolean(truthy(&a)? != truthy(&b)?)),
+                Op::Backslash => Err(EvalError::Unsupported),
+            }
+        }
+        Expr::Call { name, args } => call(name, args),
+        Expr::Message { .. } | Expr::Index { .. } | Expr::List(_) => Err(EvalError::Unsupported),
+    }
+}
+
+/// The four callables the corpus uses. `F` and `G` are the corpus's own
+/// `::routine`s.
+fn call(name: &str, args: &[Option<Expr>]) -> Result<String, EvalError> {
+    let mut values = Vec::new();
+    for a in args {
+        match a {
+            Some(e) => values.push(eval(e)?),
+            None => return Err(EvalError::Unsupported),
+        }
+    }
+    match (name, values.len()) {
+        ("F", 1) => Ok(format!("R{}", values[0])),
+        ("G", 1) => arith(Op::Plus, &values[0], "10"),
+        ("ABS", 1) => {
+            let n = number(&values[0])?;
+            let text = n.format(DIGITS);
+            Ok(text.strip_prefix('-').unwrap_or(&text).to_string())
+        }
+        ("LENGTH", 1) => Ok(values[0].len().to_string()),
+        _ => Err(EvalError::Unsupported),
+    }
+}
diff --git a/rust/crates/rexx-parse-spike/src/hand.rs b/rust/crates/rexx-parse-spike/src/hand.rs
