--- /dev/null
+++ b/rust/crates/rexx-parse-spike/src/token.rs
@@ -0,0 +1,636 @@
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* Copyright (c) 2026 Rexx Language Association. All rights reserved.          */
+/*                                                                            */
+/* This program and the accompanying materials are made available under       */
+/* the terms of the Common Public License v1.0 which accompanies this         */
+/* distribution. A copy is also available at the following address:           */
+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+
+//! The token stream both spike arms parse.
+//!
+//! This is written once and shared, so the D10 comparison measures the layer
+//! above the tokens and nothing else.
+
+use crate::ast::ParseError;
+
+/// A token's extent in the source.
+///
+/// `offset` is a 0-based **byte** offset within its own physical line, and
+/// `line` is 1-based. Error 36.901 substitutes `offset + 1` and `line`
+/// (`LanguageParser::errorPosition`, `LanguageParser.cpp:4114`), and the
+/// oracle counts bytes rather than characters: `x = "ää" || (a` reports
+/// position 15, where the `(` is the 13th character but the 15th byte.
+#[derive(Copy, Clone, PartialEq, Eq, Debug, Default)]
+pub struct Loc {
+    pub start_line: usize,
+    pub start_offset: usize,
+    pub end_line: usize,
+    pub end_offset: usize,
+}
+
+/// A dyadic or prefix operator.
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum Op {
+    Or,
+    Xor,
+    And,
+    Equal,
+    BackslashEqual,
+    GreaterThan,
+    BackslashGreaterThan,
+    LessThan,
+    BackslashLessThan,
+    GreaterEqual,
+    LessEqual,
+    StrictEqual,
+    StrictBackslashEqual,
+    StrictGreaterThan,
+    StrictLessThan,
+    StrictGreaterEqual,
+    StrictLessEqual,
+    LessGreater,
+    GreaterLess,
+    Abuttal,
+    Concatenate,
+    Blank,
+    Plus,
+    Subtract,
+    Multiply,
+    Divide,
+    IntDiv,
+    Remainder,
+    Power,
+    Backslash,
+}
+
+impl Op {
+    /// The binding power, straight from `RexxToken::precedence`
+    /// (`Token.cpp:111`). Higher binds tighter.
+    pub fn precedence(self) -> u8 {
+        match self {
+            Op::Or | Op::Xor => 1,
+            Op::And => 2,
+            Op::Equal
+            | Op::BackslashEqual
+            | Op::GreaterThan
+            | Op::BackslashGreaterThan
+            | Op::LessThan
+            | Op::BackslashLessThan
+            | Op::GreaterEqual
+            | Op::LessEqual
+            | Op::StrictEqual
+            | Op::StrictBackslashEqual
+            | Op::StrictGreaterThan
+            | Op::StrictLessThan
+            | Op::StrictGreaterEqual
+            | Op::StrictLessEqual
+            | Op::LessGreater
+            | Op::GreaterLess => 3,
+            Op::Abuttal | Op::Concatenate | Op::Blank => 4,
+            Op::Plus | Op::Subtract => 5,
+            Op::Multiply | Op::Divide | Op::IntDiv | Op::Remainder => 6,
+            Op::Power => 7,
+            Op::Backslash => 8,
+        }
+    }
+
+    /// The spelling the oracle quotes back in error 35.1.
+    ///
+    /// `x = a %% b` reports `"%"`, not `"%%"`, because the scanner had already
+    /// split the second `%` into its own token.
+    pub fn spelling(self) -> &'static str {
+        match self {
+            Op::Or => "|",
+            Op::Xor => "&&",
+            Op::And => "&",
+            Op::Equal => "=",
+            Op::BackslashEqual => "\\=",
+            Op::GreaterThan => ">",
+            Op::BackslashGreaterThan => "\\>",
+            Op::LessThan => "<",
+            Op::BackslashLessThan => "\\<",
+            Op::GreaterEqual => ">=",
+            Op::LessEqual => "<=",
+            Op::StrictEqual => "==",
+            Op::StrictBackslashEqual => "\\==",
+            Op::StrictGreaterThan => ">>",
+            Op::StrictLessThan => "<<",
+            Op::StrictGreaterEqual => ">>=",
+            Op::StrictLessEqual => "<<=",
+            Op::LessGreater => "<>",
+            Op::GreaterLess => "><",
+            Op::Abuttal => "",
+            Op::Concatenate => "||",
+            Op::Blank => " ",
+            Op::Plus => "+",
+            Op::Subtract => "-",
+            Op::Multiply => "*",
+            Op::Divide => "/",
+            Op::IntDiv => "%",
+            Op::Remainder => "//",
+            Op::Power => "**",
+            Op::Backslash => "\\",
+        }
+    }
+}
+
+/// What a token is.
+///
+/// `Blank` exists as a token of its own because that is how the oracle keeps
+/// `f(x)` and `f (x)` apart: the scanner emits it only when the following real
+/// character can start a term (`Scanner.cpp:754`), and the parser above never
+/// skips it. Every whitespace question in D10 is settled here rather than in
+/// either arm.
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub enum Kind {
+    /// A symbol: variable, number, environment symbol, compound or stem name.
+    /// The value is already upper-cased, as the oracle upper-cases symbols.
+    Symbol(String),
+    /// A quoted literal, with quote doubling resolved and any `x`/`b` suffix
+    /// already decoded.
+    Literal(String),
+    Blank,
+    Operator(Op),
+    Tilde,
+    DTilde,
+    LeftParen,
+    RightParen,
+    SqLeft,
+    SqRight,
+    Comma,
+    Colon,
+    /// End of clause.
+    Eoc,
+}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct Token {
+    pub kind: Kind,
+    pub loc: Loc,
+}
+
+impl Token {
+    pub fn is_symbol(&self) -> bool {
+        matches!(self.kind, Kind::Symbol(_))
+    }
+
+    pub fn is_literal(&self) -> bool {
+        matches!(self.kind, Kind::Literal(_))
+    }
+
+    /// True for the three tokens that continue a message cascade.
+    pub fn is_message_operator(&self) -> bool {
+        matches!(self.kind, Kind::Tilde | Kind::DTilde | Kind::SqLeft)
+    }
+
+    /// True when this token can begin a term, which is the condition under
+    /// which an abuttal operator is synthesised in operator position.
+    pub fn starts_term(&self) -> bool {
+        matches!(
+            self.kind,
+            Kind::Symbol(_) | Kind::Literal(_) | Kind::LeftParen
+        )
+    }
+
+    pub fn text(&self) -> String {
+        match &self.kind {
+            Kind::Symbol(s) => s.clone(),
+            Kind::Literal(s) => s.clone(),
+            Kind::Blank => " ".to_string(),
+            Kind::Operator(op) => op.spelling().to_string(),
+            Kind::Tilde => "~".to_string(),
+            Kind::DTilde => "~~".to_string(),
+            Kind::LeftParen => "(".to_string(),
+            Kind::RightParen => ")".to_string(),
+            Kind::SqLeft => "[".to_string(),
+            Kind::SqRight => "]".to_string(),
+            Kind::Comma => ",".to_string(),
+            Kind::Colon => ":".to_string(),
+            Kind::Eoc => "".to_string(),
+        }
+    }
+}
+
+fn is_symbol_start(b: u8) -> bool {
+    b.is_ascii_alphabetic() || b.is_ascii_digit() || matches!(b, b'.' | b'_' | b'!' | b'?')
+}
+
+fn is_symbol_char(b: u8) -> bool {
+    is_symbol_start(b)
+}
+
+/// Scans one clause's worth of source into tokens.
+///
+/// The scanner tracks physical lines so that every token's `Loc` names the
+/// line and byte offset the oracle would report, including across a comma
+/// continuation, where the reported line is the token's own physical line and
+/// not the clause's first line.
+struct Scanner<'a> {
+    src: &'a [u8],
+    pos: usize,
+    /// Byte offset at which the current physical line starts.
+    line_start: usize,
+    line: usize,
+}
+
+impl<'a> Scanner<'a> {
+    fn new(src: &'a str) -> Self {
+        Scanner {
+            src: src.as_bytes(),
+            pos: 0,
+            line_start: 0,
+            line: 1,
+        }
+    }
+
+    fn peek(&self) -> Option<u8> {
+        self.src.get(self.pos).copied()
+    }
+
+    fn at(&self, n: usize) -> Option<u8> {
+        self.src.get(self.pos + n).copied()
+    }
+
+    fn loc_here(&self, len: usize) -> Loc {
+        Loc {
+            start_line: self.line,
+            start_offset: self.pos - self.line_start,
+            end_line: self.line,
+            end_offset: self.pos - self.line_start + len,
+        }
+    }
+
+    fn newline(&mut self) {
+        self.pos += 1;
+        self.line += 1;
+        self.line_start = self.pos;
+    }
+
+    /// Consumes whitespace and comments, returning true if anything at all was
+    /// skipped. A `--` line comment runs to the end of the line, which is why
+    /// `1 --1` is `1` and not `2`.
+    fn skip_trivia(&mut self) -> Result<bool, ParseError> {
+        let mut skipped = false;
+        loop {
+            match self.peek() {
+                Some(b' ') | Some(b'\t') => {
+                    self.pos += 1;
+                    skipped = true;
+                }
+                Some(b'/') if self.at(1) == Some(b'*') => {
+                    let open = self.loc_here(2);
+                    self.pos += 2;
+                    let mut depth = 1usize;
+                    loop {
+                        match self.peek() {
+                            None => {
+                                return Err(ParseError::at(6, 1, vec![], open));
+                            }
+                            Some(b'\n') => self.newline(),
+                            Some(b'*') if self.at(1) == Some(b'/') => {
+                                self.pos += 2;
+                                depth -= 1;
+                                if depth == 0 {
+                                    break;
+                                }
+                            }
+                            Some(b'/') if self.at(1) == Some(b'*') => {
+                                self.pos += 2;
+                                depth += 1;
+                            }
+                            Some(_) => self.pos += 1,
+                        }
+                    }
+                    skipped = true;
+                }
+                Some(b'-') if self.at(1) == Some(b'-') => {
+                    while !matches!(self.peek(), None | Some(b'\n')) {
+                        self.pos += 1;
+                    }
+                    skipped = true;
+                }
+                _ => return Ok(skipped),
+            }
+        }
+    }
+
+    /// True when the character at the cursor can start a term, which is the
+    /// oracle's test for a blank being significant.
+    fn at_term_start(&self) -> bool {
+        match self.peek() {
+            Some(b) => is_symbol_start(b) || matches!(b, b'"' | b'\'' | b'(' | b'['),
+            None => false,
+        }
+    }
+
+    fn scan_symbol(&mut self) -> Token {
+        let start = self.pos;
+        let start_offset = self.pos - self.line_start;
+        while matches!(self.peek(), Some(b) if is_symbol_char(b)) {
+            self.pos += 1;
+        }
+        // A number may carry an exponent, whose sign is part of the symbol
+        // even though `+`/`-` are not symbol characters.
+        let text = &self.src[start..self.pos];
+        let mut end = self.pos;
+        if text.first().is_some_and(u8::is_ascii_digit)
+            && matches!(text.last(), Some(b'e') | Some(b'E'))
+            && matches!(self.peek(), Some(b'+') | Some(b'-'))
+            && self.at(1).is_some_and(|b| b.is_ascii_digit())
+        {
+            self.pos += 1;
+            while matches!(self.peek(), Some(b) if b.is_ascii_digit()) {
+                self.pos += 1;
+            }
+            end = self.pos;
+        }
+        let value = String::from_utf8_lossy(&self.src[start..end]).to_uppercase();
+        Token {
+            kind: Kind::Symbol(value),
+            loc: Loc {
+                start_line: self.line,
+                start_offset,
+                end_line: self.line,
+                end_offset: end - self.line_start,
+            },
+        }
+    }
+
+    fn scan_literal(&mut self) -> Result<Token, ParseError> {
+        let quote = self.peek().expect("caller checked for a quote");
+        let open = self.loc_here(1);
+        let start_offset = self.pos - self.line_start;
+        self.pos += 1;
+        let mut value = Vec::new();
+        loop {
+            match self.peek() {
+                None | Some(b'\n') => {
+                    let sub = if quote == b'\'' { 2 } else { 3 };
+                    return Err(ParseError::at(6, sub, vec![], open));
+                }
+                Some(b) if b == quote => {
+                    if self.at(1) == Some(quote) {
+                        value.push(quote);
+                        self.pos += 2;
+                    } else {
+                        self.pos += 1;
+                        break;
+                    }
+                }
+                Some(b) => {
+                    value.push(b);
+                    self.pos += 1;
+                }
+            }
+        }
+        // A single `x` or `b` immediately after the closing quote makes the
+        // literal hexadecimal or binary. This is why `a''b` is `a` abutted
+        // with an empty binary literal and never reads the variable `b`.
+        let mut kind = 0u8;
+        if matches!(self.peek(), Some(b'x') | Some(b'X') | Some(b'b') | Some(b'B'))
+            && !self.at(1).is_some_and(is_symbol_char)
+        {
+            kind = self.peek().expect("just matched").to_ascii_lowercase();
+            self.pos += 1;
+        }
+        let text = String::from_utf8_lossy(&value).to_string();
+        let decoded = match kind {
+            b'x' => decode_hex(&text),
+            b'b' => decode_binary(&text),
+            _ => text,
+        };
+        Ok(Token {
+            kind: Kind::Literal(decoded),
+            loc: Loc {
+                start_line: self.line,
+                start_offset,
+                end_line: self.line,
+                end_offset: self.pos - self.line_start,
+            },
+        })
+    }
+
+    /// Consumes a continuation and the line break after it, repeatedly.
+    ///
+    /// Both `,` and `-` continue a clause (`Scanner.cpp:307`), and a `-` at end
+    /// of line is therefore not a subtraction: `x = 5 -` then `3` on the next
+    /// line yields `5 3`, the blank operator, not `2`. Returns true if at least
+    /// one was consumed, because a continuation counts as a blank for the
+    /// significant-blank test.
+    fn skip_continuation(&mut self) -> Result<bool, ParseError> {
+        let mut any = false;
+        loop {
+            if !matches!(self.peek(), Some(b',') | Some(b'-')) {
+                return Ok(any);
+            }
+            // Look past trivia for a line break. Without one this is a real
+            // comma, an argument separator, and must not be swallowed.
+            let mark_pos = self.pos;
+            let mark_line = self.line;
+            let mark_start = self.line_start;
+            self.pos += 1;
+            self.skip_trivia()?;
+            if self.peek() == Some(b'\n') {
+                self.newline();
+                self.skip_trivia()?;
+                any = true;
+            } else {
+                self.pos = mark_pos;
+                self.line = mark_line;
+                self.line_start = mark_start;
+                return Ok(any);
+            }
+        }
+    }
+
+    fn simple(&mut self, len: usize, kind: Kind) -> Token {
+        let loc = self.loc_here(len);
+        self.pos += len;
+        Token { kind, loc }
+    }
+}
+
+fn decode_hex(text: &str) -> String {
+    let digits: String = text.chars().filter(|c| !c.is_whitespace()).collect();
+    let mut out = Vec::new();
+    let bytes = digits.as_bytes();
+    // Hex literals group from the right, so an odd count leaves a short first
+    // group rather than a short last one.
+    let lead = bytes.len() % 2;
+    let mut i = 0;
+    if lead == 1 {
+        out.push(hex_val(bytes[0]));
+        i = 1;
+    }
+    while i < bytes.len() {
+        out.push(hex_val(bytes[i]) * 16 + hex_val(bytes[i + 1]));
+        i += 2;
+    }
+    String::from_utf8_lossy(&out).to_string()
+}
+
+fn hex_val(b: u8) -> u8 {
+    match b {
+        b'0'..=b'9' => b - b'0',
+        b'a'..=b'f' => b - b'a' + 10,
+        b'A'..=b'F' => b - b'A' + 10,
+        _ => 0,
+    }
+}
+
+fn decode_binary(text: &str) -> String {
+    let digits: String = text.chars().filter(|c| !c.is_whitespace()).collect();
+    let bytes = digits.as_bytes();
+    let mut out = Vec::new();
+    let lead = bytes.len() % 8;
+    let mut i = 0;
+    if lead != 0 {
+        let mut v = 0u8;
+        for &b in &bytes[..lead] {
+            v = v * 2 + (b - b'0');
+        }
+        out.push(v);
+        i = lead;
+    }
+    while i < bytes.len() {
+        let mut v = 0u8;
+        for &b in &bytes[i..i + 8] {
+            v = v * 2 + (b - b'0');
+        }
+        out.push(v);
+        i += 8;
+    }
+    String::from_utf8_lossy(&out).to_string()
+}
+
+/// Tokenises one clause's expression, ending at end of input or end of line.
+///
+/// The result always ends with exactly one `Eoc` token, which both arms use as
+/// the outermost terminator.
+pub fn scan(src: &str) -> Result<Vec<Token>, ParseError> {
+    let mut sc = Scanner::new(src);
+    let mut out: Vec<Token> = Vec::new();
+    loop {
+        // Record where the run of trivia begins, because a significant blank
+        // takes its location from the first blank character rather than from
+        // the token that follows it.
+        let blank_loc = sc.loc_here(1);
+        let skipped = sc.skip_trivia()?;
+        // A trailing comma continues the clause onto the next line and is
+        // functionally a blank (`Scanner.cpp:340`). It is consumed rather than
+        // emitted, so the tokens after it report their own physical line.
+        let continued = sc.skip_continuation()?;
+        // A continuation with no leading blank has no blank character to point
+        // at, so the synthesised token points at the term that follows. No
+        // measured error reads a blank token's location, so this is the one
+        // place the spike does not match the oracle byte for byte.
+        let blank_loc = if skipped { blank_loc } else { sc.loc_here(0) };
+        let skipped = skipped || continued;
+        let blank_significant = out.last().is_some_and(Token::is_blank_significant);
+        if skipped && blank_significant && sc.at_term_start() {
+            out.push(Token {
+                kind: Kind::Blank,
+                loc: blank_loc,
+            });
+        }
+        let Some(b) = sc.peek() else { break };
+        // A bare newline ends the clause. Only a continuation crosses one, and
+        // that was already handled above.
+        if b == b'\n' {
+            break;
+        }
+        let tok = match b {
+            b'"' | b'\'' => sc.scan_literal()?,
+            _ if is_symbol_start(b) => sc.scan_symbol(),
+            b'(' => sc.simple(1, Kind::LeftParen),
+            b')' => sc.simple(1, Kind::RightParen),
+            b'[' => sc.simple(1, Kind::SqLeft),
+            b']' => sc.simple(1, Kind::SqRight),
+            b':' => sc.simple(1, Kind::Colon),
+            b',' => sc.simple(1, Kind::Comma),
+            b'~' if sc.at(1) == Some(b'~') => sc.simple(2, Kind::DTilde),
+            b'~' => sc.simple(1, Kind::Tilde),
+            _ => scan_operator(&mut sc),
+        };
+        out.push(tok);
+    }
+    out.push(Token {
+        kind: Kind::Eoc,
+        loc: sc.loc_here(0),
+    });
+    Ok(out)
+}
+
+impl Token {
+    /// True when a blank following this token could be the blank operator.
+    ///
+    /// Straight from `RexxToken::isBlankSignificant` (`Token.hpp:595`): only
+    /// four token classes can end a term, and a blank after anything else is
+    /// pure whitespace.
+    fn is_blank_significant(&self) -> bool {
+        matches!(
+            self.kind,
+            Kind::Symbol(_) | Kind::Literal(_) | Kind::RightParen | Kind::SqRight
+        )
+    }
+}
+
+fn scan_operator(sc: &mut Scanner<'_>) -> Token {
+    let two = (sc.peek(), sc.at(1));
+    let three = sc.at(2);
+    // Longest match first, since `\==` must not be read as `\=` then `=`.
+    if let (Some(a), Some(b)) = two {
+        if let Some(c) = three {
+            let op = match (a, b, c) {
+                (b'\\', b'=', b'=') | (b'^', b'=', b'=') => Some(Op::StrictBackslashEqual),
+                (b'>', b'>', b'=') => Some(Op::StrictGreaterEqual),
+                (b'<', b'<', b'=') => Some(Op::StrictLessEqual),
+                _ => None,
+            };
+            if let Some(op) = op {
+                return sc.simple(3, Kind::Operator(op));
+            }
+        }
+        let op = match (a, b) {
+            (b'*', b'*') => Some(Op::Power),
+            (b'/', b'/') => Some(Op::Remainder),
+            (b'|', b'|') => Some(Op::Concatenate),
+            (b'&', b'&') => Some(Op::Xor),
+            (b'=', b'=') => Some(Op::StrictEqual),
+            (b'\\', b'=') | (b'^', b'=') => Some(Op::BackslashEqual),
+            (b'\\', b'>') | (b'^', b'>') => Some(Op::BackslashGreaterThan),
+            (b'\\', b'<') | (b'^', b'<') => Some(Op::BackslashLessThan),
+            (b'>', b'=') => Some(Op::GreaterEqual),
+            (b'<', b'=') => Some(Op::LessEqual),
+            (b'>', b'<') => Some(Op::GreaterLess),
+            (b'<', b'>') => Some(Op::LessGreater),
+            (b'>', b'>') => Some(Op::StrictGreaterThan),
+            (b'<', b'<') => Some(Op::StrictLessThan),
+            _ => None,
+        };
+        if let Some(op) = op {
+            return sc.simple(2, Kind::Operator(op));
+        }
+    }
+    let op = match two.0 {
+        Some(b'+') => Op::Plus,
+        Some(b'-') => Op::Subtract,
+        Some(b'*') => Op::Multiply,
+        Some(b'/') => Op::Divide,
+        Some(b'%') => Op::IntDiv,
+        Some(b'=') => Op::Equal,
+        Some(b'>') => Op::GreaterThan,
+        Some(b'<') => Op::LessThan,
+        Some(b'&') => Op::And,
+        Some(b'|') => Op::Or,
+        Some(b'\\') | Some(b'^') => Op::Backslash,
+        // Anything else is not an operator at all. The oracle reports it
+        // through error 13, which is outside this spike's scope, so it becomes
+        // a one-byte operator token that both arms then reject identically.
+        _ => Op::Backslash,
+    };
+    sc.simple(1, Kind::Operator(op))
+}
