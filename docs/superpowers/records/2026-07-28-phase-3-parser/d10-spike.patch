--- /dev/null
+++ b/rust/crates/rexx-parse-spike/src/shared.rs
@@ -0,0 +1,112 @@
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* Copyright (c) 2026 Rexx Language Association. All rights reserved.          */
+/*                                                                            */
+/* This program and the accompanying materials are made available under       */
+/* the terms of the Common Public License v1.0 which accompanies this         */
+/* distribution. A copy is also available at the following address:           */
+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+
+//! The pieces both arms need, kept out of either arm's line count.
+
+use crate::ast::{ParseError, Symbol};
+use crate::token::{Kind, Loc, Token};
+
+/// Which tokens end the expression currently being parsed.
+///
+/// A runtime set rather than a type, because the same grammar is entered from
+/// contexts that stop on different tokens: a parenthesised subexpression stops
+/// on `)`, a `DO` control expression stops on `TO`, `BY`, `FOR`, `WHILE` and
+/// `UNTIL`, and a bare assignment stops only at end of clause.
+#[derive(Copy, Clone, PartialEq, Eq, Debug, Default)]
+pub struct Terminators {
+    pub right_paren: bool,
+    pub sq_right: bool,
+    pub do_keywords: bool,
+}
+
+impl Terminators {
+    pub const EOC: Terminators = Terminators {
+        right_paren: false,
+        sq_right: false,
+        do_keywords: false,
+    };
+    pub const RIGHT: Terminators = Terminators {
+        right_paren: true,
+        sq_right: false,
+        do_keywords: false,
+    };
+    pub const SQRIGHT: Terminators = Terminators {
+        right_paren: false,
+        sq_right: true,
+        do_keywords: false,
+    };
+    /// Inside parentheses, brackets or an argument list. Both closers are
+    /// terminators because the enclosing context's set is dropped, and which
+    /// closer is required is checked by the caller.
+    pub const NESTED: Terminators = Terminators {
+        right_paren: true,
+        sq_right: true,
+        do_keywords: false,
+    };
+    pub const DO: Terminators = Terminators {
+        right_paren: false,
+        sq_right: false,
+        do_keywords: true,
+    };
+
+    /// True when this token ends the expression being parsed.
+    pub fn matches(self, tok: &Token) -> bool {
+        match &tok.kind {
+            Kind::Eoc | Kind::Comma => true,
+            Kind::RightParen => self.right_paren,
+            Kind::SqRight => self.sq_right,
+            Kind::Symbol(name) => {
+                self.do_keywords
+                    && matches!(
+                        name.as_str(),
+                        "TO" | "BY" | "FOR" | "WHILE" | "UNTIL" | "OVER"
+                    )
+            }
+            _ => false,
+        }
+    }
+}
+
+/// Error 36's two sub-numbers, both substituting the opener's own position and
+/// line. The opener reported is the innermost one still unmatched, which falls
+/// out of reporting the `open` of whichever call is unwinding.
+pub fn unmatched(open: Loc, bracket: bool) -> ParseError {
+    ParseError::at(
+        36,
+        if bracket { 902 } else { 901 },
+        vec![
+            (open.start_offset + 1).to_string(),
+            open.start_line.to_string(),
+        ],
+        open,
+    )
+}
+
+/// Decides what a symbol denotes from its spelling alone.
+pub fn classify(name: &str) -> Symbol {
+    if name.starts_with('.') {
+        return Symbol::Environment(name.to_string());
+    }
+    if name.starts_with(|c: char| c.is_ascii_digit()) {
+        return Symbol::Number(name.to_string());
+    }
+    if let Some(dot) = name.find('.') {
+        let stem = name[..=dot].to_string();
+        let rest = &name[dot + 1..];
+        if rest.is_empty() {
+            return Symbol::Stem(stem);
+        }
+        let tails = rest.split('.').map(str::to_string).collect();
+        return Symbol::Compound { stem, tails };
+    }
+    Symbol::Simple(name.to_string())
+}
+
diff --git a/rust/crates/rexx-parse-spike/src/token.rs b/rust/crates/rexx-parse-spike/src/token.rs
