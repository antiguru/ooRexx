diff --git a/rust/crates/rexx-parse-spike/examples/throughput.rs b/rust/crates/rexx-parse-spike/examples/throughput.rs
new file mode 100644
index 00000000..8f42c926
--- /dev/null
+++ b/rust/crates/rexx-parse-spike/examples/throughput.rs
@@ -0,0 +1,108 @@
+//! Axis 3: parse throughput on `CoreClasses.orx`.
+//!
+//! The spike parses expressions, not instructions, so this cannot be a whole-file
+//! parse and therefore cannot be the cold-start figure D2 asks for. What it is:
+//! every line of the real file is offered to both arms as an expression, and the
+//! lines both arms accept are then timed. Both arms see identical input, so the
+//! ratio is meaningful even though the absolute number is not D2's.
+
+use std::time::{Duration, Instant};
+
+use chumsky::Parser as _;
+use rexx_parse_spike::hand::Terminators;
+use rexx_parse_spike::{comb, hand, token};
+
+/// Enough repetitions that timer resolution is irrelevant.
+const REPS: usize = 50;
+
+fn timed(label: &str, bytes: usize, mut body: impl FnMut()) -> Duration {
+    // One untimed pass, so no arm pays for a cold cache another avoided.
+    body();
+    let start = Instant::now();
+    for _ in 0..REPS {
+        body();
+    }
+    let per_pass = start.elapsed() / REPS as u32;
+    println!(
+        "{label:24} {per_pass:>12?} per pass = {:>5.1} MB/s",
+        bytes as f64 * 1e-6 / per_pass.as_secs_f64()
+    );
+    per_pass
+}
+
+fn main() {
+    let path = std::env::args()
+        .nth(1)
+        .unwrap_or_else(|| "../interpreter/RexxClasses/CoreClasses.orx".to_string());
+    let text = std::fs::read_to_string(&path).expect("the oracle's own source is readable");
+
+    let mut accepted: Vec<&str> = Vec::new();
+    let mut hand_only = 0usize;
+    let mut comb_only = 0usize;
+    for line in text.lines() {
+        if line.trim().is_empty() {
+            continue;
+        }
+        match (hand::parse(line).is_ok(), comb::parse(line).is_ok()) {
+            (true, true) => accepted.push(line),
+            (true, false) => hand_only += 1,
+            (false, true) => comb_only += 1,
+            (false, false) => {}
+        }
+    }
+    let bytes: usize = accepted.iter().map(|l| l.len()).sum();
+    println!(
+        "{} of {} non-blank lines parse as expressions under both arms, {bytes} bytes",
+        accepted.len(),
+        text.lines().filter(|l| !l.trim().is_empty()).count()
+    );
+    println!("disagreements: hand-only {hand_only}, comb-only {comb_only}");
+
+    // Scanning is shared, so it is timed separately and subtracted below.
+    let scan = timed("scan (shared)", bytes, || {
+        for line in &accepted {
+            let _ = token::scan(line);
+        }
+    });
+
+    let streams: Vec<Vec<token::Token>> = accepted
+        .iter()
+        .map(|l| token::scan(l).expect("already scanned once"))
+        .collect();
+    let bodies: Vec<&[token::Token]> = streams.iter().map(|s| &s[..s.len() - 1]).collect();
+
+    let hand_total = timed("hand, scan included", bytes, || {
+        for line in &accepted {
+            let _ = hand::parse(line);
+        }
+    });
+
+    // Built once. The grammar depends on a terminator set, so in production there
+    // would be one built parser per set rather than one per parse.
+    let built = comb::expression(Terminators::EOC).then_ignore(chumsky::prelude::end());
+    let comb_built = timed("comb, parser prebuilt", bytes, || {
+        for b in &bodies {
+            let _ = built.parse(b);
+        }
+    });
+
+    let comb_total = timed("comb, rebuilt per parse", bytes, || {
+        for line in &accepted {
+            let _ = comb::parse(line);
+        }
+    });
+
+    let hand_layer = hand_total.saturating_sub(scan);
+    println!();
+    println!("grammar layer alone, shared scanner subtracted:");
+    println!("  hand                 {hand_layer:?}");
+    println!("  comb, prebuilt       {comb_built:?}");
+    println!(
+        "  ratio                {:.1}x",
+        comb_built.as_secs_f64() / hand_layer.as_secs_f64()
+    );
+    println!(
+        "  rebuilding costs     {:.1}x on top of prebuilt",
+        comb_total.saturating_sub(scan).as_secs_f64() / comb_built.as_secs_f64()
+    );
+}
