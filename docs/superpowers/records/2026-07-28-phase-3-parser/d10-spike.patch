+//! D10 arm A: the same expression grammar with `chumsky` 0.13 combinators.
+
+use chumsky::error::LabelError;
+use chumsky::pratt::{infix, left, prefix};
+use chumsky::prelude::*;
+use chumsky::util::MaybeRef;
+
+use crate::ast::{Expr, ParseError, UnOp};
+use crate::shared::{Terminators, classify, unmatched};
+use crate::token::{Kind, Loc, Op, Token};
+
+/// A `chumsky` error that can carry a fully formed interpreter error.
+///
+/// The default error types describe a failure as an expected-set plus a found
+/// token, which is enough for 35.1 but not for 36.901, whose substitutions come
+/// from the *opening* parenthesis rather than from the token that failed. So
+/// specific sites build the `ParseError` themselves and this type carries it
+/// through; everything else falls back to the found token.
+#[derive(Clone, Debug)]
+pub struct CombErr {
+    // Boxed because a `CombErr` is the error half of every `try_map` result in
+    // the grammar, and an inline `ParseError` makes each of those `Result`s
+    // large enough for clippy to reject.
+    pub explicit: Option<Box<ParseError>>,
+    pub found: Option<Token>,
+}
+
+impl<'a, I: Input<'a, Token = Token>> chumsky::error::Error<'a, I> for CombErr {
+    fn merge(self, other: Self) -> Self {
+        // An explicit interpreter error is always more specific than a
+        // generated expected-set, so it wins.
+        match (&self.explicit, &other.explicit) {
+            (Some(_), None) => self,
+            (None, Some(_)) => other,
+            (None, None) => self,
+            (Some(a), Some(b)) => {
+                // Both sites built a real error, and the oracle reports the
+                // *innermost* unmatched opener. There is no nesting depth here
+                // to compare, so this compares the openers' own positions and
+                // takes the later one, which is the innermost whenever the two
+                // are nested. That is a heuristic, not a derivation: two errors
+                // from sibling subexpressions would compare the same way and
+                // there is nothing in the merge to tell the cases apart.
+                let key = |e: &ParseError| (e.loc.start_line, e.loc.start_offset);
+                if key(b) > key(a) { other } else { self }
+            }
+        }
+    }
+}
+
+impl<'a, I, L> LabelError<'a, I, L> for CombErr
+where
+    I: Input<'a, Token = Token>,
+{
+    fn expected_found<E: IntoIterator<Item = L>>(
+        _expected: E,
+        found: Option<MaybeRef<'a, Token>>,
+        _span: I::Span,
+    ) -> Self {
+        CombErr {
+            explicit: None,
+            found: found.map(|f| f.into_inner()),
+        }
+    }
+}
+
+impl CombErr {
+    fn explicit(err: ParseError) -> Self {
+        CombErr {
+            explicit: Some(Box::new(err)),
+            found: None,
+        }
+    }
+
+    /// The interpreter error this failure corresponds to.
+    ///
+    /// Without an explicit error the only information available is the token
+    /// that was found, which maps onto exactly the three errors the oracle
+    /// raises from a bad token in expression position.
+    pub fn to_parse_error(&self) -> ParseError {
+        if let Some(e) = &self.explicit {
+            return (**e).clone();
+        }
+        match &self.found {
+            Some(t) => match t.kind {
+                Kind::RightParen => ParseError::at(37, 2, vec![], t.loc),
+                Kind::SqRight => ParseError::at(37, 901, vec![], t.loc),
+                _ => ParseError::at(35, 1, vec![t.text()], t.loc),
+            },
+            None => ParseError::at(35, 918, vec![], Loc::default()),
+        }
+    }
+}
+
+type Extra = extra::Err<CombErr>;
+type In<'a> = &'a [Token];
+
+/// A boxed expression parser, needed because the grammar is assembled by
+/// functions rather than written as one expression.
+type Ex<'a> = Boxed<'a, 'a, In<'a>, Expr, Extra>;
+
+fn tok<'a>(kind: Kind) -> impl Parser<'a, In<'a>, Token, Extra> + Clone {
+    any().filter(move |t: &Token| t.kind == kind)
+}
+
+/// True when this token could begin a term, prefix operators included.
+fn can_start_term(t: &Token) -> bool {
+    t.starts_term() || matches!(t.kind, Kind::Operator(Op::Plus | Op::Subtract | Op::Backslash))
+}
+
+/// Requires a term to follow an operator, reporting the operator itself when
+/// none does.
+///
+/// `pratt` parses the right-hand side itself, so its failure is a plain
+/// "unexpected end of input" that names no operator, and the furthest-error rule
+/// then makes it beat everything else. The only way to name the operator is to
+/// check for the term before `pratt` ever gets there.
+fn require_term<'a>(
+    op: impl Parser<'a, In<'a>, Token, Extra> + Clone,
+    major: u16,
+    sub: u16,
+) -> impl Parser<'a, In<'a>, Token, Extra> + Clone {
+    op.then(any().rewind().or_not()).try_map(move |(op, next), _| {
+        // A blank is never emitted after an operator token, so whatever comes
+        // next is where the term should have been.
+        match next {
+            Some(t) if can_start_term(&t) => Ok(op),
+            // A token that cannot start a term but is not a terminator is what
+            // the oracle names: `a + * b` reports `*`, not `+`.
+            Some(t)
+                if !matches!(
+                    t.kind,
+                    Kind::Comma | Kind::RightParen | Kind::SqRight | Kind::Eoc
+                ) =>
+            {
+                Err(CombErr::explicit(ParseError::at(
+                    35,
+                    1,
+                    vec![t.text()],
+                    t.loc,
+                )))
+            }
+            // Nothing at all follows, so the operator itself is named.
+            _ => Err(CombErr::explicit(ParseError::at(
+                major,
+                sub,
+                vec![op.text()],
+                op.loc,
+            ))),
+        }
+    })
+}
+
+/// The dyadic operators at one precedence level, excluding the two that have no
+/// token of their own.
+fn plain_op<'a>(level: u8) -> impl Parser<'a, In<'a>, Op, Extra> + Clone {
+    require_term(
+        select! {
+            t @ Token { kind: Kind::Operator(op), .. }
+                if op.precedence() == level && op != Op::Backslash => t
+        },
+        35,
+        1,
+    )
+    .map(|t| match t.kind {
+        Kind::Operator(op) => op,
+        _ => unreachable!("the selector only accepts operator tokens"),
+    })
+}
+
+/// The blank operator, which is not an operator when the token after it is a
+/// terminator.
+///
+/// This is the `nextReal` lookahead in `LanguageParser.cpp:2896`, and it is why
+/// `do i = 1 to 3` does not concatenate `3` with `TO`.
+fn blank_op<'a>(term: Terminators) -> impl Parser<'a, In<'a>, Op, Extra> + Clone {
+    tok(Kind::Blank)
+        .then_ignore(
+            any()
+                .filter(move |t: &Token| !term.matches(t))
+                .rewind(),
+        )
+        .to(Op::Blank)
+}
+
+/// The abuttal operator, which has no token at all.
+///
+/// The oracle synthesises a zero-length operator token when a term appears
+/// where an operator was expected (`LanguageParser.cpp:2878`), so this parser
+/// must consume nothing and only succeed when a term follows.
+fn abuttal_op<'a>() -> impl Parser<'a, In<'a>, Op, Extra> + Clone {
+    any()
+        .filter(|t: &Token| t.starts_term())
+        .rewind()
+        .to(Op::Abuttal)
+}
+
+fn bin(op: Op, l: Expr, r: Expr) -> Expr {
+    Expr::Binary(op, Box::new(l), Box::new(r))
+}
+
+/// An argument list: comma-separated, each argument optional.
+fn args<'a>(inner: Ex<'a>, open: Kind, close: Kind) -> impl Parser<'a, In<'a>, (Token, Vec<Option<Expr>>), Extra> + Clone
+where
+{
+    let bracket = open == Kind::SqLeft;
+    tok(open)
+        .then(
+            choice((inner.map(Some), omitted()))
+                .separated_by(tok(Kind::Comma))
+                .collect::<Vec<_>>(),
+        )
+        .then(tok(close).or_not())
+        .try_map(move |((opener, items), closer), _span| match closer {
+            Some(_) => {
+                // A list of exactly one omitted argument is an empty list: the
+                // `or_not` above always contributes one element.
+                let items = if items.len() == 1 && items[0].is_none() {
+                    Vec::new()
+                } else {
+                    items
+                };
+                Ok((opener, items))
+            }
+            None => Err(CombErr::explicit(unmatched(opener.loc, bracket))),
+        })
+}
+
+/// One step of a message cascade: `~name(...)`, `~~name(...)` or `[...]`.
+enum Cascade {
+    Message {
+        name: String,
+        args: Vec<Option<Expr>>,
+        cascade: bool,
+    },
+    Index(Vec<Option<Expr>>),
+}
+
+fn cascade_step<'a>(inner: Ex<'a>) -> impl Parser<'a, In<'a>, Cascade, Extra> + Clone {
+    let name = select! {
+        Token { kind: Kind::Symbol(s), .. } => s,
+        Token { kind: Kind::Literal(s), .. } => s,
+    };
+    let twiddle = tok(Kind::Tilde).to(false).or(tok(Kind::DTilde).to(true));
+    let message = twiddle
+        // Blanks are allowed between the twiddle and the name: `"abc" ~ length`.
+        .then(tok(Kind::Blank).or_not())
+        .then(name.or_not())
+        .then(args(inner.clone(), Kind::LeftParen, Kind::RightParen).or_not())
+        .try_map(|(((cascade, _), name), argl), _span| match name {
+            Some(name) => Ok(Cascade::Message {
+                name,
+                args: argl.map(|(_, a)| a).unwrap_or_default(),
+                cascade,
+            }),
+            // The twiddle's own location is what 19.909 needs, and it is no
+            // longer reachable here, so the span is the best available stand-in.
+            None => Err(CombErr::explicit(ParseError::at(
+                19,
+                909,
+                vec![],
+                Loc::default(),
+            ))),
+        });
+    let index = args(inner, Kind::SqLeft, Kind::SqRight).map(|(_, a)| Cascade::Index(a));
+    message.or(index)
+}
+
+/// The atoms, plus any message cascade attached to them.
+fn atom<'a>(inner: Ex<'a>) -> Ex<'a> {
+    let symbol = select! { Token { kind: Kind::Symbol(s), .. } => s };
+    let literal = select! { Token { kind: Kind::Literal(s), .. } => s };
+
+    // A call is a name with an *immediately* adjacent parenthesis. Nothing here
+    // skips whitespace, so the `Blank` token in `f (x)` makes this alternative
+    // fail and the abuttal path take over.
+    let call = symbol
+        .or(literal)
+        .then(args(inner.clone(), Kind::LeftParen, Kind::RightParen))
+        .map(|(name, (_, args))| Expr::Call { name, args });
+
+    let paren = tok(Kind::LeftParen)
+        .then(
+            choice((inner.clone().map(Some), omitted()))
+                .separated_by(tok(Kind::Comma))
+                .at_least(1)
+                .collect::<Vec<_>>(),
+        )
+        .then(tok(Kind::RightParen).or_not())
+        .try_map(|((opener, mut items), closer), _span| {
+            if closer.is_none() {
+                return Err(CombErr::explicit(unmatched(opener.loc, false)));
+            }
+            if items.len() == 1 {
+                return match items.pop().expect("length checked") {
+                    Some(e) => Ok(e),
+                    None => Err(CombErr::explicit(ParseError::at(
+                        35,
+                        1,
+                        vec!["(".to_string()],
+                        opener.loc,
+                    ))),
+                };
+            }
+            Ok(Expr::List(items))
+        });
+
+    let base = choice((
+        call,
+        paren,
+        symbol.map(|s| Expr::Symbol(classify(&s))),
+        literal.map(Expr::Literal),
+    ));
+
+    base.foldl(cascade_step(inner).repeated(), |target, step| match step {
+        Cascade::Message {
+            name,
+            args,
+            cascade,
+        } => Expr::Message {
+            target: Box::new(target),
+            name,
+            args,
+            cascade,
+        },
+        Cascade::Index(args) => Expr::Index {
+            target: Box::new(target),
+            args,
+        },
+    })
+    .boxed()
+}
+
+/// Assembles the whole precedence chain for one terminator context.
+fn build<'a>(term: Terminators, inner: Ex<'a>) -> Ex<'a> {
+    let prefix_op = require_term(
+        select! {
+            t @ Token { kind: Kind::Operator(Op::Plus | Op::Subtract | Op::Backslash), .. } => t
+        },
+        35,
+        901,
+    )
+    .map(|t| match t.kind {
+        Kind::Operator(Op::Plus) => UnOp::Plus,
+        Kind::Operator(Op::Subtract) => UnOp::Minus,
+        _ => UnOp::Not,
+    });
+    // Prefix binds at 9, above `**` at 7, which is what makes `-2 ** 2` four
+    // rather than minus four.
+    atom(inner)
+        .pratt((
+            prefix(9, prefix_op, |op, rhs, _| Expr::Unary(op, Box::new(rhs))),
+            infix(left(7), plain_op(7), |l, op, r, _| bin(op, l, r)),
+            infix(left(6), plain_op(6), |l, op, r, _| bin(op, l, r)),
+            infix(left(5), plain_op(5), |l, op, r, _| bin(op, l, r)),
+            infix(
+                left(4),
+                choice((plain_op(4), blank_op(term), abuttal_op())),
+                |l, op, r, _| bin(op, l, r),
+            ),
+            infix(left(3), plain_op(3), |l, op, r, _| bin(op, l, r)),
+            infix(left(2), plain_op(2), |l, op, r, _| bin(op, l, r)),
+            infix(left(1), plain_op(1), |l, op, r, _| bin(op, l, r)),
+        ))
+        .boxed()
+}
+
+/// The grammar used inside parentheses, brackets and argument lists.
+///
+/// Parenthesised subexpressions deliberately drop the enclosing terminator set
+/// (`LanguageParser.cpp:3777`), so one instance serves every nested context.
+fn nested<'a>() -> Ex<'a> {
+    recursive(|me| build(Terminators::NESTED, me.boxed())).boxed()
+}
+
+/// An argument that was left out, recognised by what follows rather than by
+/// failing to parse an expression.
+///
+/// `or_not` cannot be used for this: it rewinds and succeeds with `None`,
+/// throwing away the error, so `x = a +` came back as "no expression at all"
+/// instead of 35.1 at `+`.
+fn omitted<'a>() -> impl Parser<'a, In<'a>, Option<Expr>, Extra> + Clone {
+    any()
+        .filter(|t: &Token| {
+            matches!(
+                t.kind,
+                Kind::Comma | Kind::RightParen | Kind::SqRight | Kind::Eoc
+            )
+        })
+        .rewind()
+        .to(None)
+        .or(end().to(None))
+}
+
+/// The whole expression for one terminator context, comma list included.
+pub fn expression<'a>(term: Terminators) -> impl Parser<'a, In<'a>, Option<Expr>, Extra> {
+    choice((build(term, nested()).map(Some), omitted()))
+        .separated_by(tok(Kind::Comma))
+        .at_least(1)
+        .collect::<Vec<_>>()
+        .map(|mut items| {
+            if items.len() == 1 {
+                items.pop().expect("length checked")
+            } else {
+                Some(Expr::List(items))
+            }
+        })
+}
+
+/// Finds the innermost unmatched `(` or `[` in a token stream.
+///
+/// This is a hand-written pre-pass, and it is here because the combinators
+/// cannot produce error 36 themselves. `repeated()`, `or_not()` and `choice()`
+/// all rewind a partially-consumed alternative and discard its error, and
+/// chumsky 0.13 has no cut or commit combinator to stop that, so the bracket
+/// error raised inside a message cascade never reaches the caller: `(a[1`
+/// reported the outer parenthesis instead of the inner bracket. Balancing the
+/// stream up front sidesteps the grammar entirely.
+fn unmatched_opener(toks: &[Token]) -> Option<ParseError> {
+    let mut stack: Vec<&Token> = Vec::new();
+    for t in toks {
+        match t.kind {
+            Kind::LeftParen | Kind::SqLeft => stack.push(t),
+            Kind::RightParen | Kind::SqRight => {
+                stack.pop();
+            }
+            _ => {}
+        }
+    }
+    stack
+        .pop()
+        .map(|t| unmatched(t.loc, matches!(t.kind, Kind::SqLeft)))
+}
+
+/// Parses one expression from source, for tests and for the throughput axis.
+pub fn parse(src: &str) -> Result<Expr, ParseError> {
+    let toks = crate::token::scan(src)?;
+    // The trailing `Eoc` is not part of the grammar, so it is trimmed rather
+    // than made a token every alternative has to stop before.
+    let body = &toks[..toks.len() - 1];
+    let result = expression(Terminators::EOC).then_ignore(end()).parse(body);
+    if result.has_errors()
+        && let Some(err) = unmatched_opener(body)
+    {
+        return Err(err);
+    }
+    match result.into_result() {
+        Ok(Some(e)) => Ok(e),
+        Ok(None) => Err(ParseError::at(35, 918, vec![], toks[0].loc)),
+        Err(errs) => Err(errs
+            .first()
+            .map(CombErr::to_parse_error)
+            .unwrap_or_else(|| ParseError::at(35, 1, vec![], toks[0].loc))),
+    }
+}
