index 00000000..f3847d95
--- /dev/null
+++ b/rust/crates/rexx-parse-spike/src/hand.rs
@@ -0,0 +1,345 @@
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* Copyright (c) 2026 Rexx Language Association. All rights reserved.          */
+/*                                                                            */
+/* This program and the accompanying materials are made available under       */
+/* the terms of the Common Public License v1.0 which accompanies this         */
+/* distribution. A copy is also available at the following address:           */
+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+
+//! D10 arm B: the expression grammar by hand, recursive descent.
+
+use crate::ast::{Expr, ParseError, UnOp};
+pub use crate::shared::Terminators;
+use crate::shared::{classify, unmatched};
+use crate::token::{Kind, Loc, Op, Token};
+
+pub struct Parser<'a> {
+    toks: &'a [Token],
+    pos: usize,
+}
+
+impl<'a> Parser<'a> {
+    pub fn new(toks: &'a [Token]) -> Self {
+        Parser { toks, pos: 0 }
+    }
+
+    fn peek(&self) -> &'a Token {
+        // `scan` always appends an `Eoc`, so the last token repeats forever
+        // rather than running off the end.
+        self.toks
+            .get(self.pos)
+            .unwrap_or_else(|| self.toks.last().expect("scan emits at least one token"))
+    }
+
+    fn next(&mut self) -> &'a Token {
+        let t = self.peek();
+        if self.pos < self.toks.len() {
+            self.pos += 1;
+        }
+        t
+    }
+
+    fn back(&mut self) {
+        self.pos -= 1;
+    }
+
+    /// The next token, skipping any blank operator. Used where the oracle calls
+    /// `nextReal`, which is only for lookahead that must see past whitespace.
+    fn peek_real(&self) -> &'a Token {
+        let mut i = self.pos;
+        while matches!(self.toks.get(i).map(|t| &t.kind), Some(Kind::Blank)) {
+            i += 1;
+        }
+        self.toks
+            .get(i)
+            .unwrap_or_else(|| self.toks.last().expect("scan emits at least one token"))
+    }
+
+    /// Parses a whole expression, where a top-level comma list builds an array.
+    pub fn expression(&mut self, term: Terminators) -> Result<Option<Expr>, ParseError> {
+        let mut parts = Vec::new();
+        loop {
+            parts.push(self.sub_expression(term)?);
+            if matches!(self.peek().kind, Kind::Comma) {
+                self.next();
+            } else {
+                break;
+            }
+        }
+        if parts.len() == 1 {
+            return Ok(parts.pop().expect("just checked the length"));
+        }
+        Ok(Some(Expr::List(parts)))
+    }
+
+    /// Precedence climbing over the operator table in `Op::precedence`.
+    ///
+    /// Every Rexx dyadic operator is left-associative, including `**`, which is
+    /// why `2 ** 3 ** 2` is 64 and not 512, and why `a = b = c` with `2 2 1` is
+    /// 1 and not 0. The loop therefore recurses at `prec + 1` on the right.
+    fn sub_expression(&mut self, term: Terminators) -> Result<Option<Expr>, ParseError> {
+        let Some(left) = self.message_subterm(term)? else {
+            return Ok(None);
+        };
+        self.binary_rest(left, 1, term).map(Some)
+    }
+
+    fn binary_rest(
+        &mut self,
+        mut left: Expr,
+        min_prec: u8,
+        term: Terminators,
+    ) -> Result<Expr, ParseError> {
+        loop {
+            let tok = self.peek();
+            if term.matches(tok) {
+                return Ok(left);
+            }
+            let (op, op_loc) = match &tok.kind {
+                // A term where an operator was expected is an abuttal: the
+                // oracle synthesises a zero-length operator token here
+                // (`LanguageParser.cpp:2878`).
+                Kind::Symbol(_) | Kind::Literal(_) | Kind::LeftParen => {
+                    let mut loc = tok.loc;
+                    loc.end_offset = loc.start_offset;
+                    (Op::Abuttal, loc)
+                }
+                Kind::Blank => {
+                    // A blank before a terminator is not an operator. This is
+                    // what keeps `do i = 1 to 3 while x` from concatenating
+                    // `3` with `WHILE`.
+                    let after = {
+                        let save = self.pos;
+                        self.pos += 1;
+                        let t = self.peek_real();
+                        self.pos = save;
+                        t
+                    };
+                    if term.matches(after) {
+                        return Ok(left);
+                    }
+                    (Op::Blank, tok.loc)
+                }
+                Kind::Operator(Op::Backslash) => {
+                    // `\` is prefix-only, so it cannot appear here. This is why
+                    // `x = a \(1 = 2)` is error 35.1 and not a concatenation.
+                    return Err(ParseError::at(35, 1, vec!["\\".to_string()], tok.loc));
+                }
+                Kind::Operator(op) => (*op, tok.loc),
+                Kind::Tilde | Kind::DTilde | Kind::SqLeft => {
+                    // A message send binds tighter than every operator, so it
+                    // reattaches to the term just parsed rather than going
+                    // through the precedence loop.
+                    left = self.cascade(left, term)?;
+                    continue;
+                }
+                Kind::RightParen => {
+                    return Err(ParseError::at(37, 2, vec![], tok.loc));
+                }
+                Kind::SqRight => {
+                    return Err(ParseError::at(37, 901, vec![], tok.loc));
+                }
+                _ => {
+                    return Err(ParseError::at(35, 1, vec![tok.text()], tok.loc));
+                }
+            };
+            let prec = op.precedence();
+            if prec < min_prec {
+                return Ok(left);
+            }
+            // Abuttal consumes nothing, because the token it was synthesised
+            // from is the start of the right-hand term.
+            if op != Op::Abuttal {
+                self.next();
+            }
+            let right = self.message_subterm(term)?;
+            let Some(right) = right else {
+                return Err(ParseError::at(35, 1, vec![op.spelling().to_string()], op_loc));
+            };
+            let right = self.binary_rest(right, prec + 1, term)?;
+            left = Expr::Binary(op, Box::new(left), Box::new(right));
+        }
+    }
+
+    /// A term with any prefix operators, followed by any message cascade.
+    fn message_subterm(&mut self, term: Terminators) -> Result<Option<Expr>, ParseError> {
+        let tok = self.peek();
+        if term.matches(tok) {
+            return Ok(None);
+        }
+        if let Kind::Operator(op) = tok.kind {
+            let unop = match op {
+                Op::Plus => UnOp::Plus,
+                Op::Subtract => UnOp::Minus,
+                Op::Backslash => UnOp::Not,
+                _ => return Err(ParseError::at(35, 1, vec![tok.text()], tok.loc)),
+            };
+            let loc = tok.loc;
+            let spelling = op.spelling().to_string();
+            self.next();
+            // Recursing on the whole subterm, not on the atom, is what makes a
+            // prefix operator bind tighter than `**`: `-x ** 2` is `(-x) ** 2`,
+            // which is 4, not -4.
+            let Some(inner) = self.message_subterm(term)? else {
+                return Err(ParseError::at(35, 901, vec![spelling], loc));
+            };
+            return Ok(Some(Expr::Unary(unop, Box::new(inner))));
+        }
+        let Some(atom) = self.sub_term(term)? else {
+            return Ok(None);
+        };
+        Ok(Some(self.cascade(atom, term)?))
+    }
+
+    /// Applies every message and index operator that follows a term.
+    fn cascade(&mut self, mut target: Expr, _term: Terminators) -> Result<Expr, ParseError> {
+        loop {
+            let tok = self.peek();
+            match tok.kind {
+                Kind::SqLeft => {
+                    let open = tok.loc;
+                    self.next();
+                    let args = self.arg_list(open, Kind::SqRight)?;
+                    target = Expr::Index {
+                        target: Box::new(target),
+                        args,
+                    };
+                }
+                Kind::Tilde | Kind::DTilde => {
+                    let cascade = matches!(tok.kind, Kind::DTilde);
+                    let twiddle = tok.loc;
+                    self.next();
+                    target = self.message(target, cascade, twiddle)?;
+                }
+                _ => return Ok(target),
+            }
+        }
+    }
+
+    fn message(&mut self, target: Expr, cascade: bool, twiddle: Loc) -> Result<Expr, ParseError> {
+        // The message name may be separated from the twiddle by blanks:
+        // `"abc" ~ length` is 3.
+        while matches!(self.peek().kind, Kind::Blank) {
+            self.next();
+        }
+        let tok = self.next();
+        let name = match &tok.kind {
+            Kind::Symbol(s) => s.clone(),
+            Kind::Literal(s) => s.clone(),
+            _ => {
+                self.back();
+                return Err(ParseError::at(19, 909, vec![], twiddle));
+            }
+        };
+        // Only an immediately adjacent parenthesis is an argument list.
+        let args = if matches!(self.peek().kind, Kind::LeftParen) {
+            let open = self.next().loc;
+            self.arg_list(open, Kind::RightParen)?
+        } else {
+            Vec::new()
+        };
+        Ok(Expr::Message {
+            target: Box::new(target),
+            name,
+            args,
+            cascade,
+        })
+    }
+
+    /// The atoms: parenthesised subexpressions, symbols, literals, and calls.
+    fn sub_term(&mut self, term: Terminators) -> Result<Option<Expr>, ParseError> {
+        let tok = self.peek();
+        if term.matches(tok) {
+            return Ok(None);
+        }
+        match &tok.kind {
+            Kind::LeftParen => {
+                let open = tok.loc;
+                self.next();
+                let inner = self.expression(Terminators::RIGHT)?;
+                let Some(inner) = inner else {
+                    return Err(ParseError::at(35, 1, vec!["(".to_string()], open));
+                };
+                if !matches!(self.peek().kind, Kind::RightParen) {
+                    return Err(unmatched(open, false));
+                }
+                self.next();
+                Ok(Some(inner))
+            }
+            Kind::Symbol(name) => {
+                let name = name.clone();
+                self.next();
+                if matches!(self.peek().kind, Kind::LeftParen) {
+                    let open = self.next().loc;
+                    let args = self.arg_list(open, Kind::RightParen)?;
+                    return Ok(Some(Expr::Call { name, args }));
+                }
+                Ok(Some(Expr::Symbol(classify(&name))))
+            }
+            Kind::Literal(value) => {
+                let value = value.clone();
+                self.next();
+                if matches!(self.peek().kind, Kind::LeftParen) {
+                    let open = self.next().loc;
+                    let args = self.arg_list(open, Kind::RightParen)?;
+                    return Ok(Some(Expr::Call { name: value, args }));
+                }
+                Ok(Some(Expr::Literal(value)))
+            }
+            // A prefix operator here is not this function's business: the caller
+            // handles it, so report nothing found rather than an error.
+            Kind::Operator(Op::Plus | Op::Subtract | Op::Backslash) => Ok(None),
+            Kind::RightParen => Err(ParseError::at(37, 2, vec![], tok.loc)),
+            Kind::SqRight => Err(ParseError::at(37, 901, vec![], tok.loc)),
+            Kind::Blank => {
+                self.next();
+                self.sub_term(term)
+            }
+            _ => Err(ParseError::at(35, 1, vec![tok.text()], tok.loc)),
+        }
+    }
+
+    /// An argument list, where an omitted argument is a real possibility:
+    /// `f(,)` parses and passes two omitted arguments.
+    fn arg_list(&mut self, open: Loc, closer: Kind) -> Result<Vec<Option<Expr>>, ParseError> {
+        let inner = if closer == Kind::RightParen {
+            Terminators::RIGHT
+        } else {
+            Terminators::SQRIGHT
+        };
+        let mut args = Vec::new();
+        // An empty list is zero arguments, but `f(,)` is two omitted ones, which
+        // falls out of the loop below because a comma terminates a
+        // subexpression that then yields nothing.
+        if self.peek().kind == closer {
+            self.next();
+            return Ok(args);
+        }
+        loop {
+            args.push(self.sub_expression(inner)?);
+            let tok = self.peek();
+            if matches!(tok.kind, Kind::Comma) {
+                self.next();
+                continue;
+            }
+            if tok.kind == closer {
+                self.next();
+                return Ok(args);
+            }
+            return Err(unmatched(open, closer == Kind::SqRight));
+        }
+    }
+}
+
+/// Parses one expression from source, for tests and for the throughput axis.
+pub fn parse(src: &str) -> Result<Expr, ParseError> {
+    let toks = crate::token::scan(src)?;
+    let mut p = Parser::new(&toks);
+    match p.expression(Terminators::EOC)? {
+        Some(e) => Ok(e),
+        None => Err(ParseError::at(35, 918, vec![], toks[0].loc)),
+    }
+}
