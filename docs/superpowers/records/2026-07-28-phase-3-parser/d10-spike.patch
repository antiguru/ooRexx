+//! The D10 corpus, with the oracle's own answers as the expected values.
+//!
+//! Every expression is padded with four spaces so that its byte offsets match
+//! the line `x = <expr>` that produced the oracle's answer. That matters for
+//! errors 36.901 and 36.902, whose substitution values are a byte position
+//! within the line.
+//!
+//! Ground truth came from `build/bin/rexx` for values and `build/bin/rexxc` for
+//! the syntax errors. The variable environment is fixed:
+//! `a=2 b=3 c=4 p=x q=y r=z x=2 aa=2 bb=2 cc=1 i=1 j=2 s.1=one s.2=two
+//! n.1.2=nested`, plus routines `f(n)` returning `Rn` and `g(n)` returning
+//! `n+10`.
+
+use rexx_parse_spike::eval::{EvalError, eval};
+use rexx_parse_spike::{comb, hand};
+
+/// One corpus case: the expression, what the oracle printed, and the AST shape
+/// the oracle's answer implies. The shape is only asserted where the evaluator
+/// cannot reach the answer, which is every case involving an object.
+struct Case {
+    src: &'static str,
+    oracle: &'static str,
+    shape: Option<&'static str>,
+}
+
+const fn c(src: &'static str, oracle: &'static str) -> Case {
+    Case {
+        src,
+        oracle,
+        shape: None,
+    }
+}
+
+const fn s(src: &'static str, oracle: &'static str, shape: &'static str) -> Case {
+    Case {
+        src,
+        oracle,
+        shape: Some(shape),
+    }
+}
+
+const VALUES: &[Case] = &[
+    c("a + b * c", "14"),
+    c("(a + b) * c", "20"),
+    c("p q r", "x y z"),
+    c("p || q", "xy"),
+    c("p''q", "xy"),
+    // `''b` is an empty binary literal, so the variable b is never read.
+    c("p''b", "x"),
+    c("p\"\"b", "x"),
+    c("p\"y\"q", "xyy"),
+    c("p'41'x", "xA"),
+    c("\"0100 0001\"b", "A"),
+    // Prefix minus binds tighter than `**`, so this is 4 and not -4.
+    c("-2 ** 2", "4"),
+    c("-x ** 2", "4"),
+    // `**` is left-associative: right would give 512.
+    c("2 ** 3 ** 2", "64"),
+    // Left-associative comparison: right would give 0.
+    c("aa = bb = cc", "1"),
+    c("f(1)", "R1"),
+    // The blank turns the call into an abuttal of the variable F and (1).
+    c("f (1)", "F 1"),
+    c("abs('2.5')", "2.5"),
+    c("abs ('2.5')", "ABS 2.5"),
+    c("f(g(1))", "R11"),
+    c("s.i", "one"),
+    c("s.1", "one"),
+    c("n.i.j", "nested"),
+    s("arr[2]", "B", "(index ARR 2)"),
+    s("m[2,2]", "Q", "(index M 2 2)"),
+    s(
+        "\"abcdef\"~substr(2,3)",
+        "bcd",
+        "(msg~ 'abcdef' SUBSTR 2 3)",
+    ),
+    s(
+        ".array~new~~append(\"A\")~~append(\"B\")~items",
+        "2",
+        "(msg~ (msg~~ (msg~~ (msg~ env:.ARRAY NEW) APPEND 'A') APPEND 'B') ITEMS)",
+    ),
+    s("\"abc\"~reverse~upper", "CBA", "(msg~ (msg~ 'abc' REVERSE) UPPER)"),
+    c("\\(1 = 2)", "1"),
+    c("a > b & c > a", "0"),
+    c("a < b | c < a", "1"),
+    c("\"2\" == 2", "1"),
+    c("\"2\" \\== 2", "0"),
+    c("a+1 b+1", "3 4"),
+    c("- - 2", "2"),
+    s("\"abc\" ~ length", "3", "(msg~ 'abc' LENGTH)"),
+    s("arr~at(3)", "C", "(msg~ ARR AT 3)"),
+    c("1 + 2 * 3 ** 2 - 4", "15"),
+    c("\"a\" \"b\" || \"c\" \"d\"", "a bc d"),
+    c("3 // 2", "1"),
+    c("7 % 2", "3"),
+    c("a \\< b", "0"),
+    c("a >< b", "1"),
+    c("1 && 1", "0"),
+    s("\"abc\"[2]", "b", "(index 'abc' 2)"),
+    s("(arr)[2]", "B", "(index ARR 2)"),
+    c("010 + 1", "11"),
+    c("1e2 + 1", "101"),
+    // The stem A. was never assigned, so the compound variable is its own name.
+    c("a.1", "A.1"),
+    c("3 = \"3.0\"", "1"),
+    c("\\\\1", "1"),
+    c("2 ** -1", "0.5"),
+    c("-2 ** -2", "0.25"),
+    s(
+        "\"abc\"~substr(2)~upper 1",
+        "BC 1",
+        "(blank (msg~ (msg~ 'abc' SUBSTR 2) UPPER) 1)",
+    ),
+    s("(1+1)~class~id", "String", "(msg~ (msg~ (+ 1 1) CLASS) ID)"),
+    s(".array~id", "Array", "(msg~ env:.ARRAY ID)"),
+    c("f(1) f (1)", "R1 F 1"),
+    c("length(\"abc\")", "3"),
+    c("length (\"abc\")", "LENGTH abc"),
+    s("\"abc\"~length 5", "3 5", "(blank (msg~ 'abc' LENGTH) 5)"),
+];
+
+/// The malformed expressions, with the number, sub-number and substitution
+/// values `build/bin/rexxc` reports for each.
+///
+/// The line numbers here are the spike's own, which start at 1 for the
+/// expression; the oracle files put the clause on line 2 or 3.
+const ERRORS: &[(&str, &str)] = &[
+    (")", "37.2 []"),
+    ("a +", "35.1 [+]"),
+    ("(a", "36.901 [5|1]"),
+    ("a~", "19.909 []"),
+    ("a || || b", "35.1 [||]"),
+    ("'unterminated", "6.2 []"),
+    ("a \\(1 = 2)", "35.1 [\\]"),
+    ("**2", "35.1 [**]"),
+    ("a[", "36.902 [6|1]"),
+    ("a[1", "36.902 [6|1]"),
+    ("1 2 3)", "37.2 []"),
+    ("a~b~", "19.909 []"),
+    ("a~~", "19.909 []"),
+    ("a~\"b", "6.3 []"),
+    ("~a", "35.1 [~]"),
+    ("a %% b", "35.1 [%]"),
+    ("a ||", "35.1 [||]"),
+    ("()", "35.1 [(]"),
+    ("a b )", "37.2 []"),
+    ("\\", "35.901 [\\]"),
+    ("((a)", "36.901 [5|1]"),
+    ("(a[1", "36.902 [7|1]"),
+    ("]", "37.901 []"),
+    ("a[1]]", "37.901 []"),
+    ("a + * b", "35.1 [*]"),
+    ("f(a b", "36.901 [6|1]"),
+    // A comma continuation: the reported line is the token's own physical line,
+    // not the clause's first.
+    ("1 + ,\n    (a", "36.901 [5|2]"),
+];
+
+/// Expressions `build/bin/rexxc` accepts, kept separate because their value
+/// depends on state the evaluator does not model. They are the negative
+/// direction of the fidelity axis: an arm must not reject what the oracle
+/// accepts, and only `rexxc` can answer that question without running the file.
+const ACCEPTED: &[&str] = &[
+    // A bare stem reference.
+    "a.",
+    // Two omitted arguments.
+    "f(,)",
+    // A number is a valid message name.
+    "a~1",
+    // Keywords are not reserved, so IF here is just a variable.
+    "a b if",
+    "1 ~ 2",
+    // A trailing comma is a continuation, so this is just `a`.
+    "a,\n    b",
+    // A trailing minus is also a continuation, and acts as a blank operator.
+    "a-\n    b",
+];
+
+/// Four spaces, so that a byte offset in the spike matches the same expression
+/// written after `x = ` in a `.rex` file.
+fn padded(src: &str) -> String {
+    format!("    {src}")
+}
+
+#[test]
+fn hand_matches_the_oracle() {
+    let mut failures = Vec::new();
+    for case in VALUES {
+        match hand::parse(&padded(case.src)) {
+            Ok(ast) => check(case, &ast.render(), eval(&ast), &mut failures, "hand"),
+            Err(e) => failures.push(format!("hand {:?}: parse failed {}", case.src, e.signature())),
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+#[test]
+fn combinators_match_the_oracle() {
+    let mut failures = Vec::new();
+    for case in VALUES {
+        match comb::parse(&padded(case.src)) {
+            Ok(ast) => check(case, &ast.render(), eval(&ast), &mut failures, "comb"),
+            Err(e) => failures.push(format!("comb {:?}: parse failed {}", case.src, e.signature())),
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+fn check(
+    case: &Case,
+    rendered: &str,
+    evaluated: Result<String, EvalError>,
+    failures: &mut Vec<String>,
+    arm: &str,
+) {
+    if let Some(shape) = case.shape
+        && shape != rendered
+    {
+        failures.push(format!(
+            "{arm} {:?}: shape {rendered} wanted {shape}",
+            case.src
+        ));
+    }
+    match evaluated {
+        Ok(value) => {
+            if value != case.oracle {
+                failures.push(format!(
+                    "{arm} {:?}: value {value:?} wanted {:?} (as {rendered})",
+                    case.src, case.oracle
+                ));
+            }
+        }
+        Err(EvalError::Unsupported) => {
+            if case.shape.is_none() {
+                failures.push(format!(
+                    "{arm} {:?}: evaluator cannot reach this and no shape was recorded (as {rendered})",
+                    case.src
+                ));
+            }
+        }
+    }
+}
+
+#[test]
+fn neither_arm_rejects_what_the_oracle_accepts() {
+    let mut failures = Vec::new();
+    for src in ACCEPTED {
+        if let Err(e) = hand::parse(&padded(src)) {
+            failures.push(format!("hand {src:?}: rejected with {}", e.signature()));
+        }
+        if let Err(e) = comb::parse(&padded(src)) {
+            failures.push(format!("comb {src:?}: rejected with {}", e.signature()));
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+#[test]
+fn both_arms_agree() {
+    let mut failures = Vec::new();
+    for case in VALUES {
+        let a = hand::parse(&padded(case.src)).map(|e| e.render());
+        let b = comb::parse(&padded(case.src)).map(|e| e.render());
+        if a != b {
+            failures.push(format!("{:?}: hand {a:?} comb {b:?}", case.src));
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+#[test]
+fn hand_reports_the_oracles_errors() {
+    let mut failures = Vec::new();
+    for (src, want) in ERRORS {
+        match hand::parse(&padded(src)) {
+            Err(e) if e.signature() == *want => {}
+            Err(e) => failures.push(format!("hand {src:?}: got {} wanted {want}", e.signature())),
+            Ok(ast) => failures.push(format!("hand {src:?}: parsed as {}", ast.render())),
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+#[test]
+fn combinators_report_the_oracles_errors() {
+    let mut failures = Vec::new();
+    for (src, want) in ERRORS {
+        match comb::parse(&padded(src)) {
+            Err(e) if e.signature() == *want => {}
+            Err(e) => failures.push(format!("comb {src:?}: got {} wanted {want}", e.signature())),
+            Ok(ast) => failures.push(format!("comb {src:?}: parsed as {}", ast.render())),
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+/// The `DO` control expression stops on its keywords, which is the one place the
+/// expression grammar depends on a terminator set supplied by the caller.
+#[test]
+fn do_keywords_terminate_both_arms() {
+    let toks = rexx_parse_spike::token::scan("1 to 3 while x").expect("scans");
+    let mut p = hand::Parser::new(&toks);
+    let got = p
+        .expression(hand::Terminators::DO)
+        .expect("parses")
+        .expect("has a value");
+    assert_eq!(got.render(), "1");
+
+    let body = &toks[..toks.len() - 1];
+    // `lazy()` is needed because chumsky's `parse` insists on consuming the
+    // whole input, while a Rexx expression must stop at its terminator and hand
+    // the rest back to the instruction parser.
+    let got = chumsky::Parser::parse(
+        &chumsky::Parser::lazy(comb::expression(hand::Terminators::DO)),
+        body,
+    )
+    .into_output()
+    .expect("parses")
+    .expect("has a value");
+    assert_eq!(got.render(), "1");
+}
