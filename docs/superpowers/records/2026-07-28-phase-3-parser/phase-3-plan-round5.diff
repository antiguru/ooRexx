+    /// Consume and return the clause being parsed.
+    pub fn next_clause(&mut self) -> Option<Clause> {
+        if let Some(c) = self.pending.take() {
+            return Some(c);
+        }
+        let c = self.clauses.get(self.pos)?.clone();
+        self.pos += 1;
