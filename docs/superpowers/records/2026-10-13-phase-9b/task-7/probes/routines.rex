say 'ver' SysUtilVersion()
say 'load' SysLoadFuncs() SysDropFuncs()
say 'pid' SysQueryProcess() SysQueryProcess('pid')
say 'ppid' SysQueryProcess('PPID')
say 'pgid' SysQueryProcess('PGID')
say 'pprio' SysQueryProcess('PPRIO')
say 'ptime' SysQueryProcess('PTIME')
say 'pmem' SysQueryProcess('PMEM')
say 'pswaps' SysQueryProcess('PSWAPS')
say 'psig' SysQueryProcess('PRCVDSIG')
say 'key' c2x(SysGetKey()) c2x(SysGetKey('noecho')) c2x(SysGetKey('Echo'))
say 'wait' SysWait()
say 'wait' SysWait()
p = SysCreatePipe()
say 'pipe' p
say 'pipe' SysCreatePipe('nonblocking')
say 'pipe' SysCreatePipe('bx')
say 'setprio' SysSetPriority(0,0)
say 'pprio' SysQueryProcess('PPRIO')
say 'setprio' SysSetPriority(,-3)
say 'pprio' SysQueryProcess('PPRIO')
say 'setprio' SysSetPriority(0,3)
say 'pprio' SysQueryProcess('PPRIO')
