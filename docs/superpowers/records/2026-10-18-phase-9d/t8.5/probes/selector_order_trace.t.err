     1 *-* o = .k~new
       >E>   .K => "The K class"
       >M>   "NEW" => "a K"
       >>>   "a K"
       >=>   O <= "a K"
     2 *-* o~setup
       >V>   O => "a K"
       >I> Method "SETUP" with scope "K" in package "/home/moritz/dev/repos/ooRexx-rust-rewrite/docs/superpowers/records/2026-10-18-phase-9d/t8.5/probes/selector_order_trace.rex".
    12 *-* expose a b
    13 *-* a = 'x';
       >L>   "x"
       >>>   "x"
       >=>   A <= "x"
    13 *-* b = 'y'
       >L>   "y"
       >>>   "y"
       >=>   B <= "y"
