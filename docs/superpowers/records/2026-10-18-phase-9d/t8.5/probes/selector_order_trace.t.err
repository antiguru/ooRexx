     3 *-* o~m
       >V>   O => "a K"
       >I> Method "M" with scope "K" in package "/home/moritz/dev/repos/ooRexx-rust-rewrite/docs/superpowers/records/2026-10-18-phase-9d/t8.5/probes/selector_order_trace.rex".
    15 *-* expose (a) (b)
       >V>   A => "x"
       >V>   B => "y"
       <I< Method "M" with scope "K" in package "/home/moritz/dev/repos/ooRexx-rust-rewrite/docs/superpowers/records/2026-10-18-phase-9d/t8.5/probes/selector_order_trace.rex".
     4 *-* a = 'p';
       >L>   "p"
       >>>   "p"
       >=>   A <= "p"
     4 *-* b = 'q'
       >L>   "q"
       >>>   "q"
       >=>   B <= "q"
     5 *-* call pe
     8 *-*   pe:
