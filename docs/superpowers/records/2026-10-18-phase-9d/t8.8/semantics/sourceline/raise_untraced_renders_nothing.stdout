s1 98.939
s2 98.900 boom.
s5 93.900
USER
USER
after o
s3 98.939
USER
USER
after q
    (noisy dn sent)
USER
s4 98.900 boom.
%SRCG%COUNT 44
%SRCG%L/* Untraced ADDITIONAL renders nothing for a trace line. DESCRIPTION takes
%SRCG%L   its required string at RAISE under Deviation 83. A SYNTAX code uses the
%SRCG%L   RC value's string value. */
%SRCG%Lo = .bad~new
%SRCG%Lq = .noisy~new
%SRCG%Lcall on user zz name u
%SRCG%Lsignal on syntax name s1
%SRCG%Lraise syntax 93.900 additional (o)
%SRCG%Ls1: say 's1' condition('o')~code
%SRCG%Lsignal on syntax name s2
%SRCG%Lraise syntax (o)
%SRCG%Ls2: say 's2' condition('o')~code condition('o')~message
%SRCG%Lsignal on syntax name s5
%SRCG%Lraise syntax 93.900 description (o)
%SRCG%Ls5: say 's5' condition('o')~code
%SRCG%Lcall ru 'description', o
%SRCG%Lcall ru 'additional', o
%SRCG%Lsay 'after o'
%SRCG%Lsignal on syntax name s3
%SRCG%Lraise syntax 93.900 additional (q)
%SRCG%Ls3: say 's3' condition('o')~code
%SRCG%Lcall ru 'description', q
%SRCG%Lcall ru 'additional', q
%SRCG%Lsay 'after q'
%SRCG%Lcall ru 'trace description', q
%SRCG%Lsignal on syntax name s4
%SRCG%Lcall ru 'trace description', o
%SRCG%Ls4: trace off; say 's4' condition('o')~code condition('o')~message
%SRCG%Lexit
%SRCG%Lu: say 'USER'; return
%SRCG%Lru:
%SRCG%L  parse arg how
%SRCG%L  select
%SRCG%L    when how = 'description' then raise user zz description (arg(2)) return
%SRCG%L    when how = 'additional' then raise user zz additional (arg(2)) return
%SRCG%L    otherwise trace r; raise user zz description (arg(2)) return
%SRCG%L  end
%SRCG%L::class bad
%SRCG%L::method defaultname
%SRCG%L  raise syntax 98.900 array('boom')
%SRCG%L::class noisy
%SRCG%L::method defaultname
%SRCG%L  say '    (noisy dn sent)'
%SRCG%L  return 'NOISY'
