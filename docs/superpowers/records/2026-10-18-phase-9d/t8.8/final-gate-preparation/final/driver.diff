 def digest(path):
     return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def validation_source_bridge(provenance):
+    bridge = json.loads(VALIDATION_SOURCE_BRIDGE.read_text())
+    assert bridge['prior_validation_source_commit'] == '6b6f3fb460049c6ef63f565ceb78e11b5582f165'
+    assert bridge['settled_source_commit'] == 'ac446500e03c18b5143f2967ca30015e6d64b95f'
+    assert bridge['normal_pin_producer_source_commit'] == provenance['source_commit'] == 'f65066b04fe1f2355ce64d8be581fa9e79641673'
+    assert bridge['measured_runtime_source_commit'] == '9d919b7c3832c55edc3a0a07974309f092102201'
+    assert bridge['settled_rust_tree'] == git_output('rev-parse', bridge['settled_source_commit'] + ':rust').decode().strip()
+    assert bridge['settled_rust_tree'] == git_output('rev-parse', PIN + ':rust').decode().strip(), 'Final Rust tree differs from reviewed settled repair'
+    assert set(bridge['reviews']) == {'assertion', 'harness'}
+    for review in bridge['reviews'].values():
+        assert review['accepted_by_root'] is True and review['sha256'], 'Scoped review/root acceptance pending'
+        assert digest(review['path']) == review['sha256'], 'Accepted review changed'
+    refs = [('normal_pin_provenance', RELEASE_PIN_PROVENANCE, None),
+            ('production_manifest', RELEASE_PIN_PROVENANCE.parent / 'production-manifest.json', 300),
+            ('registration_source_proof', RELEASE_PIN_PROVENANCE.parent / 'source-proof.json', 11)]
+    for name, path, count in refs:
+        assert bridge[name]['path'] == str(path) and bridge[name]['sha256'] == digest(path)
+        if count is not None:
+            assert bridge[name]['files' if name == 'production_manifest' else 'inputs'] == count
+    changed = git_output('diff', '--name-only', bridge['prior_validation_source_commit'], PIN, '--', 'rust').decode().splitlines()
+    assert sorted(changed) == sorted(APPROVED_TEST_DELTA) == sorted(bridge['changed_test_inputs']), 'Unreviewed Rust input delta'
+    for path, row in bridge['changed_test_inputs'].items():
+        for ref, field in [(bridge['prior_validation_source_commit'], 'before_git'), (PIN, 'after_git')]:
+            actual = git_output('ls-tree', ref, '--', path).decode().strip() or None
+            assert actual == row[field], f'Test-input Git identity changed: {path}'
+        assert digest(ROOT / path) == row['sha256'], f'Test input changed: {path}'
+    protected = bridge['protected_reference_manifest']
+    assert protected['path'] == '/tmp/codex-p9d-t88-final-gates-resume/suite-static-inputs-before.json'
+    assert protected['sha256'] == '109c412b19e118ae6804fbcc1fd96f55d43c08d51fd3d924a90814b32b97dfa7' == digest(protected['path'])
+    reference = json.loads(Path(protected['path']).read_text())['entries']
+    selected = {path: row for path, row in reference.items() if path.startswith(str(ROOT / 'ootest') + '/') and row['kind'] == 'file'}
+    assert len(selected) == protected['files'] == 553
+    found = set()
+    for directory, dirs, files in os.walk(ROOT / 'ootest', followlinks=False):
+        dirs[:] = [name for name in dirs if name not in {'.git', '.svn', '.hg'}]
+        found.update(str(Path(directory) / name) for name in files)
+    assert found == selected.keys(), 'Protected ooTest file population changed'
+    for path, row in selected.items():
+        assert digest(path) == row['sha256'] and Path(path).lstat().st_mode == row['mode'], f'Protected ooTest changed: {path}'
+        if 'symlink_target' in row:
+            assert os.readlink(path) == row['symlink_target']
+    prior = bridge['prior_default_artifacts']
+    assert prior['path'] == '/tmp/codex-p9d-t88-final-gates-resume/artifacts.json'
+    assert prior['targets'] == len(json.loads(Path(prior['path']).read_text())) == len(bridge['prior_default_listings']) == 156
+    assert digest(prior['path']) == prior['sha256']
+    assert bridge['expected_added_tests'] == {'suite': sorted(ADDED_SUITE_TESTS)}
+    for row in bridge['prior_default_listings'].values():
+        assert digest(row['path']) == row['sha256'], 'Prior actual test listing changed'
+    return {'path': str(VALIDATION_SOURCE_BRIDGE), 'sha256': digest(VALIDATION_SOURCE_BRIDGE),
+            'prior_validation_source_commit': bridge['prior_validation_source_commit'], 'settled_source_commit': bridge['settled_source_commit'],
+            'validation_rust_tree': bridge['settled_rust_tree'], 'changed_test_inputs': bridge['changed_test_inputs'],
+            'protected_files': len(selected), 'reviews': bridge['reviews']}
+
+
+def final_test_population(item, names):
+    bridge = json.loads(VALIDATION_SOURCE_BRIDGE.read_text())
+    row = bridge['prior_default_listings'][json.dumps(key(item), separators=(',', ':'))]
+    assert digest(row['path']) == row['sha256']
+    previous = {line[:-6] for line in Path(row['path']).read_text().splitlines() if line.endswith(': test')}
+    assert len(previous) == row['tests']
+    added = ADDED_SUITE_TESTS if key(item) == ('rexx-exec', 'suite', ('test',), ('bin',)) else frozenset()
+    assert not previous & added
+    assert set(names) == previous | added, 'Final names differ from prior actual population plus the two reviewed suite tests'
+    return {'previous_tests': len(previous), 'added_tests': sorted(added), 'fresh_tests': len(names)}
 
 
