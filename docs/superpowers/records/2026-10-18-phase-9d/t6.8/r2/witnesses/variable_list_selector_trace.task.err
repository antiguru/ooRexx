     6 *-* list = 'a b'
       >L>   "a b"
       >>>   "a b"
       >=>   LIST <= "a b"
     7 *-* a = 1;
       >L>   "1"
       >>>   "1"
       >=>   A <= "1"
     7 *-* b = 2
       >L>   "2"
       >>>   "2"
       >=>   B <= "2"
     8 *-* drop (list)
       >V>   LIST => "a b"
     9 *-* say symbol('a') symbol('b')
       >L>   "a"
       >A>   "a"
       >F>   SYMBOL => "LIT"
       >L>   "b"
       >A>   "b"
       >F>   SYMBOL => "LIT"
       >O>   " " => "LIT LIT"
       >>>   "LIT LIT"
    10 *-* list = 'c';
       >L>   "c"
       >>>   "c"
       >=>   LIST <= "c"
    10 *-* c = 3
       >L>   "3"
       >>>   "3"
       >=>   C <= "3"
    11 *-* call pe
    37 *-*   pe:
    37 *-*   procedure expose (list)
       >V>     LIST => "c"
    38 *-*   say c
       >V>     C => "3"
       >>>     "3"
    39 *-*   return
    12 *-* lst. = 'x y';
       >L>   "x y"
       >>>   "x y"
       >=>   LST. <= "x y"
    12 *-* x = 1;
       >L>   "1"
       >>>   "1"
       >=>   X <= "1"
    12 *-* y = 2
       >L>   "2"
       >>>   "2"
       >=>   Y <= "2"
    13 *-* drop (lst.)
       >V>   LST. => "x y"
    14 *-* say symbol('x') symbol('y') symbol('lst.')
       >L>   "x"
       >A>   "x"
       >F>   SYMBOL => "LIT"
       >L>   "y"
       >A>   "y"
       >F>   SYMBOL => "LIT"
       >O>   " " => "LIT LIT"
       >L>   "lst."
       >A>   "lst."
       >F>   SYMBOL => "VAR"
       >O>   " " => "LIT LIT VAR"
       >>>   "LIT LIT VAR"
    15 *-* q.1 = 'z';
       >L>   "z"
       >>>   "z"
       >C>   Q.1 => "Q.1"
       >=>   Q.1 <= "z"
    15 *-* z = 5
       >L>   "5"
       >>>   "5"
       >=>   Z <= "5"
    16 *-* drop (q.1)
       >C>   Q.1 => "Q.1"
       >V>   Q.1 => "z"
    17 *-* say symbol('z') symbol('q.1')
       >L>   "z"
       >A>   "z"
       >F>   SYMBOL => "LIT"
       >L>   "q.1"
       >A>   "q.1"
       >F>   SYMBOL => "VAR"
       >O>   " " => "LIT VAR"
       >>>   "LIT VAR"
    18 *-* i = 2;
       >L>   "2"
       >>>   "2"
       >=>   I <= "2"
    18 *-* a.2 = 'p q';
       >L>   "p q"
       >>>   "p q"
       >C>   A.2 => "A.2"
       >=>   A.2 <= "p q"
    18 *-* p = 'cp';
       >L>   "cp"
       >>>   "cp"
       >=>   P <= "cp"
    18 *-* a.I = 'r';
       >L>   "r"
       >>>   "r"
       >C>   A.I => "A.2"
       >=>   A.I <= "r"
    18 *-* r = 'cr'
       >L>   "cr"
       >>>   "cr"
       >=>   R <= "cr"
    19 *-* call pa
    25 *-*   pa:
    25 *-*   procedure expose (a.i)
       >C>     A.I => "A.2"
       >C>     A.I => "A.I"
       >V>     A.I => "A.I"
       >C>     A.I => "A.2"
    26 *-*   say symbol('p') symbol('r') symbol('a.2') symbol('a.I')
       >L>     "p"
       >A>     "p"
       >F>     SYMBOL => "LIT"
       >L>     "r"
       >A>     "r"
       >F>     SYMBOL => "LIT"
       >O>     " " => "LIT LIT"
       >L>     "a.2"
       >A>     "a.2"
       >F>     SYMBOL => "VAR"
       >O>     " " => "LIT LIT VAR"
       >L>     "a.I"
       >A>     "a.I"
       >F>     SYMBOL => "LIT"
       >O>     " " => "LIT LIT VAR LIT"
       >>>     "LIT LIT VAR LIT"
    27 *-*   return
    20 *-* call pb
    29 *-*   pb:
    29 *-*   procedure expose (a.i) i
       >C>     A.I => "A.2"
       >C>     A.I => "A.I"
       >V>     A.I => "A.I"
       >C>     A.I => "A.2"
    30 *-*   say symbol('p') symbol('r') symbol('a.2') i
       >L>     "p"
       >A>     "p"
       >F>     SYMBOL => "LIT"
       >L>     "r"
       >A>     "r"
       >F>     SYMBOL => "LIT"
       >O>     " " => "LIT LIT"
       >L>     "a.2"
       >A>     "a.2"
       >F>     SYMBOL => "VAR"
       >O>     " " => "LIT LIT VAR"
       >V>     I => "2"
       >O>     " " => "LIT LIT VAR 2"
       >>>     "LIT LIT VAR 2"
    31 *-*   return
    21 *-* call pc
    33 *-*   pc:
    33 *-*   procedure expose (a.2)
       >C>     A.2 => "A.2"
       >C>     A.2 => "A.2"
       >V>     A.2 => "r"
    34 *-*   say symbol('p') symbol('a.2')
       >L>     "p"
       >A>     "p"
       >F>     SYMBOL => "LIT"
       >L>     "a.2"
       >A>     "a.2"
       >F>     SYMBOL => "VAR"
       >O>     " " => "LIT VAR"
       >>>     "LIT VAR"
    35 *-*   return
    22 *-* .k~new~m
       >E>   .K => "The K class"
       >M>   "NEW" => "a K"
       >I> Method "M" with scope "K" in package "DIR/variable_list_selector_trace.rex".
    43 *-* expose zz
    44 *-* zz = 'w'
       >L>   "w"
       >>>   "w"
       >=>   ZZ <= "w"
    45 *-* self~m2
       >V>   SELF => "a K"
       >I> Method "M2" with scope "K" in package "DIR/variable_list_selector_trace.rex".
    48 *-* expose zz (zz)
       >V>   ZZ => "w"
    49 *-* w = 'object w'
       >L>   "object w"
       >>>   "object w"
       >=>   W <= "object w"
       <I< Method "M2" with scope "K" in package "DIR/variable_list_selector_trace.rex".
    46 *-* say zz
       >V>   ZZ => "w"
       >>>   "w"
       <I< Method "M" with scope "K" in package "DIR/variable_list_selector_trace.rex".
