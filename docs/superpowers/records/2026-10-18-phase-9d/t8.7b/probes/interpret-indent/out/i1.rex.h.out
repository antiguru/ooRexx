  [    17 *-*     return 1 / 0]
  [     8 *-*   x = f()]
  [     8 *-*   interpret arg(1)]
  [     1 *-* call try 'x = f()']
  [    17 *-*       return 1 / 0]
  [     8 *-*     x = f();]
  [     8 *-*   interpret arg(1)]
  [     2 *-* call try 'do 1; x = f(); end']
  [    17 *-*     return 1 / 0]
  [     8 *-*   x = f()]
  [     8 *-*   interpret arg(1)]
  [     3 *-* call try 'do 2; nop; end; x = f()']
