/* LINEIN with a line number after CHARIN moved the position */
say '[' || charin(, 2, 0) || ']' chars()
say '[' || linein() || ']' chars()
say '[' || linein(, 3) || ']' chars()
say '[' || linein() || ']' chars()
say '[' || linein(, 2) || ']' chars()
say '[' || charin(, , 2) || ']' chars()
say '[' || linein(, 4) || ']' chars()
