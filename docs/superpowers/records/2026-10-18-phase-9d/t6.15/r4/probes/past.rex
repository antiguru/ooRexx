/* a start past the end: the description after each ask */
say '[' || charin(, 23) || ']' chars() lines() .stdin~description
say '[' || charin(, 100, 2) || ']' chars() lines() .stdin~description
say '[' || charin(, 22, 5) || ']' chars() lines() .stdin~description
say '[' || linein(, 9) || ']' chars() lines() .stdin~description
say '[' || linein(, 5) || ']' chars() lines() .stdin~description
say '[' || linein(, 4) || ']' chars() lines() .stdin~description
say '[' || linein() || ']' chars() lines() .stdin~description
say '[' || charin(, 1) || ']' chars() lines() .stdin~description
