/* LINES Count after CHARIN */
say 'A' lines(, 'C') lines()
say '[' || charin(, , 2) || ']'
say 'B' lines(, 'C') lines()
say '[' || linein() || ']'
say 'C' lines(, 'C') lines()
say '[' || linein() || ']'
say 'D' lines(, 'C') lines()
say '[' || charin(, , 7) || ']'
say 'E' lines(, 'C') lines()
say '[' || linein() || ']'
say 'F' lines(, 'C') lines()
say '[' || linein() || ']'
say 'G' lines(, 'C') lines()
