     9 *-*   r = >x
       >O>     ">" => "V"
       >>>     "an Array"
       >=>     R <= "an Array"
    10 *-*   trace off
    15 *-*   r = >y
       >O>     ">" => "V"
       >>>     "an Array"
       >=>     R <= "an Array"
    16 *-*   w = (>y)~name
       >O>     ">" => "V"
       >M>     "NAME" => "V"
       >>>     "V"
       >=>     W <= "V"
    17 *-*   trace off
