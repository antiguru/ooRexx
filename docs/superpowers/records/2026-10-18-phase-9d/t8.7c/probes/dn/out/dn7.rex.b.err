     8 *-* x = p
       >V>   P => "an ON"
       >>>   "an ON"
       >=>   X <= "an ON"
     9 *-* x = o
       >V>   O => "a DN"
       >>>   "a DN"
       >=>   X <= "a DN"
    10 *-* trace off
    15 *-* x = q
       >V>   Q => "a SN"
       >>>   "a SN"
       >=>   X <= "a SN"
    16 *-* trace off
