     7 *-* parse value 'xyz' with a (p) b
       >L>   "xyz"
       >K>   "VALUE" => "xyz"
       >>>   "xyz"
    10 *-* s1:
    10 *-* trace off;
    13 *-* parse value o with a
    16 *-* s2:
    16 *-* trace off;
    26 *-* guard on when v \== 1
       >L>   "1"
       >O>   "\==" => "1"
       >K>   "WHEN" => "1"
    27 *-* trace off
