+impl Interp {
+    /// **SPIKE.** Runs `f` under the pin tag `label`.
+    #[inline(always)]
+    pub(crate) fn pinned<T>(&mut self, label: &str, f: impl FnOnce(&mut Interp) -> T) -> T {
+        #[cfg(feature = "spike-pins")]
+        let saved = self.pin_as(label);
+        #[cfg(not(feature = "spike-pins"))]
+        let _ = label;
+        let out = f(self);
+        #[cfg(feature = "spike-pins")]
+        self.unpin(saved);
+        out
+    }
+}
+
+/// **SPIKE.** Counts of Rexx bodies entered by Rust recursion, by the native
+/// context that entered them.
+#[cfg(feature = "spike-pins")]
+impl Interp {
+    pub(crate) fn pin_as(&mut self, label: impl Into<String>) -> String {
+        std::mem::replace(&mut self.pin_tag, label.into())
+    }
+
+    pub(crate) fn unpin(&mut self, saved: String) {
+        self.pin_tag = saved;
+    }
+
+    /// A driver root: counted under the tag in force, which the body runs
+    /// without.
+    pub(crate) fn count_driver_root(&mut self) -> String {
+        let label = if self.activation_depth() <= 1 {
+            "root".to_string()
+        } else if self.pin_tag.is_empty() {
+            let trace = std::backtrace::Backtrace::force_capture().to_string();
+            let frames: Vec<String> = trace
+                .lines()
+                .filter_map(|line| {
+                    let line = line.trim();
+                    let name = line.split_once(": ")?.1;
+                    name.starts_with("rexx_exec::").then(|| {
+                        name.trim_start_matches("rexx_exec::")
+                            .rsplit("::")
+                            .next()
+                            .unwrap_or(name)
+                            .to_string()
+                    })
+                })
+                .filter(|name| {
+                    !matches!(
+                        name.as_str(),
+                        "count_driver_root" | "run_activation" | "pinned" | "{{closure}}"
+                    )
+                })
+                .take(4)
+                .collect();
+            format!("untagged:{}", frames.join("<"))
+        } else {
+            format!("pinned:{}", self.pin_tag)
+        };
+        *self.pin_counts.entry(label).or_default() += 1;
+        std::mem::take(&mut self.pin_tag)
+    }
+
+    pub(crate) fn count_stackless(&mut self, kind: usize) {
+        let label = ["stackless:function", "stackless:subroutine", "stackless:send"][kind];
+        *self.pin_counts.entry(label.to_string()).or_default() += 1;
+    }
+
+    pub(crate) fn count_pinned_call(&mut self) {
+        *self.pin_counts.entry("funnel:call".to_string()).or_default() += 1;
+    }
+
+    pub(crate) fn count_pinned_method(&mut self) {
+        *self.pin_counts.entry("funnel:method".to_string()).or_default() += 1;
+    }
+
+    fn dump_pins(&self, label: &str) {
+        use std::io::Write as _;
+        let Some(path) = std::env::var_os("SPIKE_PIN_OUT") else {
+            return;
+        };
+        let mut text = String::new();
+        for (kind, count) in &self.pin_counts {
+            text.push_str(&format!("{label}\t{kind}\t{count}\n"));
+        }
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+        {
+            let _ = file.write_all(text.as_bytes());
+        }
+    }
+}
