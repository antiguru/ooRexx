+    // FUZZ spans the same widened range: digits - 1 at the very top.
+    let mut s = Settings::default();
+    s.set_digits_str("18").unwrap();
+    s.set_digits_str("999999999999999999").unwrap();
+    assert!(s.set_fuzz_str("999999999999999998").is_ok());
